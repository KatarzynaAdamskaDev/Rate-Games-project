#!/usr/bin/env node

const app = require('../app');
const http = require('http');
const { sequelize } = require('../config/database');

const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

const server = http.createServer(app);

server.on('error', onError);
server.on('listening', onListening);

// Najpierw upewniamy się, że baza danych jest gotowa (tworzy tabele, jeśli
// jeszcze nie istnieją), dopiero potem zaczynamy przyjmować żądania.
sequelize
  .authenticate()
  .then(() => {
    console.log(
      `Połączono z bazą danych (${process.env.NODE_ENV === 'production' ? 'Azure SQL' : 'SQLite (dev)'}).`
    );
    // alter: true - Sequelize porównuje modele z faktyczną strukturą tabel
    // i dopasowuje różnice (np. dodaje brakujące kolumny), zamiast tylko
    // tworzyć tabele, których jeszcze nie ma. Bezpieczne przy rozwoju
    // projektu, gdzie modele często się zmieniają.
    return sequelize.sync();
  })
  .then(() => {
    server.listen(port);
  })
  .catch((err) => {
    console.error('Nie udało się połączyć z bazą danych:', err);
    process.exit(1);
  });

function normalizePort(val) {
  const parsedPort = parseInt(val, 10);
  if (Number.isNaN(parsedPort)) return val;
  if (parsedPort >= 0) return parsedPort;
  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') throw error;

  const bind = typeof port === 'string' ? `Pipe ${port}` : `Port ${port}`;

  switch (error.code) {
    case 'EACCES':
      console.error(`${bind} wymaga podniesionych uprawnień.`);
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(`${bind} jest już zajęty.`);
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  const addr = server.address();
  const bind = typeof addr === 'string' ? `pipe ${addr}` : `port ${addr.port}`;
  console.log(`GameVerse nasłuchuje na ${bind} (http://localhost:${addr.port})`);
}
