#!/usr/bin/env node

const app = require('../app');
const http = require('http');
const { sequelize, configureSqliteConcurrency } = require('../config/database');
const { addMissingColumns } = require('../utils/schemaHelpers');
const { syncAllUsersProgress } = require('../utils/progressHelpers');
const { seedConversationReads } = require('../utils/chatHelpers');
const { purgeOrphanedData } = require('../utils/cleanupHelpers');
const { startModerationSettings } = require('../utils/moderationSettings');
const { startModerationCleanup } = require('../utils/moderationStatus');
const { warmPopularPool } = require('../utils/gamePopularity');
const { seedBlogIfEmpty } = require('../utils/blogImport');

const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

const server = http.createServer(app);

server.on('error', onError);
server.on('listening', onListening);

// Najpierw upewniamy się, że baza danych jest gotowa (tworzy tabele, jeśli
// jeszcze nie istnieją), dopiero potem zaczynamy przyjmować żądania.
sequelize
  .authenticate()
  .then(() => {
    console.log(
      `Połączono z bazą danych (${process.env.NODE_ENV === 'production' ? 'Azure SQL' : 'SQLite (dev)'}).`
    );
    return configureSqliteConcurrency();
  })
  .then(() => sequelize.sync())
  // sync() nie dodaje nowych kolumn do istniejących tabel - robi to poniższy krok.
  .then(() => addMissingColumns())
  // Wpisy bloga są w bazie; przy pierwszym starcie wczytujemy je z pliku JSON (dawny magazyn albo wpisy startowe).
  .then(() => seedBlogIfEmpty())
  // Usuwa dane kont, których już nie ma (recenzje, wiadomości, obserwowania...).
  .then(() => purgeOrphanedData())
  .then((count) => {
    if (count > 0) console.log(`[czyszczenie] usunięto dane ${count} nieistniejących kont.`);
  })
  // Uzupełnia PD/poziom (users.points, users.level) u istniejących użytkowników.
  .then(() => syncAllUsersProgress())
  // Istniejące rozmowy traktujemy jako przeczytane (licznik nieprzeczytanych czatu).
  .then(() => seedConversationReads())
  // Ustawienia moderacji z panelu admina (limity zapytań, filtr, wymóg 2FA) trzymamy w pamięci.
  .then(() => startModerationSettings())
  // Zdejmuje blokady czasowe po terminie (co kilka minut).
  .then(() => startModerationCleanup())
  .then(() => {
    server.listen(port);
    // Ranking popularności gier budujemy z wyprzedzeniem, żeby pierwsze wejście na listę nie czekało.
    warmPopularPool();
  })
  .catch((err) => {
    console.error('Nie udało się połączyć z bazą danych:', err);
    process.exit(1);
  });

function normalizePort(val) {
  const parsedPort = parseInt(val, 10);
  if (Number.isNaN(parsedPort)) return val;
  if (parsedPort >= 0) return parsedPort;
  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') throw error;

  const bind = typeof port === 'string' ? `Pipe ${port}` : `Port ${port}`;

  switch (error.code) {
    case 'EACCES':
      console.error(`${bind} wymaga podniesionych uprawnień.`);
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(`${bind} jest już zajęty.`);
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  const addr = server.address();
  const bind = typeof addr === 'string' ? `pipe ${addr}` : `port ${addr.port}`;
  console.log(`GameVerse nasłuchuje na ${bind} (http://localhost:${addr.port})`);
}
