# Skopiuj ten plik jako .env (albo uruchom "npm run setup", które zrobi to za Ciebie)
# i uzupełnij wartości. Plik .env nie trafia do repozytorium.

# --- Serwer -------------------------------------------------------------
# Lokalnie zostaw puste albo wpisz development. Na produkcji (Azure): production
NODE_ENV=development
PORT=3000

# Publiczny adres serwisu (bez końcowego ukośnika) - używany w sitemap.xml, robots.txt i podglądach linków
# (Open Graph). Puste = adres brany z żądania. Na produkcji ustaw np. https://twoja-domena.pl
SITE_URL=

# Długi, losowy ciąg znaków (np. wynik: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Na produkcji jest obowiązkowy - bez niego serwer się nie uruchomi.
SESSION_SECRET=zmien_mnie_na_dlugi_losowy_ciag

# --- Katalog gier IGDB (https://dev.twitch.tv/console - aplikacja Twitch) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- reCAPTCHA v2 "Checkbox" (opcjonalnie; bez kluczy rejestracja działa bez captchy) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Wysyłka maili z resetem hasła (opcjonalnie; konto Gmail + hasło aplikacji) ---
EMAIL_USER=
EMAIL_PASS=

# Katalog na pliki wgrywane przez użytkowników (awatary, okładki, zdjęcia z bloga). Puste = public/images.
# Na Azure App Service ustaw trwały katalog poza aplikacją, np. /home/uploads (wdrożenie podmienia katalog aplikacji).
UPLOADS_DIR=

# --- Pomocnik pisania artykułów na blogu (opcjonalnie) ---
# Z kluczem API Anthropic (https://console.anthropic.com) artykuły pisze Claude; bez klucza pomocnik tworzy szkielet
# artykułu pod SEO z danymi z katalogu gier. Rachunek naliczany jest za użycie: zwykle kilkadziesiąt groszy za artykuł
# na claude-opus-5 i kilkukrotnie mniej na claude-sonnet-5.
ANTHROPIC_API_KEY=
# Model (domyślnie claude-opus-5; tańsza opcja: claude-sonnet-5).
ANTHROPIC_MODEL=
# Limity generowania (ochrona przed kosztami): na administratora w ciągu godziny i na cały serwis w ciągu doby.
WRITER_MAX_PER_HOUR=15
WRITER_MAX_PER_DAY=60
# Sprawdzanie faktów w internecie przez wyszukiwarkę Claude (0 = wyłączone; wymaga włączenia web search na koncie Anthropic).
WRITER_WEB_SEARCH=1
# Opcjonalnie tańsze modele do sprawdzania faktów i oceny zdjęć (domyślnie ten sam, co ANTHROPIC_MODEL).
WRITER_RESEARCH_MODEL=
WRITER_VISION_MODEL=
# Opcjonalny klucz YouTube Data API v3 (Google Cloud, bezpłatny limit): pozwala znaleźć film także dla tematów bez gry z katalogu.
YOUTUBE_API_KEY=

# --- Produkcja: baza Azure SQL (ustawiane tylko przy NODE_ENV=production) ---
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
