# Skopiuj ten plik jako .env (albo uruchom "npm run setup", które zrobi to za Ciebie)
# i uzupełnij wartości. Plik .env nie trafia do repozytorium.

# --- Serwer -------------------------------------------------------------
# Lokalnie zostaw puste albo wpisz development. Na produkcji (Azure): production
NODE_ENV=development
PORT=3000

# Publiczny adres serwisu (bez końcowego ukośnika) - używany w sitemap.xml, robots.txt i podglądach linków
# (Open Graph). Puste = adres brany z żądania. Na produkcji ustaw np. https://twoja-domena.pl
SITE_URL=

# Długi, losowy ciąg znaków (np. wynik: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Na produkcji jest obowiązkowy - bez niego serwer się nie uruchomi.
SESSION_SECRET=zmien_mnie_na_dlugi_losowy_ciag

# --- Katalog gier IGDB (https://dev.twitch.tv/console - aplikacja Twitch) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- reCAPTCHA v2 "Checkbox" (opcjonalnie; bez kluczy rejestracja działa bez captchy) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Wysyłka maili z resetem hasła (opcjonalnie; konto Gmail + hasło aplikacji) ---
EMAIL_USER=
EMAIL_PASS=

# --- Produkcja: baza Azure SQL (ustawiane tylko przy NODE_ENV=production) ---
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
