<%- include('partials/top') %>

<% if (probationEnds) { %>
  <div class="gv-admin-alert">
    <i class="bi bi-hourglass-split"></i>
    <span>
      Jesteś nowym administratorem - do <b><%= probationEnds.toLocaleDateString('pl-PL') %></b> trwa okres próbny (<%= probationDays %> dni),
      w którym nie możesz nadawać ani odbierać uprawnień administratora innym.
    </span>
  </div>
<% } %>

<form method="GET" class="gv-admin-filters">
  <input type="search" name="q" value="<%= q %>" class="form-control gv-input" placeholder="Szukaj po nazwie lub e-mailu..." maxlength="100">
  <select name="filter" class="form-select gv-select" onchange="this.form.submit()">
    <option value="">Wszyscy</option>
    <option value="admin" <%= filter === 'admin' ? 'selected' : '' %>>Administratorzy</option>
    <option value="banned" <%= filter === 'banned' ? 'selected' : '' %>>Zablokowani</option>
    <option value="muted" <%= filter === 'muted' ? 'selected' : '' %>>Wyciszeni</option>
  </select>
  <button type="submit" class="btn gv-btn-primary"><i class="bi bi-search"></i> Szukaj</button>
</form>
<p class="gv-admin-count"><%= total %> <%= total === 1 ? 'użytkownik' : 'użytkowników' %></p>

<div class="gv-table-wrap">
  <table class="gv-table">
    <thead>
      <tr>
        <th>Użytkownik</th>
        <th>Rola</th>
        <th>Poziom</th>
        <th>Recenzje</th>
        <th>Status</th>
        <th>Akcje</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <% const isMe = u.id === currentUser.id; %>
        <tr>
          <td>
            <a href="/<%= encodeURIComponent(u.username) %>" class="gv-admin-user">
              <% if (u.avatarUrl) { %><img src="<%= u.avatarUrl %>" alt="" class="gv-mini-avatar"><% } else { %><span class="gv-mini-avatar"></span><% } %>
              <span><b><%= u.username %></b><small><%= u.email %></small><small>dołączył(a) <%= new Date(u.createdAt).toLocaleDateString('pl-PL') %></small></span>
            </a>
          </td>
          <td>
            <span class="gv-badge <%= u.role === 'admin' ? 'gv-badge-info' : '' %>"><%= u.role === 'admin' ? 'admin' : 'użytkownik' %></span>
            <% if (u.role === 'admin') { %>
              <span class="gv-badge <%= u.twoFactorEnabled ? 'gv-badge-ok' : 'gv-badge-warn' %>" title="Weryfikacja dwuetapowa"><%= u.twoFactorEnabled ? '2FA' : 'bez 2FA' %></span>
            <% } %>
          </td>
          <td>
            <%= u.level %> <small class="gv-muted">(<%= u.points %> PD)</small>
            <% if (u.unlockAll) { %><br><span class="gv-badge gv-badge-info" title="Wszystkie ramki, tła i odznaki są odblokowane"><i class="bi bi-unlock-fill"></i> odblokowane</span><% } %>
          </td>
          <td><%= u.reviewCount %></td>
          <td>
            <% if (u.banActive) { %>
              <span class="gv-badge gv-badge-danger" title="<%= u.banReason || '' %>">zablokowany<%= u.bannedUntil ? ' do ' + new Date(u.bannedUntil).toLocaleDateString('pl-PL') : '' %></span>
            <% } else { %>
              <span class="gv-badge gv-badge-ok">aktywny</span>
            <% } %>
            <% if (u.muteActive) { %>
              <span class="gv-badge gv-badge-warn" title="<%= u.muteReason || '' %>">wyciszony<%= u.muteForever ? '' : ' do ' + new Date(u.mutedUntil).toLocaleDateString('pl-PL') %></span>
            <% } %>
          </td>
          <td>
            <button type="button" class="gv-mini-btn" data-bs-toggle="modal" data-bs-target="#userModal-<%= u.id %>">
              <i class="bi bi-sliders"></i> <%= isMe ? 'Moje opcje' : 'Akcje' %>
            </button>
          </td>
        </tr>
      <% }) %>
      <% if (users.length === 0) { %>
        <tr><td colspan="6" class="gv-admin-empty">Brak użytkowników spełniających kryteria.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/pager', { pager }) %>

<% users.forEach(function(u) { %>
  <% const isMe = u.id === currentUser.id; %>
  <div class="modal fade" id="userModal-<%= u.id %>" tabindex="-1" aria-labelledby="userModalLabel-<%= u.id %>" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content gv-modal-content gv-admin-modal">
        <div class="modal-header gv-modal-header">
          <div class="gv-admin-user">
            <% if (u.avatarUrl) { %><img src="<%= u.avatarUrl %>" alt="" class="gv-mini-avatar"><% } else { %><span class="gv-mini-avatar"></span><% } %>
            <span>
              <b id="userModalLabel-<%= u.id %>"><%= u.username %><%= isMe ? ' (Ty)' : '' %></b>
              <small><%= u.email %></small>
            </span>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>

        <div class="modal-body">
          <section class="gv-admin-modal-section">
            <h3><i class="bi bi-stars"></i> Poziom i odblokowania</h3>
            <form method="POST" action="/admin/users/<%= u.id %>/level" class="gv-inline-form">
              <input type="number" name="level" min="1" max="100" value="<%= u.level %>" class="form-control gv-input" aria-label="Poziom">
              <button type="submit" class="gv-mini-btn"><i class="bi bi-arrow-up-circle"></i> Ustaw poziom</button>
            </form>
            <div class="gv-admin-modal-row">
              <form method="POST" action="/admin/users/<%= u.id %>/level">
                <input type="hidden" name="level" value="reset">
                <button type="submit" class="gv-mini-btn"><i class="bi bi-arrow-counterclockwise"></i> Zresetuj poziom</button>
              </form>
              <form method="POST" action="/admin/users/<%= u.id %>/unlock">
                <input type="hidden" name="value" value="<%= u.unlockAll ? '0' : '1' %>">
                <button type="submit" class="gv-mini-btn <%= u.unlockAll ? '' : 'gv-mini-ok' %>">
                  <i class="bi bi-<%= u.unlockAll ? 'lock-fill' : 'unlock-fill' %>"></i>
                  <%= u.unlockAll ? 'Cofnij odblokowanie wszystkiego' : 'Odblokuj wszystko (ramki, tła, odznaki)' %>
                </button>
              </form>
            </div>
          </section>

          <% if (!isMe) { %>
            <section class="gv-admin-modal-section">
              <h3><i class="bi bi-shield-lock-fill"></i> Rola i dostęp</h3>
              <div class="gv-admin-modal-row">
                <% if (u.roleChange.ok) { %>
                  <button type="button" class="gv-mini-btn <%= u.role === 'admin' ? 'gv-mini-warn' : '' %>"
                          data-bs-toggle="modal" data-bs-target="#roleModal"
                          data-user-id="<%= u.id %>" data-username="<%= u.username %>"
                          data-new-role="<%= u.role === 'admin' ? 'user' : 'admin' %>">
                    <i class="bi bi-shield-<%= u.role === 'admin' ? 'x' : 'plus' %>"></i>
                    <%= u.role === 'admin' ? 'Odbierz uprawnienia admina' : 'Nadaj uprawnienia admina' %>
                  </button>
                <% } %>
                <% if (u.role === 'admin' && u.twoFactorEnabled && u.roleChange.ok) { %>
                  <form method="POST" action="/admin/users/<%= u.id %>/2fa-reset" onsubmit="return confirm('Wyłączyć 2FA dla <%= u.username %>? Użyj tego, gdy administrator zgubił telefon.');">
                    <button type="submit" class="gv-mini-btn gv-mini-warn"><i class="bi bi-shield-x"></i> Wyłącz 2FA tego admina</button>
                  </form>
                <% } %>
              </div>

              <% if (!u.roleChange.ok) { %>
                <p class="gv-admin-note gv-admin-note-lock"><i class="bi bi-lock-fill"></i> <%= u.roleChange.reason %></p>
              <% } else { %>
                <p class="gv-admin-note">Zmiana uprawnień wymaga potwierdzenia nazwą użytkownika, Twoim hasłem<%= adminHasTwoFactor ? ' i kodem 2FA' : '' %>. Wszyscy administratorzy dostaną o niej powiadomienie.</p>
              <% } %>

            </section>

            <section class="gv-admin-modal-section">
              <h3><i class="bi bi-slash-circle-fill"></i> Blokada konta</h3>
              <% if (u.banActive) { %>
                <p class="gv-admin-note">
                  Konto jest zablokowane <%= u.bannedUntil ? 'do ' + formatUntil(u.bannedUntil) : 'bezterminowo' %><%= u.banReason ? ' - ' + u.banReason : '' %>.
                </p>
                <form method="POST" action="/admin/users/<%= u.id %>/unban">
                  <button type="submit" class="gv-mini-btn gv-mini-ok"><i class="bi bi-unlock-fill"></i> Odblokuj konto</button>
                </form>
              <% } else if (u.role !== 'admin') { %>
                <p class="gv-admin-note">Zablokowany użytkownik nie zaloguje się, a blokada czasowa wygasa sama.</p>
                <form method="POST" action="/admin/users/<%= u.id %>/ban" class="gv-inline-form gv-inline-form-wrap">
                  <select name="duration" class="form-select gv-select" aria-label="Czas blokady">
                    <% durations.forEach(function(d) { %><option value="<%= d.key %>"><%= d.label %></option><% }) %>
                  </select>
                  <input type="text" name="reason" maxlength="200" placeholder="Powód (widzi go użytkownik)" class="form-control gv-input" aria-label="Powód blokady">
                  <button type="submit" class="gv-mini-btn gv-mini-warn"><i class="bi bi-slash-circle"></i> Zablokuj</button>
                </form>
              <% } else { %>
                <p class="gv-admin-note">Administratora nie można zablokować - najpierw odbierz mu uprawnienia.</p>
              <% } %>
            </section>

            <section class="gv-admin-modal-section">
              <h3><i class="bi bi-mic-mute-fill"></i> Wyciszenie</h3>
              <% if (u.muteActive) { %>
                <p class="gv-admin-note">
                  Użytkownik jest wyciszony <%= u.muteForever ? 'bezterminowo' : 'do ' + formatUntil(u.mutedUntil) %><%= u.muteReason ? ' - ' + u.muteReason : '' %>.
                </p>
                <form method="POST" action="/admin/users/<%= u.id %>/unmute">
                  <button type="submit" class="gv-mini-btn gv-mini-ok"><i class="bi bi-mic-fill"></i> Zdejmij wyciszenie</button>
                </form>
              <% } else if (u.role !== 'admin') { %>
                <p class="gv-admin-note">Wyciszony użytkownik może czytać serwis, ale nie może pisać recenzji, komentarzy ani wiadomości.</p>
                <form method="POST" action="/admin/users/<%= u.id %>/mute" class="gv-inline-form gv-inline-form-wrap">
                  <select name="duration" class="form-select gv-select" aria-label="Czas wyciszenia">
                    <% durations.forEach(function(d) { %><option value="<%= d.key %>" <%= d.key === '7d' ? 'selected' : '' %>><%= d.label %></option><% }) %>
                  </select>
                  <input type="text" name="reason" maxlength="200" placeholder="Powód (widzi go użytkownik)" class="form-control gv-input" aria-label="Powód wyciszenia">
                  <button type="submit" class="gv-mini-btn gv-mini-warn"><i class="bi bi-mic-mute-fill"></i> Wycisz</button>
                </form>
              <% } else { %>
                <p class="gv-admin-note">Administratora nie można wyciszyć.</p>
              <% } %>
            </section>

            <% if (u.role !== 'admin') { %>
              <section class="gv-admin-modal-section gv-admin-modal-danger">
                <h3><i class="bi bi-exclamation-triangle-fill"></i> Strefa niebezpieczna</h3>
                <p class="gv-admin-note">Usunięcie konta kasuje też recenzje, komentarze, obserwowania i rozmowy użytkownika. Tego nie da się cofnąć.</p>
                <form method="POST" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Usunąć konto <%= u.username %> razem z recenzjami, komentarzami i rozmowami? Tej operacji nie można cofnąć.');">
                  <button type="submit" class="gv-mini-btn gv-mini-danger"><i class="bi bi-trash3-fill"></i> Usuń konto</button>
                </form>
              </section>
            <% } %>
          <% } else { %>
            <p class="gv-admin-note">Rolę, blokadę i usuwanie konta zmienia się tylko na cudzych kontach.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
<% }) %>

<div class="modal fade" id="roleModal" tabindex="-1" aria-labelledby="roleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content gv-modal-content">
      <form method="POST" action="" id="roleForm" autocomplete="off">
        <input type="hidden" name="role" id="roleNewRole" value="">
        <div class="modal-header gv-modal-header">
          <h2 class="gv-auth-title mb-0" id="roleModalLabel"><i class="bi bi-shield-lock-fill"></i> <span id="roleTitle">Potwierdź zmianę</span></h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>
        <div class="modal-body">
          <p class="gv-auth-subtext" id="roleIntro"></p>

          <div class="mb-3">
            <label class="gv-label" for="roleConfirmName">Wpisz nazwę użytkownika <b id="roleTargetName"></b>, aby potwierdzić</label>
            <input type="text" id="roleConfirmName" name="confirmName" class="form-control gv-input" autocomplete="off" required>
          </div>
          <div class="mb-3">
            <label class="gv-label" for="rolePassword">Twoje hasło</label>
            <input type="password" id="rolePassword" name="password" class="form-control gv-input" autocomplete="current-password" required>
          </div>
          <% if (adminHasTwoFactor) { %>
            <div class="mb-3">
              <label class="gv-label" for="roleCode">Kod 2FA z aplikacji</label>
              <input type="text" id="roleCode" name="code" class="form-control gv-input" inputmode="numeric" maxlength="7" autocomplete="one-time-code" required>
            </div>
          <% } %>
        </div>
        <div class="modal-footer gv-modal-footer">
          <button type="button" class="btn gv-btn-ghost" data-bs-dismiss="modal">Anuluj</button>
          <button type="submit" class="btn gv-btn-success" id="roleSubmit" disabled>Potwierdź</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('roleModal');
    var form = document.getElementById('roleForm');
    var nameInput = document.getElementById('roleConfirmName');
    var submit = document.getElementById('roleSubmit');
    var wanted = '';

    // Przycisk potwierdzenia odblokowuje się dopiero po wpisaniu dokładnej nazwy użytkownika.
    function sync() {
      submit.disabled = nameInput.value.trim().toLowerCase() !== wanted.toLowerCase();
    }
    nameInput.addEventListener('input', sync);

    modal.addEventListener('show.bs.modal', function (event) {
      var trigger = event.relatedTarget;
      if (!trigger) return;
      var granting = trigger.getAttribute('data-new-role') === 'admin';
      wanted = trigger.getAttribute('data-username');

      form.reset();
      form.action = '/admin/users/' + trigger.getAttribute('data-user-id') + '/role';
      document.getElementById('roleNewRole').value = trigger.getAttribute('data-new-role');
      document.getElementById('roleTargetName').textContent = wanted;
      document.getElementById('roleTitle').textContent = granting ? 'Nadanie uprawnień administratora' : 'Odebranie uprawnień administratora';
      document.getElementById('roleIntro').textContent = granting
        ? 'Administrator ma dostęp do wszystkich danych i moderacji serwisu. Nadaj uprawnienia tylko osobie, której w pełni ufasz. Nowy administrator przez ' + <%= probationDays %> + ' dni nie zmienia uprawnień innych.'
        : 'Użytkownik straci dostęp do panelu admina, a jego weryfikacja dwuetapowa zostanie wyłączona.';
      sync();
    });
  });
</script>

<%- include('partials/bottom') %>
