<%- include('partials/top') %>

<form method="POST" action="/admin/settings/announcement" class="gv-admin-card gv-admin-form">
  <h2><i class="bi bi-megaphone-fill"></i> Ogłoszenie na górze strony</h2>
  <p class="gv-admin-note">Krótki komunikat widoczny dla wszystkich na każdej podstronie (np. o przerwie technicznej lub nowej funkcji).</p>

  <div class="gv-admin-form-grid">
    <div class="full">
      <label class="gv-label" for="annText">Treść ogłoszenia (do 300 znaków)</label>
      <textarea id="annText" name="text" rows="3" maxlength="300" class="form-control gv-input"><%= announcementForm.text %></textarea>
    </div>
    <div>
      <label class="gv-label" for="annType">Rodzaj</label>
      <select id="annType" name="type" class="form-select gv-select">
        <option value="info" <%= announcementForm.type === 'info' ? 'selected' : '' %>>Informacja</option>
        <option value="warning" <%= announcementForm.type === 'warning' ? 'selected' : '' %>>Ostrzeżenie</option>
      </select>
    </div>
    <div class="gv-admin-check">
      <label class="gv-check">
        <input type="checkbox" name="enabled" value="1" <%= announcementForm.enabled ? 'checked' : '' %>>
        <span>Wyświetlaj ogłoszenie</span>
      </label>
    </div>
  </div>

  <div class="gv-admin-form-actions">
    <button type="submit" class="btn gv-btn-success"><i class="bi bi-check-lg"></i> Zapisz</button>
  </div>
</form>

<%- include('partials/bottom') %>
