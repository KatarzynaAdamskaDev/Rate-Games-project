<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/app-extra.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <section class="gv-section">
    <div class="wrap">
      <h1 class="gv-page-title mb-4">Czat i grupy społeczności</h1>

      <div class="gv-chat-shell">
        <div class="gv-chat-list-col" id="chatListCol" data-active="<%= active ? active.id : '' %>">
          <div class="gv-chat-list-scroll">

          <form action="/chat/start/placeholder" method="POST" id="startDmForm" class="gv-chat-mini-form">
            <input type="text" id="dmUsername" name="dmUsername" list="userList" placeholder="Napisz do gracza..." autocomplete="off">
            <button type="submit" aria-label="Rozpocznij rozmowę"><i class="bi bi-send-fill"></i></button>
          </form>
          <p class="gv-group-hint mb-2"><%= currentUser.role === 'admin' ? 'Jako administrator możesz napisać do każdego użytkownika.' : 'Możesz pisać prywatnie tylko do wzajemnych znajomych.' %></p>
          <datalist id="userList">
            <% otherUsers.forEach(function(u) { %><option value="<%= u %>"><% }) %>
          </datalist>
          <script>
            document.getElementById('startDmForm').addEventListener('submit', function (e) {
              var username = document.getElementById('dmUsername').value.trim();
              if (!username) { e.preventDefault(); return; }
              this.action = '/chat/start/' + encodeURIComponent(username);
            });
          </script>

          <div class="gv-chat-group-label">Rozmowy</div>
          <div id="dmConversationList">
          <% conversations.filter(function(c){return c.type === 'dm';}).forEach(function(c) { %>
            <a href="/chat?c=<%= c.id %>" class="gv-chat-item <%= active && active.id === c.id ? 'active' : '' %> text-decoration-none">
              <div class="gv-c-avatar"></div>
              <div><b><%= c.displayName %></b><span>Rozmowa prywatna</span></div>
              <% if (unreadByConversation[c.id]) { %><span class="gv-chat-unread"><%= unreadByConversation[c.id] %></span><% } %>
            </a>
          <% }) %>
          <% if (conversations.filter(function(c){return c.type === 'dm';}).length === 0) { %>
            <p class="gv-game-card-count px-2" style="color:var(--text-lo); font-size:11.5px;">Brak rozmów. Napisz do kogoś powyżej.</p>
          <% } %>
          </div>

          <div class="gv-chat-group-label">Grupy</div>
          <div id="groupConversationList">
          <% conversations.filter(function(c){return c.type === 'group';}).forEach(function(c) { %>
            <a href="/chat?c=<%= c.id %>" class="gv-chat-item <%= active && active.id === c.id ? 'active' : '' %> text-decoration-none">
              <div class="gv-c-avatar"></div>
              <div><b><%= c.displayName %></b><span><%= c.memberIds.length %> członków</span></div>
              <% if (unreadByConversation[c.id]) { %><span class="gv-chat-unread"><%= unreadByConversation[c.id] %></span><% } %>
            </a>
          <% }) %>
          </div>
          <button type="button" class="gv-btn-outline w-100 mt-2 mb-1" data-bs-toggle="collapse" data-bs-target="#newGroupForm">+ Nowa grupa</button>

          <form action="/chat/groups/new" method="POST" class="collapse" id="newGroupForm">
            <input type="text" name="name" placeholder="Nazwa grupy" class="form-control gv-input mb-2" required>

            <div class="gv-group-member-picker mb-2">
              <input type="text" id="groupMemberSearch" placeholder="Wpisz nick znajomego..." class="form-control gv-input" autocomplete="off">
              <div id="groupMemberSuggestions" class="gv-group-suggestions d-none"></div>
            </div>

            <div id="groupMemberChips" class="gv-group-chips mb-2"></div>
            <p id="groupMemberHint" class="gv-group-hint" style="display:none;">Do grupy możesz dodać tylko wzajemnych znajomych (obserwujecie się nawzajem).</p>

            <button type="submit" class="gv-btn-success w-100" id="createGroupBtn" disabled>Utwórz grupę</button>
          </form>
          <script>
            (function () {
              var searchInput = document.getElementById('groupMemberSearch');
              var suggestionsBox = document.getElementById('groupMemberSuggestions');
              var chipsBox = document.getElementById('groupMemberChips');
              var createBtn = document.getElementById('createGroupBtn');
              var hint = document.getElementById('groupMemberHint');
              var selected = {}; // id -> username
              var debounceTimer;

              function renderChips() {
                chipsBox.innerHTML = '';
                Object.keys(selected).forEach(function (id) {
                  var chip = document.createElement('span');
                  chip.className = 'gv-chip';
                  chip.textContent = selected[id];

                  var remove = document.createElement('button');
                  remove.type = 'button';
                  remove.innerHTML = '&times;';
                  remove.addEventListener('click', function () {
                    delete selected[id];
                    renderChips();
                  });
                  chip.appendChild(remove);

                  var hidden = document.createElement('input');
                  hidden.type = 'hidden';
                  hidden.name = 'memberIds';
                  hidden.value = id;
                  chip.appendChild(hidden);

                  chipsBox.appendChild(chip);
                });
                createBtn.disabled = Object.keys(selected).length === 0;
              }

              function renderSuggestions(users) {
                suggestionsBox.innerHTML = '';
                var any = false;
                users.forEach(function (u) {
                  if (selected[u.id]) return;
                  any = true;
                  var item = document.createElement('button');
                  item.type = 'button';
                  item.className = 'gv-group-suggestion-item';
                  item.textContent = u.username;
                  item.addEventListener('click', function () {
                    selected[u.id] = u.username;
                    renderChips();
                    suggestionsBox.classList.add('d-none');
                    searchInput.value = '';
                  });
                  suggestionsBox.appendChild(item);
                });
                if (!any) {
                  var empty = document.createElement('div');
                  empty.className = 'gv-group-suggestion-empty';
                  empty.textContent = 'Brak pasujących znajomych.';
                  suggestionsBox.appendChild(empty);
                }
                suggestionsBox.classList.remove('d-none');
              }

              searchInput.addEventListener('focus', function () {
                hint.style.display = 'block';
              });

              searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                var q = searchInput.value.trim();
                debounceTimer = setTimeout(function () {
                  fetch('/chat/friends-search?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) { renderSuggestions(data.users || []); });
                }, 200);
              });

              document.addEventListener('click', function (e) {
                if (!suggestionsBox.contains(e.target) && e.target !== searchInput) {
                  suggestionsBox.classList.add('d-none');
                }
              });
            })();
          </script>

          </div>

          <div class="gv-chat-rooms">
          <div class="gv-chat-group-label">Pokoje gier</div>
          <div class="gv-chat-game-rooms-scroll">
            <% conversations.filter(function(c){return c.type === 'game-room';}).forEach(function(c) { %>
              <a href="/chat?c=<%= c.id %>" class="gv-chat-item <%= active && active.id === c.id ? 'active' : '' %> text-decoration-none">
                <div class="gv-c-avatar"></div>
                <div><b><%= c.displayName %></b><span><%= c.memberIds.length %> graczy</span></div>
                <% if (unreadByConversation[c.id]) { %><span class="gv-chat-unread"><%= unreadByConversation[c.id] %></span><% } %>
              </a>
            <% }) %>
            <% if (popularGames.length) { %>
              <p class="px-2 mb-1" style="color:var(--text-lo); font-size:11px;">Dołącz do pokoju gry:</p>
              <% popularGames.forEach(function(g) { %>
                <a href="/chat/rooms/<%= g.id %>" class="gv-chat-item text-decoration-none">
                  <div class="gv-c-avatar"></div>
                  <div><b>#<%= g.title.toLowerCase().replace(/\s+/g, '-') %></b><span><%= g.title %></span></div>
                </a>
              <% }) %>
            <% } %>
          </div>
          </div>

        </div>

        <div class="gv-chat-main-col">
          <% if (!active) { %>
            <div class="gv-chat-empty">Wybierz rozmowę, grupę lub pokój gry z listy po lewej, albo rozpocznij nową.</div>
          <% } else { %>
            <div class="gv-chat-topbar">
              <div class="gv-c-avatar"></div>
              <div class="gv-chat-topbar-info">
                <b>
                  <% if (active.type === 'dm') { %>
                    <% var otherId = active.memberIds.find(function(id){ return id !== currentUser.id; }); %>
                    <a href="/<%= active.memberNames[otherId] %>" class="gv-chat-name-link"><%= active.memberNames[otherId] %></a>
                  <% } else { %>
                    <button type="button" class="gv-chat-name-link gv-group-name-toggle" id="groupMembersToggle">
                      <%= active.name %>
                      <i class="bi bi-caret-down-fill gv-group-toggle-icon"></i>
                    </button>
                    <div class="gv-group-members-dropdown d-none" id="groupMembersDropdown">
                      <% active.memberIds.forEach(function(id) { %>
                        <a href="/<%= active.memberNames[id] %>" class="gv-group-member-item"><%= active.memberNames[id] %></a>
                      <% }) %>
                    </div>
                  <% } %>
                </b>
                <div style="color:var(--text-lo); font-size:11.5px;">
                  <%= active.type === 'dm' ? 'Rozmowa prywatna' : (active.type === 'group' ? active.memberIds.length + ' członków grupy' : 'Pokój dyskusyjny gry') %>
                  <% if (active.type === 'dm' && !active.canReply) { %>
                    <span class="gv-badge gv-badge-warn" title="Tylko administrator może pisać w tej rozmowie">bez możliwości odpowiedzi</span>
                  <% } %>
                </div>
              </div>
              <div class="gv-chat-topbar-actions">
                <form action="/chat/<%= active.id %>/clear" method="POST" onsubmit="return confirm('Wyczyścić wszystkie wiadomości w tej rozmowie?');">
                  <button type="submit" class="gv-chat-action-btn" title="Wyczyść czat" aria-label="Wyczyść czat"><i class="bi bi-eraser-fill"></i></button>
                </form>
                <form action="/chat/<%= active.id %>/delete" method="POST" onsubmit="return confirm('Usunąć tę rozmowę na stałe? Tej operacji nie można cofnąć.');">
                  <button type="submit" class="gv-chat-action-btn" title="Usuń czat" aria-label="Usuń czat"><i class="bi bi-trash3-fill"></i></button>
                </form>
              </div>
            </div>

            <div class="gv-chat-body" id="chatBody" data-conversation="<%= active.id %>">
              <% messages.forEach(function(m) { %>
                <div class="gv-msg <%= m.senderId === currentUser.id ? 'me' : '' %>" data-id="<%= m.id %>">
                  <% if (m.senderId !== currentUser.id) { %>
                    <% if (m.senderDeleted) { %><b class="gv-msg-deleted"><%= m.senderUsername %></b><% } else { %><a href="/<%= m.senderUsername %>" class="gv-chat-name-link"><b><%= m.senderUsername %></b></a><% } %>
                  <% } %>
                  <%= m.text %>
                  <small><%= new Date(m.createdAt).toLocaleTimeString('pl-PL', {hour:'2-digit', minute:'2-digit'}) %></small>
                  <% if (m.senderId !== currentUser.id && !m.senderDeleted) { %>
                    <button type="button" class="gv-msg-report" title="Zgłoś wiadomość"
                            data-bs-toggle="modal" data-bs-target="#reportModal"
                            data-report-type="message"
                            data-report-url="/reports/message/<%= m.id %>"
                            data-report-author="<%= m.senderUsername %>"><i class="bi bi-flag"></i></button>
                  <% } %>
                </div>
              <% }) %>
            </div>

            <% var canISend = active.canReply || currentUser.role === 'admin'; %>
            <% if (canISend) { %>
              <form class="gv-chat-input-row" id="chatForm">
                <input type="text" id="chatText" placeholder="Napisz wiadomość..." autocomplete="off">
                <button type="submit" class="gv-chat-send" aria-label="Wyślij"><i class="bi bi-send-fill"></i></button>
              </form>
            <% } else { %>
              <p class="gv-group-hint px-2 py-2 mb-0"><i class="bi bi-info-circle"></i> Administrator wysłał tę wiadomość bez możliwości odpowiedzi.</p>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/report-modal') %>
  <%- include('../partials/footer') %>

  <script>
    // Lista rozmów po lewej (nowe rozmowy, nowe wiadomości i kolejność) odświeża się sama - bez tego
    // widać je dopiero po ręcznym przeładowaniu strony. Działa niezależnie od tego, czy jakaś rozmowa
    // jest akurat otwarta (patrz niżej osobny, częstszy polling samej otwartej rozmowy).
    (function () {
      var col = document.getElementById('chatListCol');
      var dmBox = document.getElementById('dmConversationList');
      var groupBox = document.getElementById('groupConversationList');
      if (!col || !dmBox || !groupBox) return;
      var activeId = col.dataset.active || null;

      function timeAgo(iso) {
        var seconds = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 1000));
        if (seconds < 60) return 'przed chwilą';
        if (seconds < 3600) return Math.floor(seconds / 60) + ' min temu';
        if (seconds < 86400) return Math.floor(seconds / 3600) + ' godz. temu';
        return new Date(iso).toLocaleDateString('pl-PL');
      }

      function renderItem(c) {
        var a = document.createElement('a');
        a.href = '/chat?c=' + encodeURIComponent(c.id);
        a.className = 'gv-chat-item text-decoration-none' + (c.id === activeId ? ' active' : '');

        var avatar = document.createElement('div');
        avatar.className = 'gv-c-avatar';

        var info = document.createElement('div');
        var name = document.createElement('b');
        name.textContent = c.name;
        var meta = document.createElement('span');
        if (c.type === 'dm') {
          meta.textContent = 'Rozmowa prywatna';
        } else if (c.lastMessage) {
          meta.textContent = (c.lastMessage.mine ? 'Ty: ' : c.lastMessage.senderUsername + ': ') + c.lastMessage.text;
        } else {
          meta.textContent = 'Brak wiadomości';
        }
        info.appendChild(name);
        info.appendChild(meta);

        a.appendChild(avatar);
        a.appendChild(info);
        if (c.unread > 0) {
          var badge = document.createElement('span');
          badge.className = 'gv-chat-unread';
          badge.textContent = String(c.unread);
          a.appendChild(badge);
        }
        return a;
      }

      function renderList(box, items, emptyText) {
        box.innerHTML = '';
        if (items.length === 0) {
          if (!emptyText) return;
          var empty = document.createElement('p');
          empty.className = 'gv-game-card-count px-2';
          empty.style.color = 'var(--text-lo)';
          empty.style.fontSize = '11.5px';
          empty.textContent = emptyText;
          box.appendChild(empty);
          return;
        }
        items.forEach(function (c) { box.appendChild(renderItem(c)); });
      }

      function refreshSidebar() {
        fetch('/chat/api/list', { headers: { Accept: 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) {
            if (!data) return;
            var items = data.conversations || [];
            renderList(dmBox, items.filter(function (c) { return c.type === 'dm'; }), 'Brak rozmów. Napisz do kogoś powyżej.');
            renderList(groupBox, items.filter(function (c) { return c.type === 'group'; }), null);
          })
          .catch(function () {});
      }

      setInterval(refreshSidebar, 6000);
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) refreshSidebar();
      });
    })();
  </script>

  <% if (active) { %>
  <script>
    (function () {
      var conversationId = <%- JSON.stringify(active.id) %>;
      var meId = <%- JSON.stringify(currentUser.id) %>;
      var chatBody = document.getElementById('chatBody');
      // Formularza nie ma, gdy administrator wyłączył odpowiedź w tej rozmowie, a nie jesteś adminem.
      var form = document.getElementById('chatForm');
      var input = document.getElementById('chatText');
      var sendBtn = form ? form.querySelector('button[type="submit"]') : null;
      var lastTimestamp = <%- JSON.stringify(messages.length ? messages[messages.length - 1].createdAt : null) %>;
      var seenIds = {};
      var isSending = false;
      var isPolling = false;

      // Zapamiętaj ID wiadomości wyrenderowanych już przez serwer, żeby
      // polling ich nie zdublował.
      document.querySelectorAll('#chatBody .gv-msg[data-id]').forEach(function (el) {
        seenIds[el.dataset.id] = true;
      });

      function appendMessage(m) {
        if (seenIds[m.id]) return; // zabezpieczenie przed duplikatem
        seenIds[m.id] = true;

        var div = document.createElement('div');
        div.className = 'gv-msg' + (m.senderId === meId ? ' me' : '');
        div.dataset.id = m.id;
        var time = new Date(m.createdAt).toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
        var name = document.createElement('b');
        name.textContent = m.senderUsername;
        if (m.senderId !== meId) {
          if (m.senderDeleted) {
            name.className = 'gv-msg-deleted';
            div.appendChild(name);
          } else {
            var link = document.createElement('a');
            link.href = '/' + encodeURIComponent(m.senderUsername);
            link.className = 'gv-chat-name-link';
            link.appendChild(name);
            div.appendChild(link);
          }
        }
        div.appendChild(document.createTextNode(m.text));
        var small = document.createElement('small');
        small.textContent = time;
        div.appendChild(small);
        if (m.senderId !== meId && !m.senderDeleted) {
          // Zgłoszenie wiadomości otwiera wspólne okno (partials/report-modal.ejs).
          var flag = document.createElement('button');
          flag.type = 'button';
          flag.className = 'gv-msg-report';
          flag.title = 'Zgłoś wiadomość';
          flag.setAttribute('data-bs-toggle', 'modal');
          flag.setAttribute('data-bs-target', '#reportModal');
          flag.setAttribute('data-report-type', 'message');
          flag.setAttribute('data-report-url', '/reports/message/' + encodeURIComponent(m.id));
          flag.setAttribute('data-report-author', m.senderUsername);
          flag.innerHTML = '<i class="bi bi-flag"></i>';
          div.appendChild(flag);
        }
        chatBody.appendChild(div);
        chatBody.scrollTop = chatBody.scrollHeight;
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (isSending) return; // blokada podwójnego Entera/kliknięcia

          var text = input.value.trim();
          if (!text) return;

          isSending = true;
          sendBtn.disabled = true;
          input.value = ''; // czyścimy od razu, nie czekając na odpowiedź serwera

          fetch('/chat/' + conversationId + '/messages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'text=' + encodeURIComponent(text),
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data.message) {
                appendMessage(data.message);
                lastTimestamp = data.message.createdAt;
              } else if (data.error) {
                // Odrzucona wiadomość (antyspam, filtr, limit) - pokazujemy powód i oddajemy tekst do poprawy.
                if (window.showToast) showToast(data.error, false);
                input.value = text;
              }
            })
            .finally(function () {
              isSending = false;
              sendBtn.disabled = false;
              input.focus();
            });
        });
      }

      function poll() {
        if (isPolling) return; // nie nakładaj zapytań, jeśli poprzednie jeszcze trwa
        isPolling = true;

        var url = '/chat/' + conversationId + '/messages' + (lastTimestamp ? '?after=' + encodeURIComponent(lastTimestamp) : '');
        fetch(url)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            (data.messages || []).forEach(function (m) {
              appendMessage(m);
              lastTimestamp = m.createdAt;
            });
          })
          .finally(function () { isPolling = false; });
      }

      setInterval(poll, 4000);
      chatBody.scrollTop = chatBody.scrollHeight;

      // Rozwijana lista członków grupy (jeśli aktywna rozmowa to grupa)
      var groupToggle = document.getElementById('groupMembersToggle');
      var groupDropdown = document.getElementById('groupMembersDropdown');
      if (groupToggle && groupDropdown) {
        groupToggle.addEventListener('click', function (e) {
          e.stopPropagation();
          var isOpen = groupDropdown.classList.toggle('d-none') === false;
          groupToggle.classList.toggle('open', isOpen);
        });
        document.addEventListener('click', function (e) {
          if (!groupDropdown.contains(e.target) && e.target !== groupToggle) {
            groupDropdown.classList.add('d-none');
            groupToggle.classList.remove('open');
          }
        });
      }
    })();
  </script>
  <% } %>
</body>
</html>
