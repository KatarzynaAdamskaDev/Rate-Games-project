<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/app-extra.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <section class="gv-section">
    <div class="wrap">
      <h1 class="gv-page-title mb-4">Czat i grupy społeczności</h1>

      <div class="gv-chat-shell">
        <div class="gv-chat-list-col">

          <form action="/chat/start/placeholder" method="POST" id="startDmForm" class="gv-chat-mini-form">
            <input type="text" id="dmUsername" name="dmUsername" list="userList" placeholder="Napisz do gracza..." autocomplete="off">
            <button type="submit">➤</button>
          </form>
          <p class="gv-group-hint mb-2">Możesz pisać prywatnie tylko do wzajemnych znajomych.</p>
          <datalist id="userList">
            <% otherUsers.forEach(function(u) { %><option value="<%= u %>"><% }) %>
          </datalist>
          <script>
            document.getElementById('startDmForm').addEventListener('submit', function (e) {
              var username = document.getElementById('dmUsername').value.trim();
              if (!username) { e.preventDefault(); return; }
              this.action = '/chat/start/' + encodeURIComponent(username);
            });
          </script>

          <div class="gv-chat-group-label">Rozmowy</div>
          <% conversations.filter(function(c){return c.type === 'dm';}).forEach(function(c) { %>
            <a href="/chat?c=<%= c.id %>" class="gv-chat-item <%= active && active.id === c.id ? 'active' : '' %> text-decoration-none">
              <div class="gv-c-avatar"></div>
              <div><b><%= c.displayName %></b><span>Rozmowa prywatna</span></div>
            </a>
          <% }) %>
          <% if (conversations.filter(function(c){return c.type === 'dm';}).length === 0) { %>
            <p class="gv-game-card-count px-2" style="color:var(--text-lo); font-size:11.5px;">Brak rozmów. Napisz do kogoś powyżej.</p>
          <% } %>

          <div class="gv-chat-group-label">Grupy</div>
          <% conversations.filter(function(c){return c.type === 'group';}).forEach(function(c) { %>
            <a href="/chat?c=<%= c.id %>" class="gv-chat-item <%= active && active.id === c.id ? 'active' : '' %> text-decoration-none">
              <div class="gv-c-avatar"></div>
              <div><b><%= c.displayName %></b><span><%= c.memberIds.length %> członków</span></div>
            </a>
          <% }) %>
          <button type="button" class="gv-btn-outline w-100 mt-2 mb-1" data-bs-toggle="collapse" data-bs-target="#newGroupForm">+ Nowa grupa</button>

          <form action="/chat/groups/new" method="POST" class="collapse" id="newGroupForm">
            <input type="text" name="name" placeholder="Nazwa grupy" class="form-control gv-input mb-2" required>

            <div class="gv-group-member-picker mb-2">
              <input type="text" id="groupMemberSearch" placeholder="Wpisz nick znajomego..." class="form-control gv-input" autocomplete="off">
              <div id="groupMemberSuggestions" class="gv-group-suggestions d-none"></div>
            </div>

            <div id="groupMemberChips" class="gv-group-chips mb-2"></div>
            <p id="groupMemberHint" class="gv-group-hint" style="display:none;">Do grupy możesz dodać tylko wzajemnych znajomych (obserwujecie się nawzajem).</p>

            <button type="submit" class="gv-btn-success w-100" id="createGroupBtn" disabled>Utwórz grupę</button>
          </form>
          <script>
            (function () {
              var searchInput = document.getElementById('groupMemberSearch');
              var suggestionsBox = document.getElementById('groupMemberSuggestions');
              var chipsBox = document.getElementById('groupMemberChips');
              var createBtn = document.getElementById('createGroupBtn');
              var hint = document.getElementById('groupMemberHint');
              var selected = {}; // id -> username
              var debounceTimer;

              function renderChips() {
                chipsBox.innerHTML = '';
                Object.keys(selected).forEach(function (id) {
                  var chip = document.createElement('span');
                  chip.className = 'gv-chip';
                  chip.textContent = selected[id];

                  var remove = document.createElement('button');
                  remove.type = 'button';
                  remove.innerHTML = '&times;';
                  remove.addEventListener('click', function () {
                    delete selected[id];
                    renderChips();
                  });
                  chip.appendChild(remove);

                  var hidden = document.createElement('input');
                  hidden.type = 'hidden';
                  hidden.name = 'memberIds';
                  hidden.value = id;
                  chip.appendChild(hidden);

                  chipsBox.appendChild(chip);
                });
                createBtn.disabled = Object.keys(selected).length === 0;
              }

              function renderSuggestions(users) {
                suggestionsBox.innerHTML = '';
                var any = false;
                users.forEach(function (u) {
                  if (selected[u.id]) return;
                  any = true;
                  var item = document.createElement('button');
                  item.type = 'button';
                  item.className = 'gv-group-suggestion-item';
                  item.textContent = u.username;
                  item.addEventListener('click', function () {
                    selected[u.id] = u.username;
                    renderChips();
                    suggestionsBox.classList.add('d-none');
                    searchInput.value = '';
                  });
                  suggestionsBox.appendChild(item);
                });
                if (!any) {
                  var empty = document.createElement('div');
                  empty.className = 'gv-group-suggestion-empty';
                  empty.textContent = 'Brak pasujących znajomych.';
                  suggestionsBox.appendChild(empty);
                }
                suggestionsBox.classList.remove('d-none');
              }

              searchInput.addEventListener('focus', function () {
                hint.style.display = 'block';
              });

              searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                var q = searchInput.value.trim();
                debounceTimer = setTimeout(function () {
                  fetch('/chat/friends-search?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) { renderSuggestions(data.users || []); });
                }, 200);
              });

              document.addEventListener('click', function (e) {
                if (!suggestionsBox.contains(e.target) && e.target !== searchInput) {
                  suggestionsBox.classList.add('d-none');
                }
              });
            })();
          </script>

          <div class="gv-chat-group-label">Pokoje gier</div>
          <% conversations.filter(function(c){return c.type === 'game-room';}).forEach(function(c) { %>
            <a href="/chat?c=<%= c.id %>" class="gv-chat-item <%= active && active.id === c.id ? 'active' : '' %> text-decoration-none">
              <div class="gv-c-avatar"></div>
              <div><b><%= c.displayName %></b><span><%= c.memberIds.length %> graczy</span></div>
            </a>
          <% }) %>
          <% if (popularGames.length) { %>
            <p class="px-2 mb-1" style="color:var(--text-lo); font-size:11px;">Dołącz do pokoju gry:</p>
            <% popularGames.forEach(function(g) { %>
              <a href="/chat/rooms/<%= g.id %>" class="gv-chat-item text-decoration-none">
                <div class="gv-c-avatar"></div>
                <div><b>#<%= g.title.toLowerCase().replace(/\s+/g, '-') %></b><span><%= g.title %></span></div>
              </a>
            <% }) %>
          <% } %>

        </div>

        <div class="gv-chat-main-col">
          <% if (!active) { %>
            <div class="gv-chat-empty">Wybierz rozmowę, grupę lub pokój gry z listy po lewej, albo rozpocznij nową.</div>
          <% } else { %>
            <div class="gv-chat-topbar">
              <div class="gv-c-avatar"></div>
              <div class="gv-chat-topbar-info">
                <b>
                  <% if (active.type === 'dm') { %>
                    <% var otherId = active.memberIds.find(function(id){ return id !== currentUser.id; }); %>
                    <%= active.memberNames[otherId] %>
                  <% } else { %>
                    <%= active.name %>
                  <% } %>
                </b>
                <div style="color:var(--text-lo); font-size:11.5px;">
                  <%= active.type === 'dm' ? 'Rozmowa prywatna' : (active.type === 'group' ? active.memberIds.length + ' członków grupy' : 'Pokój dyskusyjny gry') %>
                </div>
              </div>
              <div class="gv-chat-topbar-actions">
                <form action="/chat/<%= active.id %>/clear" method="POST" onsubmit="return confirm('Wyczyścić wszystkie wiadomości w tej rozmowie?');">
                  <button type="submit" class="gv-chat-action-btn" title="Wyczyść czat">🧹</button>
                </form>
                <form action="/chat/<%= active.id %>/delete" method="POST" onsubmit="return confirm('Usunąć tę rozmowę na stałe? Tej operacji nie można cofnąć.');">
                  <button type="submit" class="gv-chat-action-btn" title="Usuń czat">🗑️</button>
                </form>
              </div>
            </div>

            <div class="gv-chat-body" id="chatBody" data-conversation="<%= active.id %>">
              <% messages.forEach(function(m) { %>
                <div class="gv-msg <%= m.senderId === currentUser.id ? 'me' : '' %>" data-id="<%= m.id %>">
                  <% if (m.senderId !== currentUser.id) { %><b><%= m.senderUsername %></b><% } %>
                  <%= m.text %>
                  <small><%= new Date(m.createdAt).toLocaleTimeString('pl-PL', {hour:'2-digit', minute:'2-digit'}) %></small>
                </div>
              <% }) %>
            </div>

            <form class="gv-chat-input-row" id="chatForm">
              <input type="text" id="chatText" placeholder="Napisz wiadomość..." autocomplete="off">
              <button type="submit" class="gv-chat-send">➤</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>

  <% if (active) { %>
  <script>
    (function () {
      var conversationId = <%- JSON.stringify(active.id) %>;
      var meId = <%- JSON.stringify(currentUser.id) %>;
      var chatBody = document.getElementById('chatBody');
      var form = document.getElementById('chatForm');
      var input = document.getElementById('chatText');
      var sendBtn = form.querySelector('button[type="submit"]');
      var lastTimestamp = <%- JSON.stringify(messages.length ? messages[messages.length - 1].createdAt : null) %>;
      var seenIds = {};
      var isSending = false;
      var isPolling = false;

      // Zapamiętaj ID wiadomości wyrenderowanych już przez serwer, żeby
      // polling ich nie zdublował.
      document.querySelectorAll('#chatBody .gv-msg[data-id]').forEach(function (el) {
        seenIds[el.dataset.id] = true;
      });

      function appendMessage(m) {
        if (seenIds[m.id]) return; // zabezpieczenie przed duplikatem
        seenIds[m.id] = true;

        var div = document.createElement('div');
        div.className = 'gv-msg' + (m.senderId === meId ? ' me' : '');
        div.dataset.id = m.id;
        var time = new Date(m.createdAt).toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
        div.innerHTML = (m.senderId === meId ? '' : '<b>' + m.senderUsername + '</b>') + m.text + '<small>' + time + '</small>';
        chatBody.appendChild(div);
        chatBody.scrollTop = chatBody.scrollHeight;
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (isSending) return; // blokada podwójnego Entera/kliknięcia

        var text = input.value.trim();
        if (!text) return;

        isSending = true;
        sendBtn.disabled = true;
        input.value = ''; // czyścimy od razu, nie czekając na odpowiedź serwera

        fetch('/chat/' + conversationId + '/messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'text=' + encodeURIComponent(text),
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.message) {
              appendMessage(data.message);
              lastTimestamp = data.message.createdAt;
            }
          })
          .finally(function () {
            isSending = false;
            sendBtn.disabled = false;
            input.focus();
          });
      });

      function poll() {
        if (isPolling) return; // nie nakładaj zapytań, jeśli poprzednie jeszcze trwa
        isPolling = true;

        var url = '/chat/' + conversationId + '/messages' + (lastTimestamp ? '?after=' + encodeURIComponent(lastTimestamp) : '');
        fetch(url)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            (data.messages || []).forEach(function (m) {
              appendMessage(m);
              lastTimestamp = m.createdAt;
            });
          })
          .finally(function () { isPolling = false; });
      }

      setInterval(poll, 4000);
      chatBody.scrollTop = chatBody.scrollHeight;
    })();
  </script>
  <% } %>
</body>
</html>
