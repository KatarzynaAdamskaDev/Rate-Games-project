<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/app-extra.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <section class="gv-section">
    <div class="wrap">
      <h1 class="gv-page-title mb-4">Czat i grupy społeczności</h1>

      <div class="gv-chat-shell" data-view="<%= chatView %>">
        <div class="gv-chat-list-col" id="chatListCol" data-active="<%= active ? active.id : '' %>">
          <div class="gv-chat-list-scroll">

          <form action="/chat/start/placeholder" method="POST" id="startDmForm" class="gv-chat-mini-form">
            <input type="text" id="dmUsername" name="dmUsername" list="userList" placeholder="Napisz do gracza..." autocomplete="off">
            <button type="submit" aria-label="Rozpocznij rozmowę"><i class="bi bi-send-fill"></i></button>
          </form>
          <p class="gv-group-hint mb-2"><%= currentUser.role === 'admin' ? 'Jako administrator możesz napisać do każdego użytkownika.' : 'Możesz pisać prywatnie tylko do wzajemnych znajomych.' %></p>
          <datalist id="userList">
            <% otherUsers.forEach(function(u) { %><option value="<%= u %>"><% }) %>
          </datalist>
          <script>
            document.getElementById('startDmForm').addEventListener('submit', function (e) {
              var username = document.getElementById('dmUsername').value.trim();
              if (!username) { e.preventDefault(); return; }
              this.action = '/chat/start/' + encodeURIComponent(username);
            });
          </script>

          <% if (pendingInvites.length > 0) { %>
            <div class="gv-chat-group-label">Zaproszenia</div>
            <div class="mb-2" id="invitesList">
              <% pendingInvites.forEach(function(inv) { %>
                <div class="gv-invite-item <%= focusedInvite && focusedInvite.id === inv.id ? 'is-focus' : '' %>">
                  <a href="/chat?invite=<%= inv.id %>" class="gv-invite-open text-decoration-none">
                    <% if (inv.photoUrl) { %>
                      <img src="<%= inv.photoUrl %>" alt="" class="gv-c-avatar" style="object-fit:cover;">
                    <% } else { %>
                      <div class="gv-c-avatar"></div>
                    <% } %>
                    <span class="gv-invite-info">
                      <b><%= inv.name %></b>
                      <span>Zaprosił(a) <%= inv.memberNames[inv.ownerId] || 'właściciel' %></span>
                    </span>
                  </a>
                  <div class="gv-invite-actions">
                    <form action="/chat/invites/<%= inv.id %>/accept" method="POST">
                      <button type="submit" class="gv-invite-btn gv-invite-accept" title="Dołącz do grupy" aria-label="Akceptuj zaproszenie"><i class="bi bi-check-lg"></i></button>
                    </form>
                    <form action="/chat/invites/<%= inv.id %>/decline" method="POST">
                      <button type="submit" class="gv-invite-btn gv-invite-decline" title="Odrzuć zaproszenie" aria-label="Odrzuć zaproszenie"><i class="bi bi-x-lg"></i></button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>

          <div class="gv-chat-group-label">Rozmowy</div>
          <div id="dmConversationList">
          <% conversations.filter(function(c){return c.type === 'dm';}).forEach(function(c) { %>
            <% var listOtherId = c.memberIds.find(function(id){ return id !== currentUser.id; }); %>
            <% var listAvatarUrl = listOtherId ? c.memberAvatars[listOtherId] : null; %>
            <a href="/chat?c=<%= c.id %>" class="gv-chat-item <%= active && active.id === c.id ? 'active' : '' %> text-decoration-none">
              <% if (listAvatarUrl) { %>
                <img src="<%= listAvatarUrl %>" alt="" class="gv-c-avatar" style="object-fit:cover;">
              <% } else { %>
                <div class="gv-c-avatar"></div>
              <% } %>
              <div><b><%= c.displayName %></b><span>Rozmowa prywatna</span></div>
              <% if (unreadByConversation[c.id]) { %><span class="gv-chat-unread"><%= unreadByConversation[c.id] %></span><% } %>
            </a>
          <% }) %>
          <% if (conversations.filter(function(c){return c.type === 'dm';}).length === 0) { %>
            <p class="gv-game-card-count px-2" style="color:var(--text-lo); font-size:11.5px;">Brak rozmów. Napisz do kogoś powyżej.</p>
          <% } %>
          </div>

          <div class="gv-chat-group-label">Grupy</div>
          <div id="groupConversationList">
          <% conversations.filter(function(c){return c.type === 'group';}).forEach(function(c) { %>
            <a href="/chat?c=<%= c.id %>" class="gv-chat-item <%= active && active.id === c.id ? 'active' : '' %> text-decoration-none">
              <% if (c.photoUrl) { %>
                <img src="<%= c.photoUrl %>" alt="" class="gv-c-avatar" style="object-fit:cover;">
              <% } else { %>
                <div class="gv-c-avatar"></div>
              <% } %>
              <div><b><%= c.displayName %></b><span><%= c.memberIds.length %> członków</span></div>
              <% if (unreadByConversation[c.id]) { %><span class="gv-chat-unread"><%= unreadByConversation[c.id] %></span><% } %>
            </a>
          <% }) %>
          </div>
          <button type="button" class="gv-btn-outline w-100 mt-2 mb-1" data-bs-toggle="collapse" data-bs-target="#newGroupForm">+ Nowa grupa</button>

          <form action="/chat/groups/new" method="POST" class="collapse" id="newGroupForm">
            <input type="text" name="name" placeholder="Nazwa grupy" class="form-control gv-input mb-2" required>
            <p class="gv-group-hint mb-2">Zdjęcie grupy ustawisz później, w ustawieniach grupy. Zaproszeni znajomi muszą zaakceptować zaproszenie, żeby dołączyć.</p>

            <div class="gv-group-member-picker mb-2">
              <input type="text" id="groupMemberSearch" placeholder="Wpisz nick znajomego..." class="form-control gv-input" autocomplete="off">
              <div id="groupMemberSuggestions" class="gv-group-suggestions d-none"></div>
            </div>

            <div id="groupMemberChips" class="gv-group-chips mb-2"></div>
            <p id="groupMemberHint" class="gv-group-hint" style="display:none;">Do grupy możesz dodać tylko wzajemnych znajomych (obserwujecie się nawzajem).</p>

            <button type="submit" class="gv-btn-success w-100" id="createGroupBtn" disabled>Utwórz i zaproś</button>
          </form>
          <script>
            // Wspólna logika wyszukiwarki znajomych (chipy + podpowiedzi) - używana zarówno przy
            // tworzeniu grupy, jak i przy zapraszaniu kolejnych osób do istniejącej grupy
            // (zob. #groupSettingsModal niżej). Wywoływane raz na formularz, z własnym kompletem id.
            function initGvMemberPicker(ids) {
              var searchInput = document.getElementById(ids.search);
              var suggestionsBox = document.getElementById(ids.suggestions);
              var chipsBox = document.getElementById(ids.chips);
              var submitBtn = document.getElementById(ids.submitBtn);
              var hint = document.getElementById(ids.hint);
              if (!searchInput) return;
              var selected = {}; // id -> username
              var debounceTimer;

              function renderChips() {
                chipsBox.innerHTML = '';
                Object.keys(selected).forEach(function (id) {
                  var chip = document.createElement('span');
                  chip.className = 'gv-chip';
                  chip.textContent = selected[id];

                  var remove = document.createElement('button');
                  remove.type = 'button';
                  remove.innerHTML = '&times;';
                  remove.addEventListener('click', function () {
                    delete selected[id];
                    renderChips();
                  });
                  chip.appendChild(remove);

                  var hidden = document.createElement('input');
                  hidden.type = 'hidden';
                  hidden.name = 'memberIds';
                  hidden.value = id;
                  chip.appendChild(hidden);

                  chipsBox.appendChild(chip);
                });
                if (submitBtn) submitBtn.disabled = Object.keys(selected).length === 0;
              }

              function renderSuggestions(users) {
                suggestionsBox.innerHTML = '';
                var any = false;
                users.forEach(function (u) {
                  if (selected[u.id]) return;
                  any = true;
                  var item = document.createElement('button');
                  item.type = 'button';
                  item.className = 'gv-group-suggestion-item';
                  item.textContent = u.username;
                  item.addEventListener('click', function () {
                    selected[u.id] = u.username;
                    renderChips();
                    suggestionsBox.classList.add('d-none');
                    searchInput.value = '';
                  });
                  suggestionsBox.appendChild(item);
                });
                if (!any) {
                  var empty = document.createElement('div');
                  empty.className = 'gv-group-suggestion-empty';
                  empty.textContent = 'Brak pasujących znajomych.';
                  suggestionsBox.appendChild(empty);
                }
                suggestionsBox.classList.remove('d-none');
              }

              if (hint) {
                searchInput.addEventListener('focus', function () {
                  hint.style.display = 'block';
                });
              }

              searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                var q = searchInput.value.trim();
                debounceTimer = setTimeout(function () {
                  fetch('/chat/friends-search?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) { renderSuggestions(data.users || []); });
                }, 200);
              });

              document.addEventListener('click', function (e) {
                if (!suggestionsBox.contains(e.target) && e.target !== searchInput) {
                  suggestionsBox.classList.add('d-none');
                }
              });
            }

            initGvMemberPicker({
              search: 'groupMemberSearch',
              suggestions: 'groupMemberSuggestions',
              chips: 'groupMemberChips',
              submitBtn: 'createGroupBtn',
              hint: 'groupMemberHint',
            });
          </script>

          </div>

        </div>

        <div class="gv-chat-main-col">
          <% if (focusedInvite) { %>
            <%# Zaproszenie otwarte z powiadomienia: wiadomo, kto zaprasza i do czego, i od razu można odpowiedzieć. %>
            <div class="gv-chat-topbar">
              <a href="/chat" class="gv-chat-back" aria-label="Wróć do listy rozmów"><i class="bi bi-arrow-left"></i></a>
              <div class="gv-chat-topbar-info"><b>Zaproszenie do grupy</b></div>
            </div>
            <div class="gv-invite-card">
              <% if (focusedInvite.photoUrl) { %>
                <img src="<%= focusedInvite.photoUrl %>" alt="" class="gv-invite-card-photo">
              <% } else { %>
                <div class="gv-invite-card-photo"></div>
              <% } %>
              <h2><%= focusedInvite.name %></h2>
              <p><b><%= focusedInvite.memberNames[focusedInvite.ownerId] || 'Właściciel' %></b> zaprasza Cię do tej grupy.</p>
              <p class="gv-invite-card-meta"><i class="bi bi-people-fill"></i> W grupie są: <%= focusedInvite.memberIds.map(function(id){ return focusedInvite.memberNames[id]; }).join(', ') %></p>
              <div class="gv-invite-card-actions">
                <form action="/chat/invites/<%= focusedInvite.id %>/accept" method="POST">
                  <button type="submit" class="gv-btn-success"><i class="bi bi-check-lg"></i> Dołącz do grupy</button>
                </form>
                <form action="/chat/invites/<%= focusedInvite.id %>/decline" method="POST">
                  <button type="submit" class="gv-btn-danger"><i class="bi bi-x-lg"></i> Odrzuć</button>
                </form>
              </div>
            </div>
          <% } else if (!active) { %>
            <div class="gv-chat-empty">Wybierz rozmowę lub grupę z listy po lewej, albo rozpocznij nową.</div>
          <% } else { %>
            <div class="gv-chat-topbar">
              <a href="/chat" class="gv-chat-back" aria-label="Wróć do listy rozmów"><i class="bi bi-arrow-left"></i></a>
              <% var topOtherId = active.type === 'dm' ? active.memberIds.find(function(id){ return id !== currentUser.id; }) : null; %>
              <% var topAvatarUrl = topOtherId ? active.memberAvatars[topOtherId] : (active.type === 'group' ? active.photoUrl : null); %>
              <% if (topAvatarUrl) { %>
                <img src="<%= topAvatarUrl %>" alt="" class="gv-c-avatar" style="object-fit:cover;">
              <% } else { %>
                <div class="gv-c-avatar"></div>
              <% } %>
              <div class="gv-chat-topbar-info">
                <b>
                  <% if (active.type === 'dm') { %>
                    <% var otherId = topOtherId; %>
                    <a href="/<%= active.memberNames[otherId] %>" class="gv-chat-name-link"><%= active.memberNames[otherId] %></a>
                  <% } else { %>
                    <button type="button" class="gv-chat-name-link gv-group-name-toggle" id="groupMembersToggle">
                      <%= active.name %>
                      <i class="bi bi-caret-down-fill gv-group-toggle-icon"></i>
                    </button>
                    <div class="gv-group-members-dropdown d-none" id="groupMembersDropdown">
                      <% active.memberIds.forEach(function(id) { %>
                        <div class="gv-group-member-item">
                          <a href="/<%= active.memberNames[id] %>"><%= active.memberNames[id] %><%= id === active.ownerId ? ' (właściciel)' : '' %></a>
                          <% if (active.ownerId === currentUser.id && id !== currentUser.id) { %>
                            <form action="/chat/<%= active.id %>/members/<%= id %>/remove" method="POST" onsubmit="return confirm('Usunąć <%= active.memberNames[id] %> z grupy?');">
                              <button type="submit" class="gv-group-member-remove" title="Usuń z grupy" aria-label="Usuń z grupy"><i class="bi bi-x-lg"></i></button>
                            </form>
                          <% } %>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </b>
                <div style="color:var(--text-lo); font-size:11.5px;" id="conversationMeta">
                  <%= active.type === 'dm' ? 'Rozmowa prywatna' : (active.memberIds.length + ' członków grupy') %>
                  <% if (active.type === 'dm' && !active.canReply) { %>
                    <span class="gv-badge gv-badge-warn" id="canReplyBadge" title="Tylko administrator może pisać w tej rozmowie">bez możliwości odpowiedzi</span>
                  <% } %>
                </div>
              </div>
              <div class="gv-chat-topbar-actions">
                <% if (active.type === 'group' && active.ownerId === currentUser.id) { %>
                  <button type="button" class="gv-chat-action-btn" title="Ustawienia grupy" aria-label="Ustawienia grupy"
                          data-bs-toggle="modal" data-bs-target="#groupSettingsModal">
                    <i class="bi bi-gear-fill"></i>
                  </button>
                <% } %>
                <% if (active.type === 'dm' && currentUser.role === 'admin') { %>
                  <button type="button" class="gv-chat-action-btn" id="toggleReplyBtn"
                          data-conversation="<%= active.id %>" data-can-reply="<%= active.canReply %>"
                          title="<%= active.canReply ? 'Wyłącz możliwość odpowiedzi' : 'Włącz możliwość odpowiedzi' %>"
                          aria-label="Przełącz możliwość odpowiedzi">
                    <i class="bi <%= active.canReply ? 'bi-chat-dots-fill' : 'bi-chat-slash-fill' %>"></i>
                  </button>
                <% } %>
                <% if (active.type === 'group') { %>
                  <form action="/chat/<%= active.id %>/leave" method="POST"
                        onsubmit="return confirm('<%= active.ownerId === currentUser.id ? 'Opuścić tę grupę? Jej właścicielem zostanie kolejny członek.' : 'Opuścić tę grupę?' %>');">
                    <button type="submit" class="gv-chat-action-btn" title="Opuść grupę" aria-label="Opuść grupę"><i class="bi bi-box-arrow-right"></i></button>
                  </form>
                <% } %>
                <% if (canDestroy) { %>
                  <form action="/chat/<%= active.id %>/clear" method="POST" onsubmit="return confirm('Wyczyścić wszystkie wiadomości w tej rozmowie?');">
                    <button type="submit" class="gv-chat-action-btn" title="Wyczyść czat" aria-label="Wyczyść czat"><i class="bi bi-eraser-fill"></i></button>
                  </form>
                  <form action="/chat/<%= active.id %>/delete" method="POST" onsubmit="return confirm('Usunąć tę rozmowę na stałe? Tej operacji nie można cofnąć.');">
                    <button type="submit" class="gv-chat-action-btn" title="Usuń czat" aria-label="Usuń czat"><i class="bi bi-trash3-fill"></i></button>
                  </form>
                <% } %>
              </div>
            </div>

            <%# Wiadomości i pole wiadomości buduje skrypt public/js/chat-page.js (wspólny kod: chat-core.js). %>
            <div class="gv-chat-body" id="chatBody" data-conversation="<%= active.id %>" data-type="<%= active.type %>"
                 data-me="<%= currentUser.id %>" data-admin="<%= currentUser.role === 'admin' %>"
                 data-can-reply="<%= active.canReply !== false %>" data-messages="<%= initialMessagesJson %>"></div>
            <div id="chatComposerHost"></div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <% if (active && active.type === 'group' && active.ownerId === currentUser.id) { %>
    <!-- MODAL: USTAWIENIA GRUPY (tylko właściciel) - nazwa, zdjęcie, członkowie, zapraszanie -->
    <div class="modal fade" id="groupSettingsModal" tabindex="-1" aria-labelledby="groupSettingsLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content gv-modal-content">
          <div class="modal-header gv-modal-header">
            <h2 class="gv-auth-title mb-0" id="groupSettingsLabel"><i class="bi bi-gear-fill"></i> Ustawienia grupy</h2>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
          </div>
          <div class="modal-body">
            <section class="gv-admin-modal-section">
              <h3><i class="bi bi-pencil-fill"></i> Nazwa grupy</h3>
              <form action="/chat/<%= active.id %>/rename" method="POST" class="d-flex gap-2">
                <input type="text" name="name" value="<%= active.name %>" class="form-control gv-input" required>
                <button type="submit" class="gv-mini-btn">Zapisz</button>
              </form>
            </section>

            <section class="gv-admin-modal-section">
              <h3><i class="bi bi-image-fill"></i> Zdjęcie grupy</h3>
              <div class="d-flex align-items-center gap-2 mb-2">
                <% if (active.photoUrl) { %>
                  <img src="<%= active.photoUrl %>" alt="" style="width:48px;height:48px;border-radius:10px;object-fit:cover;">
                <% } else { %>
                  <div class="gv-c-avatar"></div>
                <% } %>
                <% if (active.photoUrl) { %>
                  <form action="/chat/<%= active.id %>/photo/remove" method="POST">
                    <button type="submit" class="gv-mini-btn gv-mini-warn">Usuń zdjęcie</button>
                  </form>
                <% } %>
              </div>
              <form action="/chat/<%= active.id %>/photo" method="POST" enctype="multipart/form-data" class="d-flex gap-2">
                <input type="file" name="photo" accept=".png,.jpg,.jpeg,.webp,.gif" class="form-control gv-input" required>
                <button type="submit" class="gv-mini-btn">Wgraj</button>
              </form>
            </section>

            <section class="gv-admin-modal-section">
              <h3><i class="bi bi-people-fill"></i> Członkowie (<%= active.memberIds.length %>)</h3>
              <ul class="gv-admin-list">
                <% active.memberIds.forEach(function(id) { %>
                  <li>
                    <span><%= active.memberNames[id] %><%= id === active.ownerId ? ' (właściciel)' : '' %></span>
                    <% if (id !== active.ownerId) { %>
                      <span class="gv-admin-row-actions">
                        <form action="/chat/<%= active.id %>/transfer/<%= id %>" method="POST" onsubmit="return confirm('Przekazać własność grupy użytkownikowi <%= active.memberNames[id] %>? Utracisz uprawnienia właściciela.');">
                          <button type="submit" class="gv-mini-btn" title="Przekaż własność grupy"><i class="bi bi-key-fill"></i> Przekaż własność</button>
                        </form>
                        <form action="/chat/<%= active.id %>/members/<%= id %>/remove" method="POST" onsubmit="return confirm('Usunąć <%= active.memberNames[id] %> z grupy?');">
                          <button type="submit" class="gv-mini-btn gv-mini-warn">Usuń</button>
                        </form>
                      </span>
                    <% } %>
                  </li>
                <% }) %>
              </ul>
              <% if (active.pendingMemberIds.length > 0) { %>
                <p class="gv-admin-note">Oczekują na akceptację: <%= active.pendingMemberIds.map(function(id){ return active.pendingMemberNames[id]; }).join(', ') %></p>
              <% } %>
            </section>

            <section class="gv-admin-modal-section">
              <h3><i class="bi bi-person-plus-fill"></i> Zaproś więcej osób</h3>
              <p class="gv-admin-note">Możesz zapraszać tylko wzajemnych znajomych.</p>
              <form action="/chat/<%= active.id %>/invite" method="POST">
                <div class="gv-group-member-picker mb-2">
                  <input type="text" id="inviteMemberSearch" placeholder="Wpisz nick znajomego..." class="form-control gv-input" autocomplete="off">
                  <div id="inviteMemberSuggestions" class="gv-group-suggestions d-none"></div>
                </div>
                <div id="inviteMemberChips" class="gv-group-chips mb-2"></div>
                <button type="submit" class="gv-mini-btn" id="sendInviteBtn" disabled>Wyślij zaproszenia</button>
              </form>
            </section>
          </div>
        </div>
      </div>
    </div>
    <script>
      initGvMemberPicker({
        search: 'inviteMemberSearch',
        suggestions: 'inviteMemberSuggestions',
        chips: 'inviteMemberChips',
        submitBtn: 'sendInviteBtn',
      });
    </script>
  <% } %>

  <%- include('../partials/report-modal') %>
  <%- include('../partials/footer') %>

  <script src="/js/chat-page.js" defer></script>
</body>
</html>
