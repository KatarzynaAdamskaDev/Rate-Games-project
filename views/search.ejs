<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>
  <%- include('partials/flash') %>

  <section class="gv-section">
    <div class="container">
      <h1 class="gv-page-title mb-4">
        <% if (query) { %>Wyniki wyszukiwania dla "<%= query %>"<% } else { %>Szukaj<% } %>
      </h1>

      <% if (!query) { %>
        <form action="/search" method="GET" class="mb-4" style="max-width: 480px;">
          <div class="input-group">
            <input type="search" name="q" class="form-control gv-input" placeholder="Wpisz tytuł gry, kategorię lub frazę..." />
            <button type="submit" class="btn gv-btn-primary">Szukaj</button>
          </div>
        </form>
      <% } else { %>
        <h2 class="gv-section-title mb-3">Użytkownicy (<%= users.length %>)</h2>
        <% if (users.length === 0) { %>
          <p class="gv-empty-state">Brak użytkowników pasujących do zapytania.</p>
        <% } else { %>
          <div class="row g-3 mb-5">
            <% users.forEach(function(u) { %>
              <div class="col-12 col-sm-6 col-lg-4">
                <a href="/<%= u.username %>" class="gv-search-user-card d-flex align-items-center text-decoration-none">
                  <div class="gv-search-user-avatar"></div>
                  <b><%= u.username %></b>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>

        <h2 class="gv-section-title mb-3">Gry (<%= games.length %>)</h2>
        <% if (games.length === 0) { %>
          <p class="gv-empty-state">Brak gier pasujących do zapytania.</p>
        <% } else { %>
          <div class="row g-4 mb-5">
            <% games.forEach(function(game) { %>
              <div class="col-12 col-sm-6 col-lg-4">
                <%- include('partials/game-card', { game }) %>
              </div>
            <% }) %>
          </div>
        <% } %>

        <h2 class="gv-section-title mb-3">Wpisy na blogu (<%= posts.length %>)</h2>
        <% if (posts.length === 0) { %>
          <p class="gv-empty-state">Brak wpisów pasujących do zapytania.</p>
        <% } else { %>
          <div class="gv-blog-grid">
            <% posts.forEach(function(post) { %>
              <article class="gv-blog-tile">
                <a href="/blog/<%= post.id %>" class="gv-blog-tile-img" tabindex="-1" aria-hidden="true">
                  <img src="<%= post.coverImage %>" alt="" loading="lazy">
                </a>
                <div class="gv-blog-tile-body">
                  <div class="gv-blog-meta">
                    <span class="gv-blog-badge"><%= post.category %></span>
                    <span><%= new Date(post.createdAt).toLocaleDateString('pl-PL') %></span>
                  </div>
                  <h3 class="gv-blog-tile-title"><a href="/blog/<%= post.id %>"><%= post.title %></a></h3>
                  <p class="gv-blog-tile-excerpt"><%= post.excerpt %></p>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      <% } %>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
