<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/app-extra.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <section class="gv-section">
    <div class="container">
      <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
          <img src="<%= game.coverImage %>" alt="<%= game.title %>" class="gv-detail-img w-100" />
        </div>
        <div class="col-12 col-md-8">
          <span class="gv-game-card-category gv-static-badge"><%= game.category %></span>
          <h1 class="gv-page-title mt-2"><%= game.title %></h1>
          <p class="gv-detail-meta"><%= game.platform %> · <%= game.releaseYear %></p>
          <p class="gv-detail-desc"><%= game.description %></p>
          <button type="button" class="gv-mini-btn mb-3" data-share data-share-title="<%= game.title %>" data-share-url="<%= absoluteUrl('/games/' + game.id) %>">
            <i class="bi bi-share-fill"></i> <span data-share-label>Udostępnij grę</span>
          </button>

          <div class="gv-detail-rating">
            <% if (averageRating) { %>
              <%- include('../partials/star-rating', { rating: averageRating }) %>
              <span class="gv-detail-rating-value"><%= averageRating %> / 5</span>
              <span class="gv-game-card-count">(<%= reviews.length %> <%= reviews.length === 1 ? 'opinia' : ((reviews.length % 10 >= 2 && reviews.length % 10 <= 4 && !(reviews.length % 100 >= 12 && reviews.length % 100 <= 14)) ? 'opinie' : 'opinii') %>)</span>
            <% } else { %>
              <span class="gv-game-card-count">Brak opinii - bądź pierwszy!</span>
            <% } %>
          </div>
        </div>
      </div>

      <h2 class="gv-section-title mb-3">Opinie graczy</h2>

      <% if (currentUser && !myReview) { %>
        <form action="/games/<%= game.id %>/reviews" method="POST" class="gv-review-form mb-5">
          <div class="mb-3">
            <label class="gv-label d-block">Twoja ocena</label>
            <div class="gv-star-picker" role="radiogroup" aria-label="Twoja ocena (kliknij lewą połowę gwiazdki, aby dać połówkę)">
              <i class="bi bi-star" data-value="1"></i>
              <i class="bi bi-star" data-value="2"></i>
              <i class="bi bi-star" data-value="3"></i>
              <i class="bi bi-star" data-value="4"></i>
              <i class="bi bi-star" data-value="5"></i>
            </div>
            <input type="hidden" name="rating" class="gv-star-picker-input">
          </div>
          <div class="mb-3">
            <label class="gv-label d-block">Twoja opinia</label>
            <textarea name="text" rows="3" class="form-control gv-input" required></textarea>
          </div>
          <button type="submit" class="btn gv-btn-success">Dodaj opinię</button>
        </form>
      <% } else if (currentUser && myReview) { %>
        <p class="gv-empty-state mb-5">
          Masz już opinię o tej grze.
          <button type="button" class="gv-icon-btn" onclick="document.getElementById('review-<%= myReview.id %>').scrollIntoView({behavior:'smooth'}); document.getElementById('edit-form-<%= myReview.id %>').classList.remove('d-none');" style="display:inline;padding:0;text-decoration:underline;">
            Edytuj ją
          </button>, jeśli chcesz coś zmienić.
        </p>
      <% } else { %>
        <p class="gv-empty-state">
          <button type="button" class="gv-icon-btn" data-bs-toggle="modal" data-bs-target="#signInModal" style="display:inline;padding:0;">Zaloguj się</button>,
          aby dodać własną opinię o tej grze.
        </p>
      <% } %>

      <% if (reviews.length === 0) { %>
        <p class="gv-empty-state">Ta gra nie ma jeszcze żadnych opinii.</p>
      <% } else { %>
        <div class="gv-review-list">
          <% reviews.forEach(function(review) { %>
            <div class="gv-review-item" id="review-<%= review.id %>">
              <div class="gv-review-top">
                <span class="gv-review-byline">Review by:
                  <a href="/<%= review.username %>" class="gv-byline-link">
                    <% if (review.avatarUrl) { %>
                      <img src="<%= review.avatarUrl %>" alt="" class="gv-byline-avatar">
                    <% } else { %>
                      <span class="gv-byline-avatar"></span>
                    <% } %>
                    <span class="gv-byline-name"><%= review.username %></span>
                  </a>
                </span>
                <span class="gv-review-rating-badge">
                  <%- include('../partials/star-rating-solid', { rating: review.rating }) %>
                </span>
              </div>
              <div class="gv-review-meta-row">
                <p class="gv-review-text mb-0"><%= review.text %></p>
                <span class="gv-review-date">
                  <%= new Date(review.createdAt).toLocaleDateString('pl-PL') %>
                  <% if (review.editedAt) { %> · <em>edytowane</em><% } %>
                </span>
              </div>

              <div class="gv-review-actions mt-2">
                <button
                  type="button"
                  class="gv-icon-btn gv-review-like-btn <%= review.liked ? 'liked' : '' %>"
                  data-review-id="<%= review.id %>"
                  data-game-id="<%= game.id %>"
                  title="Polub"
                  <%= !currentUser ? 'disabled' : '' %>
                >
                  <i class="bi <%= review.liked ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                  <span class="gv-count"><%= review.likeCount %></span>
                </button>

                <button type="button" class="gv-icon-btn gv-comments-toggle" data-target="comments-body-<%= review.id %>" title="Komentarze">
                  <i class="bi bi-chat-dots"></i>
                  <span class="gv-count"><%= review.comments.length %></span>
                </button>

                <button type="button" class="gv-icon-btn" title="Udostępnij recenzję"
                        data-share data-share-title="Recenzja gry <%= game.title %> od <%= review.username %>"
                        data-share-url="<%= absoluteUrl('/games/' + game.id + '?review=' + review.id) %>#review-<%= review.id %>">
                  <i class="bi bi-share"></i>
                </button>

                <% if (currentUser && currentUser.id !== review.userId) { %>
                  <button type="button" class="gv-icon-btn gv-report-btn" title="Zgłoś"
                          data-bs-toggle="modal" data-bs-target="#reportModal"
                          data-report-url="/games/<%= game.id %>/reviews/<%= review.id %>/report"
                          data-report-author="<%= review.username %>">
                    <i class="bi bi-flag"></i>
                  </button>
                <% } %>

                <% if (currentUser && currentUser.id === review.userId) { %>
                  <button type="button" class="gv-icon-btn gv-edit-toggle" data-target="edit-form-<%= review.id %>" title="Edytuj">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <form action="/games/<%= game.id %>/reviews/<%= review.id %>/delete" method="POST"
                        onsubmit="return confirm('Usunąć tę opinię na stałe?');" class="d-inline">
                    <button type="submit" class="gv-icon-btn gv-delete-btn" title="Usuń"><i class="bi bi-trash"></i></button>
                  </form>
                <% } %>
              </div>

              <% if (currentUser && currentUser.id === review.userId) { %>
                <form action="/games/<%= game.id %>/reviews/<%= review.id %>/edit" method="POST"
                      class="gv-edit-review-form d-none mt-3" id="edit-form-<%= review.id %>">
                  <div class="gv-star-picker mb-2" role="radiogroup" aria-label="Twoja ocena" data-selected="<%= review.rating %>">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="bi <%= review.rating >= i ? 'bi-star-fill' : (review.rating >= i - 0.5 ? 'bi-star-half' : 'bi-star') %>" data-value="<%= i %>"></i>
                    <% } %>
                  </div>
                  <input type="hidden" name="rating" class="gv-star-picker-input" value="<%= review.rating %>">
                  <textarea name="text" rows="3" class="form-control gv-input mb-2" required><%= review.text %></textarea>
                  <button type="submit" class="btn gv-btn-success btn-sm">Zapisz zmiany</button>
                </form>
              <% } %>

              <div class="gv-comments-body d-none mt-3" id="comments-body-<%= review.id %>">
                <% review.comments.forEach(function(c) { %>
                  <div class="comment-preview gv-comment-item" id="comment-<%= c.id %>">
                    <div class="gv-comment-text">
                      <a href="/<%= c.username %>" class="gv-chat-name-link"><b><%= c.username %></b></a>
                      <span><%= c.text %></span>
                    </div>
                    <div class="gv-comment-footer">
                      <small><%= new Date(c.createdAt).toLocaleDateString('pl-PL') %></small>
                      <div class="gv-comment-actions">
                        <button
                          type="button"
                          class="gv-icon-btn gv-comment-like-btn <%= c.liked ? 'liked' : '' %>"
                          data-comment-id="<%= c.id %>"
                          data-game-id="<%= game.id %>"
                          data-review-id="<%= review.id %>"
                          title="Polub"
                          <%= !currentUser ? 'disabled' : '' %>
                        >
                          <i class="bi <%= c.liked ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                          <span class="gv-count"><%= c.likeCount %></span>
                        </button>
                        <% if (currentUser && currentUser.id !== c.userId) { %>
                          <button type="button" class="gv-icon-btn gv-report-btn" title="Zgłoś komentarz"
                                  data-bs-toggle="modal" data-bs-target="#reportModal"
                                  data-report-type="comment"
                                  data-report-url="/reports/comment/<%= c.id %>"
                                  data-report-author="<%= c.username %>">
                            <i class="bi bi-flag"></i>
                          </button>
                        <% } %>
                        <% if (currentUser && currentUser.id === c.userId) { %>
                          <form action="/games/<%= game.id %>/reviews/<%= review.id %>/comments/<%= c.id %>/delete" method="POST"
                                onsubmit="return confirm('Usunąć komentarz?');" class="d-inline">
                            <button type="submit" class="gv-icon-btn gv-delete-btn" title="Usuń komentarz">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% }) %>
                <% if (currentUser) { %>
                  <form action="/games/<%= game.id %>/reviews/<%= review.id %>/comments" method="POST" class="gv-comment-form mt-2">
                    <input type="text" name="text" placeholder="Napisz komentarz..." class="form-control gv-input" required maxlength="500">
                    <button type="submit" class="btn gv-btn-success btn-sm">Dodaj</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <% if (currentUser) { %><%- include('../partials/report-modal') %><% } %>
  <%- include('../partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function bindLikeButtons(selector, urlBuilder) {
        document.querySelectorAll(selector).forEach(function (btn) {
          btn.addEventListener('click', function () {
            if (btn.disabled) return;

            fetch(urlBuilder(btn), {
              method: 'POST',
              headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            })
              .then(function (r) { return r.json(); })
              .then(function (data) {
                btn.classList.toggle('liked', data.liked);
                var icon = btn.querySelector('i');
                icon.className = data.liked ? icon.className.replace('bi-heart', 'bi-heart-fill') : icon.className.replace('bi-heart-fill', 'bi-heart');
                btn.querySelector('.gv-count').textContent = data.likeCount;
              });
          });
        });
      }

      // Polubienia opinii
      bindLikeButtons('.gv-review-like-btn', function (btn) {
        return '/games/' + btn.dataset.gameId + '/reviews/' + btn.dataset.reviewId + '/like';
      });

      // Polubienia komentarzy
      bindLikeButtons('.gv-comment-like-btn', function (btn) {
        return '/games/' + btn.dataset.gameId + '/reviews/' + btn.dataset.reviewId + '/comments/' + btn.dataset.commentId + '/like';
      });

      // Rozwijanie komentarzy
      document.querySelectorAll('.gv-comments-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var target = document.getElementById(btn.dataset.target);
          if (target) target.classList.toggle('d-none');
        });
      });

      // Link z powiadomienia (#comment-ID albo #review-ID) ma prowadzić do tego, o czym jest powiadomienie:
      // rozwijamy komentarze recenzji, przewijamy do komentarza (albo recenzji) i na chwilę go podświetlamy.
      (function openFromHash() {
        var hash = decodeURIComponent(location.hash || '');
        var match = /^#(comment|review)-(.+)$/.exec(hash);
        if (!match) return;
        var target = document.getElementById(match[1] + '-' + match[2]);
        if (!target) return;
        var body = target.closest('.gv-comments-body') || (match[1] === 'review' ? target.querySelector('.gv-comments-body') : null);
        if (body) body.classList.remove('d-none');
        target.scrollIntoView({ block: 'center' });
        target.classList.add('gv-flash-target');
        setTimeout(function () { target.classList.remove('gv-flash-target'); }, 2600);
      })();

      // Rozwijanie formularza edycji
      document.querySelectorAll('.gv-edit-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var target = document.getElementById(btn.dataset.target);
          if (target) target.classList.toggle('d-none');
        });
      });

      // Selektor gwiazdek (ocena, z obsługą połówek 0.5) - zamiennik <select>
      document.querySelectorAll('.gv-star-picker').forEach(function (picker) {
        var input = picker.nextElementSibling;
        var stars = Array.from(picker.querySelectorAll('i'));

        function valueFromEvent(star, e) {
          var rect = star.getBoundingClientRect();
          var isLeftHalf = (e.clientX - rect.left) < rect.width / 2;
          var base = Number(star.dataset.value);
          return isLeftHalf ? base - 0.5 : base;
        }

        function paint(value) {
          stars.forEach(function (star) {
            var starValue = Number(star.dataset.value);
            star.classList.remove('bi-star', 'bi-star-fill', 'bi-star-half');
            if (value >= starValue) {
              star.classList.add('bi-star-fill');
            } else if (value >= starValue - 0.5) {
              star.classList.add('bi-star-half');
            } else {
              star.classList.add('bi-star');
            }
          });
        }

        // Podpis obok gwiazdek: aktualna ocena i podpowiedź o połówkach.
        var label = document.createElement('span');
        label.className = 'gv-star-value';
        picker.insertAdjacentElement('afterend', label);
        input.parentNode.insertBefore(label, input);

        function describe(value) {
          label.textContent = value ? value + ' / 5' : 'Kliknij gwiazdkę (lewa połowa = pół punktu)';
          label.classList.toggle('empty', !value);
        }

        stars.forEach(function (star) {
          star.addEventListener('mousemove', function (e) {
            var value = valueFromEvent(star, e);
            paint(value);
            describe(value);
          });
          star.addEventListener('click', function (e) {
            var value = valueFromEvent(star, e);
            picker.dataset.selected = value;
            input.value = value;
            paint(value);
            describe(value);
          });
        });

        picker.addEventListener('mouseleave', function () {
          var selected = Number(picker.dataset.selected || 0);
          paint(selected);
          describe(selected);
        });
        describe(Number(picker.dataset.selected || 0));
      });

      // Walidacja: nie pozwól wysłać opinii bez wybranej oceny gwiazdkowej
      document.querySelectorAll('.gv-review-form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          var input = form.querySelector('.gv-star-picker-input');
          if (input && !input.value) {
            e.preventDefault();
            alert('Wybierz ocenę przed dodaniem opinii.');
          }
        });
      });
    });
  </script>
</body>
</html>
