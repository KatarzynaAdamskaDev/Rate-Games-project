<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <section class="gv-section">
    <div class="container">
      <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
          <img src="<%= game.coverImage %>" alt="<%= game.title %>" class="gv-detail-img w-100" />
        </div>
        <div class="col-12 col-md-8">
          <span class="gv-game-card-category gv-static-badge"><%= game.category %></span>
          <h1 class="gv-page-title mt-2"><%= game.title %></h1>
          <p class="gv-detail-meta"><%= game.platform %> · <%= game.releaseYear %></p>
          <p class="gv-detail-desc"><%= game.description %></p>

          <div class="gv-detail-rating">
            <% if (averageRating) { %>
              <span class="gv-star">★</span>
              <span class="gv-detail-rating-value"><%= averageRating %> / 5</span>
              <span class="gv-game-card-count">(<%= reviews.length %> opinii)</span>
            <% } else { %>
              <span class="gv-game-card-count">Brak opinii - bądź pierwszy!</span>
            <% } %>
          </div>
        </div>
      </div>

      <h2 class="gv-section-title mb-3">Opinie graczy</h2>

      <% if (currentUser) { %>
        <form action="/games/<%= game.id %>/reviews" method="POST" class="gv-review-form mb-5">
          <div class="mb-3">
            <label class="gv-label d-block">Twoja ocena</label>
            <select name="rating" class="form-select gv-select" style="max-width: 160px;" required>
              <option value="">Wybierz...</option>
              <option value="5">★★★★★ (5)</option>
              <option value="4">★★★★ (4)</option>
              <option value="3">★★★ (3)</option>
              <option value="2">★★ (2)</option>
              <option value="1">★ (1)</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="gv-label d-block">Twoja opinia</label>
            <textarea name="text" rows="3" class="form-control gv-input" required></textarea>
          </div>
          <button type="submit" class="btn gv-btn-success">Dodaj opinię</button>
        </form>
      <% } else { %>
        <p class="gv-empty-state">
          <button type="button" class="gv-inline-link" data-bs-toggle="modal" data-bs-target="#signInModal">Zaloguj się</button>,
          aby dodać własną opinię o tej grze.
        </p>
      <% } %>

      <% if (reviews.length === 0) { %>
        <p class="gv-empty-state">Ta gra nie ma jeszcze żadnych opinii.</p>
      <% } else { %>
        <div class="gv-review-list">
          <% reviews.forEach(function(review) { %>
            <div class="gv-review-item" id="review-<%= review.id %>">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <a href="/<%= review.username %>" class="gv-chat-name-link">
                  <strong class="gv-review-author"><%= review.username %></strong>
                </a>
                <span class="gv-review-rating">★ <%= review.rating %>/5</span>
              </div>
              <p class="gv-review-text mb-1"><%= review.text %></p>
              <small class="gv-review-date">
                <%= new Date(review.createdAt).toLocaleDateString('pl-PL') %>
                <% if (review.editedAt) { %> · <em>edytowane</em><% } %>
              </small>

              <div class="gv-review-actions mt-2">
                <button
                  type="button"
                  class="action-btn <%= review.liked ? 'liked' : '' %>"
                  data-review-id="<%= review.id %>"
                  data-game-id="<%= game.id %>"
                  <%= !currentUser ? 'disabled title="Zaloguj się, aby polubić"' : '' %>
                >
                  <i class="bi <%= review.liked ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                  <span class="gv-like-count"><%= review.likeCount %></span>
                </button>

                <button type="button" class="action-btn gv-comments-toggle" data-target="comments-body-<%= review.id %>">
                  <i class="bi bi-chat-dots"></i> <%= review.comments.length %> komentarzy
                </button>

                <% if (currentUser) { %>
                  <form action="/games/<%= game.id %>/reviews/<%= review.id %>/report" method="POST"
                        onsubmit="return confirm('Zgłosić tę opinię do moderacji?');" class="d-inline">
                    <button type="submit" class="action-btn gv-report-btn"><i class="bi bi-flag"></i> Zgłoś</button>
                  </form>
                <% } %>

                <% if (currentUser && currentUser.id === review.userId) { %>
                  <button type="button" class="action-btn gv-edit-toggle" data-target="edit-form-<%= review.id %>">
                    <i class="bi bi-pencil"></i> Edytuj
                  </button>
                  <form action="/games/<%= game.id %>/reviews/<%= review.id %>/delete" method="POST"
                        onsubmit="return confirm('Usunąć tę opinię na stałe?');" class="d-inline">
                    <button type="submit" class="action-btn gv-delete-btn"><i class="bi bi-trash"></i> Usuń</button>
                  </form>
                <% } %>
              </div>

              <% if (currentUser && currentUser.id === review.userId) { %>
                <form action="/games/<%= game.id %>/reviews/<%= review.id %>/edit" method="POST"
                      class="gv-edit-review-form d-none mt-3" id="edit-form-<%= review.id %>">
                  <select name="rating" class="form-select gv-select mb-2" style="max-width:140px;">
                    <option value="5" <%= review.rating===5?'selected':'' %>>★★★★★ (5)</option>
                    <option value="4" <%= review.rating===4?'selected':'' %>>★★★★ (4)</option>
                    <option value="3" <%= review.rating===3?'selected':'' %>>★★★ (3)</option>
                    <option value="2" <%= review.rating===2?'selected':'' %>>★★ (2)</option>
                    <option value="1" <%= review.rating===1?'selected':'' %>>★ (1)</option>
                  </select>
                  <textarea name="text" rows="3" class="form-control gv-input mb-2" required><%= review.text %></textarea>
                  <button type="submit" class="btn gv-btn-success btn-sm">Zapisz zmiany</button>
                </form>
              <% } %>

              <div class="gv-comments-body d-none mt-3" id="comments-body-<%= review.id %>">
                <% review.comments.forEach(function(c) { %>
                  <div class="comment-preview gv-comment-item">
                    <div class="r-avatar"></div>
                    <div class="gv-comment-body">
                      <a href="/<%= c.username %>" class="gv-chat-name-link"><b><%= c.username %></b></a>
                      <span><%= c.text %></span>
                    </div>
                    <small><%= new Date(c.createdAt).toLocaleDateString('pl-PL') %></small>
                  </div>
                <% }) %>
                <% if (currentUser) { %>
                  <form action="/games/<%= game.id %>/reviews/<%= review.id %>/comments" method="POST" class="gv-comment-form mt-2">
                    <input type="text" name="text" placeholder="Napisz komentarz..." class="form-control gv-input" required maxlength="500">
                    <button type="submit" class="btn gv-btn-success btn-sm">Dodaj</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <%- include('../partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Polubienia (AJAX, bez przeładowania strony)
      document.querySelectorAll('.gv-review-like-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (btn.disabled) return;
          var reviewId = btn.dataset.reviewId;
          var gameId = btn.dataset.gameId;

          fetch('/games/' + gameId + '/reviews/' + reviewId + '/like', {
            method: 'POST',
            headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              btn.classList.toggle('liked', data.liked);
              btn.querySelector('.gv-like-count').textContent = data.likeCount;
            });
        });
      });

      // Rozwijanie komentarzy
      document.querySelectorAll('.gv-comments-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var target = document.getElementById(btn.dataset.target);
          if (target) target.classList.toggle('d-none');
        });
      });

      // Rozwijanie formularza edycji
      document.querySelectorAll('.gv-edit-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var target = document.getElementById(btn.dataset.target);
          if (target) target.classList.toggle('d-none');
        });
      });
    });
  </script>
</body>
</html>
