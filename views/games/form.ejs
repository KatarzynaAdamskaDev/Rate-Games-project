<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <section class="gv-auth-page">
    <div class="container d-flex justify-content-center">
      <div class="gv-auth-card gv-auth-card-wide">
        <h1 class="gv-auth-title">Dodaj grę</h1>

        <form action="/games/new" method="POST" novalidate>
          <div class="mb-3">
            <label class="gv-label">Tytuł</label>
            <input type="text" name="title" class="form-control gv-input" value="<%= formData.title || '' %>" required />
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="gv-label">Kategoria</label>
              <input type="text" name="category" class="form-control gv-input" value="<%= formData.category || '' %>" required />
            </div>
            <div class="col-md-6 mb-3">
              <label class="gv-label">Platforma</label>
              <input type="text" name="platform" class="form-control gv-input" value="<%= formData.platform || '' %>" />
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="gv-label">Rok wydania</label>
              <input type="number" name="releaseYear" class="form-control gv-input" value="<%= formData.releaseYear || '' %>" />
            </div>
            <div class="col-md-6 mb-3">
              <label class="gv-label">Ścieżka do okładki</label>
              <input type="text" name="coverImage" class="form-control gv-input" placeholder="/images/game-placeholder.svg" value="<%= formData.coverImage || '' %>" />
            </div>
          </div>
          <div class="mb-4">
            <label class="gv-label">Opis</label>
            <textarea name="description" rows="4" class="form-control gv-input" required><%= formData.description || '' %></textarea>
          </div>

          <button type="submit" class="btn gv-btn-success w-100 w-sm-auto">Dodaj grę</button>
        </form>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
