<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/app-extra.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <section class="gv-section">
    <div class="wrap">

      <div class="gv-profile-hero gv-bg-<%= profileUser.activeBackground || 'bg-default' %>" style="--hero-accent: <%= theme.accent %>; --hero-accent-2: <%= theme.accent2 %>;">
        <div class="gv-hero-identity">
          <div class="gv-profile-avatar-wrap">
            <% if (profileUser.avatarUrl) { %>
              <img src="<%= profileUser.avatarUrl %>" alt="<%= profileUser.username %>" class="gv-profile-avatar gv-frame-<%= profileUser.activeFrame || 'frame-basic' %>">
            <% } else { %>
              <div class="gv-profile-avatar gv-frame-<%= profileUser.activeFrame || 'frame-basic' %>"></div>
            <% } %>
          </div>
          <div class="gv-profile-meta">
            <h1><%= profileUser.username %></h1>
            <% if (profileUser.bio) { %>
              <div class="gv-profile-bio-wrap">
                <p class="gv-profile-bio" id="profileBio"><%= profileUser.bio %></p>
                <button type="button" class="gv-bio-more d-none" id="profileBioMore" data-bs-toggle="modal" data-bs-target="#bioModal">Zobacz więcej</button>
              </div>
            <% } %>
          </div>
        </div>

        <div class="gv-hero-xp">
          <span class="gv-level-trophy" style="color: <%= trophy.color %>;" title="<%= trophy.label %>"><i class="bi <%= trophy.icon %>"></i></span>
          <div class="gv-level-info">
            <div class="gv-level-label">POZIOM</div>
            <div class="gv-level-number"><%= progress.level %></div>
            <div class="gv-xp-track"><div class="gv-xp-fill" style="width:<%= progress.percent %>%;"></div></div>
            <div class="gv-xp-label"><%= progress.pointsInLevel %> / <%= progress.pointsInLevel + progress.pointsToNext %> PD do poziomu <%= progress.level + 1 %></div>
          </div>
        </div>

        <div class="gv-hero-footer">
          <div class="gv-profile-handle">
            Dołączył(a) <%= new Date(profileUser.createdAt).toLocaleDateString('pl-PL') %>
            · <i class="bi bi-heart-fill"></i> <%= stats.likesReceived %> polubień recenzji
          </div>
          <div class="gv-profile-stats-inline">
            <a href="?tab=reviews"><b><%= stats.reviewCount %></b><span>Recenzje</span></a>
            <a href="?tab=followers"><b><%= stats.followersCount %></b><span>Obserwujący</span></a>
            <a href="?tab=following"><b><%= stats.followingCount %></b><span>Obserwowani</span></a>
          </div>
        </div>
      </div>

      <div class="gv-profile-actions mb-4">
        <% if (isOwnProfile) { %>
          <a href="/profile/settings" class="gv-btn-outline"><i class="bi bi-pencil-square"></i> Edytuj profil</a>
          <a href="/chat" class="gv-btn-outline"><i class="bi bi-chat-dots-fill"></i> Czat i grupy</a>
        <% } else if (currentUser) { %>
          <% if (iBlocked) { %>
            <span class="gv-blocked-note"><i class="bi bi-slash-circle-fill"></i> Zablokowałeś(-aś) tego użytkownika</span>
            <form action="/profile/unblock/<%= profileUser.username %>" method="POST">
              <input type="hidden" name="returnTo" value="profile">
              <button type="submit" class="gv-btn-outline"><i class="bi bi-unlock-fill"></i> Odblokuj</button>
            </form>
          <% } else { %>
            <form action="/profile/<%= alreadyFollowing ? 'unfollow' : 'follow' %>/<%= profileUser.username %>" method="POST">
              <button type="submit" class="gv-follow-btn <%= alreadyFollowing ? 'following' : '' %>">
                <%- alreadyFollowing ? '<i class="bi bi-check-lg"></i> Obserwujesz' : '<i class="bi bi-plus-lg"></i> Obserwuj' %>
              </button>
            </form>
            <form action="/chat/start/<%= profileUser.username %>" method="POST">
              <button type="submit" class="gv-btn-outline"><i class="bi bi-chat-dots-fill"></i> Napisz wiadomość</button>
            </form>
          <% } %>
          <details class="gv-profile-more">
            <summary class="gv-btn-outline"><i class="bi bi-three-dots"></i> Więcej</summary>
            <div class="gv-profile-more-menu">
              <% if (!iBlocked) { %>
                <form action="/profile/block/<%= profileUser.username %>" method="POST" onsubmit="return confirm('Zablokować użytkownika <%= profileUser.username %>? Jego komentarze zostaną ukryte, a wasze obserwowanie usunięte.');">
                  <button type="submit"><i class="bi bi-slash-circle"></i> Zablokuj użytkownika</button>
                </form>
              <% } %>
              <button type="button" data-bs-toggle="modal" data-bs-target="#reportModal"
                      data-report-type="user"
                      data-report-url="/reports/user/<%= encodeURIComponent(profileUser.username) %>"
                      data-report-author="<%= profileUser.username %>">
                <i class="bi bi-flag"></i> Zgłoś użytkownika
              </button>
            </div>
          </details>
        <% } else { %>
          <p class="gv-empty-state" style="margin:0;">
            <button type="button" class="gv-inline-link" data-bs-toggle="modal" data-bs-target="#signInModal">Zaloguj się</button>,
            aby obserwować tego gracza i napisać do niego wiadomość.
          </p>
        <% } %>
      </div>

      <div class="gv-tabs">
        <a href="?tab=favorites" class="gv-tab <%= tab === 'favorites' ? 'active' : '' %>"><i class="bi bi-star-fill"></i> Ulubione gry</a>
        <a href="?tab=reviews" class="gv-tab <%= tab === 'reviews' ? 'active' : '' %>"><i class="bi bi-journal-text"></i> Recenzje</a>
        <a href="?tab=followers" class="gv-tab <%= tab === 'followers' ? 'active' : '' %>"><i class="bi bi-people-fill"></i> Obserwujący</a>
        <a href="?tab=following" class="gv-tab <%= tab === 'following' ? 'active' : '' %>"><i class="bi bi-person-check-fill"></i> Obserwowani</a>
      </div>

      <% if (tab === 'favorites') { %>
        <div class="gv-fav-head">
          <h3 class="gv-unlock-group-title" style="margin:0;">Ulubione gry</h3>
          <span class="gv-fav-count"><%= favorites.length %> / <%= maxFavorites %></span>
        </div>

        <% if (!isOwnProfile && favorites.length === 0) { %>
          <p class="gv-empty-state">Ten gracz nie wybrał jeszcze ulubionych gier.</p>
        <% } else { %>
          <div class="gv-fav-grid">
            <% favorites.forEach(function(fav) { %>
              <div class="gv-fav-card">
                <a href="/games/<%= fav.gameId %>" class="gv-fav-cover" title="<%= fav.title %>">
                  <img src="<%= fav.coverImage || '/images/game-placeholder.svg' %>" alt="<%= fav.title %>">
                  <span class="gv-fav-title"><%= fav.title %></span>
                </a>
                <% if (isOwnProfile) { %>
                  <form action="/profile/favorites/<%= encodeURIComponent(fav.gameId) %>/delete" method="POST" onsubmit="return confirm('Usunąć tę grę z ulubionych?');">
                    <button type="submit" class="gv-fav-remove" title="Usuń z ulubionych" aria-label="Usuń z ulubionych"><i class="bi bi-x-lg"></i></button>
                  </form>
                <% } %>
              </div>
            <% }) %>
            <% if (isOwnProfile) { %>
              <% for (var slot = favorites.length; slot < maxFavorites; slot++) { %>
                <button type="button" class="gv-fav-empty" data-bs-toggle="modal" data-bs-target="#addFavoriteModal">
                  <i class="bi bi-plus-lg"></i><span>Dodaj grę</span>
                </button>
              <% } %>
            <% } %>
          </div>
        <% } %>
      <% } %>

      <% if (tab === 'followers' || tab === 'following') { %>
        <% if (followList.length === 0) { %>
          <p class="gv-empty-state"><%= tab === 'followers' ? 'Nikt jeszcze nie obserwuje tego profilu.' : 'Ten profil nikogo jeszcze nie obserwuje.' %></p>
        <% } else { %>
          <div class="gv-people-grid">
            <% followList.forEach(function(person) { %>
              <a href="/<%= encodeURIComponent(person.username) %>" class="gv-person-card">
                <% if (person.avatarUrl) { %>
                  <img src="<%= person.avatarUrl %>" alt="" class="gv-person-avatar">
                <% } else { %>
                  <div class="gv-person-avatar"></div>
                <% } %>
                <div>
                  <b><%= person.username %></b>
                  <span>POZ. <%= person.level %></span>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      <% } %>

      <% if (tab === 'reviews') { %>
        <% if (reviews.length === 0) { %>
          <p class="gv-empty-state">Brak recenzji.</p>
        <% } else { %>
          <div class="gv-rcard-list">
            <% reviews.forEach(function(review) { %>
              <%- include('../partials/review-card', { review }) %>
            <% }) %>
          </div>
        <% } %>
      <% } %>

    </div>
  </section>

  <% if (isOwnProfile) { %>
    <!-- MODAL: DODAJ ULUBIONĄ GRĘ -->
    <div class="modal fade" id="addFavoriteModal" tabindex="-1" aria-labelledby="addFavoriteLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content gv-modal-content">
          <div class="modal-header gv-modal-header">
            <h2 class="gv-auth-title mb-0" id="addFavoriteLabel">Dodaj ulubioną grę</h2>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
          </div>
          <form action="/profile/favorites" method="POST">
            <div class="modal-body">
              <label class="gv-label d-block" for="favoriteSearch">Wyszukaj grę (wybierz z listy, żeby ją dodać)</label>
              <div class="gv-game-picker" data-game-picker data-mode="submit">
                <input type="search" id="favoriteSearch" class="form-control gv-input" placeholder="Wpisz tytuł gry..." autocomplete="off" maxlength="100">
                <input type="hidden" name="gameId">
                <div class="gv-picker-results"></div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <% if (currentUser && !isOwnProfile) { %><%- include('../partials/report-modal') %><% } %>

  <% if (profileUser.bio) { %>
    <div class="modal fade" id="bioModal" tabindex="-1" aria-labelledby="bioModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content gv-modal-content">
          <div class="modal-header gv-modal-header">
            <h2 class="gv-auth-title mb-0" id="bioModalLabel"><i class="bi bi-card-text"></i> Opis - <%= profileUser.username %></h2>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
          </div>
          <div class="modal-body">
            <p class="gv-bio-full"><%= profileUser.bio %></p>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <%- include('../partials/footer') %>
  <script src="/js/game-picker.js"></script>
  <script src="/js/profile-bio.js"></script>
  <script src="/js/review-actions.js"></script>
</body>
</html>
