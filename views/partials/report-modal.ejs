<%
// Okno zgłoszenia: dokładnie jeden powód + opcjonalny dopisek. Jedno okno obsługuje wszystkie rodzaje
// zgłoszeń na stronie: przycisk otwierający podaje adres wysyłki (data-report-url), rodzaj (data-report-type:
// review | comment | user | message; domyślnie review) i autora (data-report-author).
// Dane: reportReasonSets (utils/reportReasons.js) i reportCommentMax.
const __sets = locals.reportReasonSets || {};
const __titles = { review: 'Zgłoś opinię', comment: 'Zgłoś komentarz', user: 'Zgłoś użytkownika', message: 'Zgłoś wiadomość' };
%>
<div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content gv-modal-content">
      <form method="POST" action="" id="reportForm">
        <div class="modal-header gv-modal-header">
          <h2 class="gv-auth-title mb-0" id="reportModalLabel"><i class="bi bi-flag-fill"></i> <span id="reportTitle">Zgłoś opinię</span></h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>
        <div class="modal-body">
          <p class="gv-auth-subtext" id="reportIntro">Wybierz jeden powód, który najlepiej opisuje problem.</p>

          <% Object.keys(__sets).forEach(function(type) { %>
            <div class="gv-reason-list d-none" data-type="<%= type %>" role="radiogroup" aria-label="Powód zgłoszenia">
              <% __sets[type].forEach(function(reason) { %>
                <label class="gv-reason">
                  <input type="radio" name="reason" value="<%= reason.id %>" disabled>
                  <span><%= reason.label %></span>
                </label>
              <% }) %>
            </div>
          <% }) %>

          <label class="gv-label mt-3" for="reportComment">Dopisek dla moderatora <span class="gv-muted" id="reportCommentHint">(opcjonalnie)</span></label>
          <textarea id="reportComment" name="comment" rows="3" maxlength="<%= locals.reportCommentMax || 300 %>" class="form-control gv-input" placeholder="Możesz opisać, co jest nie tak..."></textarea>
        </div>
        <div class="modal-footer gv-modal-footer">
          <button type="button" class="btn gv-btn-ghost" data-bs-dismiss="modal">Anuluj</button>
          <button type="submit" class="btn gv-btn-success">Wyślij zgłoszenie</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('reportModal');
    if (!modal) return;
    var form = document.getElementById('reportForm');
    var intro = document.getElementById('reportIntro');
    var title = document.getElementById('reportTitle');
    var comment = document.getElementById('reportComment');
    var hint = document.getElementById('reportCommentHint');
    var titles = <%- JSON.stringify(__titles) %>;
    var subjects = { review: 'opinię użytkownika', comment: 'komentarz użytkownika', user: 'użytkownika', message: 'wiadomość od' };

    modal.addEventListener('show.bs.modal', function (event) {
      var trigger = event.relatedTarget;
      var type = (trigger && trigger.getAttribute('data-report-type')) || 'review';
      var author = trigger ? trigger.getAttribute('data-report-author') : '';
      form.reset();
      form.action = trigger ? trigger.getAttribute('data-report-url') : '';

      // Widoczna jest tylko lista powodów dla danego rodzaju zgłoszenia (pozostałe są wyłączone z formularza).
      modal.querySelectorAll('.gv-reason-list').forEach(function (list) {
        var active = list.getAttribute('data-type') === type;
        list.classList.toggle('d-none', !active);
        list.querySelectorAll('input').forEach(function (input) {
          input.disabled = !active;
          input.required = active;
        });
      });

      title.textContent = titles[type] || titles.review;
      intro.textContent = author
        ? 'Zgłaszasz ' + (subjects[type] || subjects.review) + ' ' + author + '. Wybierz jeden powód.'
        : 'Wybierz jeden powód, który najlepiej opisuje problem.';
      comment.required = false;
      comment.minLength = 0;
      hint.textContent = '(opcjonalnie)';
    });

    // Przy powodzie "Inny" opis jest obowiązkowy.
    form.addEventListener('change', function (event) {
      if (event.target.name !== 'reason') return;
      var isOther = event.target.value === 'other';
      comment.required = isOther;
      comment.minLength = isOther ? 5 : 0;
      hint.textContent = isOther ? '(wymagany)' : '(opcjonalnie)';
    });
  });
</script>
