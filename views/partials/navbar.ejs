<nav class="gv-navbar" id="gvNavbar">
  <div class="container gv-navbar-inner">
    <a class="gv-brand" href="/">
      <span class="gv-brand-icon"><img src="/images/Game2.png" alt="GameVerse"></span>
      <span class="gv-brand-text">GameVerse</span>
    </a>

    <button
      class="gv-nav-toggler d-lg-none"
      type="button"
      id="gvMobileToggle"
      aria-label="Przełącz nawigację"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>

    <div class="gv-nav-right" id="gvNavRight">
      <ul class="gv-nav-links" id="gvNavLinks">
        <li>
          <a class="gv-nav-item <%= currentPath.startsWith('/games') ? 'active' : '' %>" href="/games">
            <span class="gv-nav-text">GAMES</span>
            <i class="bi bi-controller gv-nav-icon"></i>
          </a>
        </li>
        <li>
          <a class="gv-nav-item <%= currentPath.startsWith('/category') ? 'active' : '' %>" href="/category">
            <span class="gv-nav-text">CATEGORY</span>
            <i class="bi bi-tags gv-nav-icon"></i>
          </a>
        </li>
        <li>
          <a class="gv-nav-item <%= currentPath.startsWith('/blog') ? 'active' : '' %>" href="/blog">
            <span class="gv-nav-text">BLOG</span>
            <i class="bi bi-window gv-nav-icon"></i>
          </a>
        </li>

        <% if (currentUser) { %>
          <li class="dropdown">
            <button
              class="gv-nav-item dropdown-toggle"
              type="button"
              id="userMenu"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <span class="gv-nav-text"><%= currentUser.username %></span>
              <i class="bi bi-person-circle gv-nav-icon"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end gv-dropdown" aria-labelledby="userMenu">
              <% if (currentUser.role === 'admin') { %>
                <li><a class="dropdown-item" href="/games/new">Dodaj grę</a></li>
                <li><a class="dropdown-item" href="/blog/new">Nowy wpis na blogu</a></li>
                <li><hr class="dropdown-divider" /></li>
              <% } %>
              <li>
                <form action="/auth/logout" method="POST" class="m-0">
                  <button type="submit" class="dropdown-item">Wyloguj się</button>
                </form>
              </li>
            </ul>
          </li>
        <% } else { %>
          <li>
            <button
              type="button"
              class="gv-nav-item gv-nav-button"
              data-bs-toggle="modal"
              data-bs-target="#signInModal"
            >
              <span class="gv-nav-text">SIGN IN</span>
              <i class="bi bi-person gv-nav-icon"></i>
            </button>
          </li>
        <% } %>
      </ul>

      <form action="/search" method="GET" class="gv-search-bar" id="gvSearchBar">
        <input
          type="search"
          name="q"
          id="gvSearchInput"
          class="gv-search-input"
          placeholder="Szukaj gier, kategorii, wpisów..."
          autocomplete="off"
        />
      </form>

      <button type="button" class="gv-search-icon-btn" id="gvSearchToggle" aria-label="Szukaj">
        <i class="bi bi-search gv-search-icon-glyph"></i>
        <i class="bi bi-x-lg gv-search-icon-glyph gv-search-close-glyph"></i>
      </button>
    </div>
  </div>
</nav>
