<% if ((success && success.length) || (error && error.length)) { %>
<script>
  (function () {
    function fire() {
      <% if (success && success.length) { %>
        <% success.forEach(function(msg) { %>
          showToast(<%- JSON.stringify(msg) %>, true);
        <% }) %>
      <% } %>
      <% if (error && error.length) { %>
        <% error.forEach(function(msg) { %>
          showToast(<%- JSON.stringify(msg) %>, false);
        <% }) %>
      <% } %>
    }

    if (typeof showToast === 'function') {
      fire();
    } else {
      // main.js mógł się jeszcze nie wykonać - spróbuj po załadowaniu DOM.
      document.addEventListener('DOMContentLoaded', fire);
    }
  })();
</script>
<% } %>
