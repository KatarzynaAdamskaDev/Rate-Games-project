<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <section class="gv-section">
    <div class="container">
      <div class="gv-auth-card-wrap">
        <div class="gv-auth-card">

          <% if (!valid) { %>

            <h1 class="gv-auth-title mb-3">Nieprawidłowy link</h1>
            <p class="gv-auth-subtext mb-4">
              Ten link do resetowania hasła jest nieprawidłowy albo już wygasł — linki są ważne przez 15 minut.
              Poproś o nowy, korzystając z opcji „Forgot password?” w oknie logowania.
            </p>
            <a href="/" class="btn gv-btn-success w-100 w-sm-auto d-inline-block text-center">
              Wróć do strony głównej
            </a>

          <% } else { %>

            <div id="newPasswordSuccess" class="d-none">
              <h1 class="gv-auth-title mb-3">Hasło zostało zmienione</h1>
              <p class="gv-auth-subtext mb-4">Możesz się teraz zalogować, używając nowego hasła.</p>
              <button
                type="button"
                class="btn gv-btn-success w-100 w-sm-auto"
                data-bs-toggle="modal"
                data-bs-target="#signInModal"
              >
                Zaloguj się teraz
              </button>
            </div>

            <div id="newPasswordFormWrap">
              <h1 class="gv-auth-title mb-3">Ustaw nowe hasło</h1>
              <p class="gv-auth-subtext mb-4">Wpisz nowe hasło do swojego konta GameVerse.</p>

              <form id="newPasswordForm" novalidate>
                <input type="hidden" name="token" value="<%= token %>" />

                <div class="mb-3">
                  <label for="newPassword" class="gv-label">Nowe hasło</label>
                  <input
                    type="password"
                    id="newPassword"
                    name="password"
                    class="form-control gv-input"
                    minlength="8"
                    required
                  />
                </div>

                <div class="mb-4">
                  <label for="newPassword2" class="gv-label">Potwierdź nowe hasło</label>
                  <input
                    type="password"
                    id="newPassword2"
                    name="password2"
                    class="form-control gv-input"
                    minlength="8"
                    required
                  />
                </div>

                <button type="submit" class="btn gv-btn-success w-100 w-sm-auto">Zmień hasło</button>
              </form>
            </div>

          <% } %>

        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var form = document.getElementById('newPasswordForm');
      if (!form) return;

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var pass1 = document.getElementById('newPassword').value;
        var pass2 = document.getElementById('newPassword2').value;

        if (pass1 !== pass2) {
          if (typeof showToast === 'function') {
            showToast('Podane hasła nie są identyczne.', false);
          }
          return;
        }
        if (pass1.length < 8) {
          if (typeof showToast === 'function') {
            showToast('Hasło musi mieć co najmniej 8 znaków.', false);
          }
          return;
        }

        var formData = new URLSearchParams(new FormData(form));

        fetch(window.location.pathname, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: formData.toString(),
        })
          .then(function (res) {
            return res.json().then(function (data) {
              return { ok: res.ok, data: data };
            });
          })
          .then(function (result) {
            if (result.ok && result.data.success) {
              if (typeof showToast === 'function') {
                showToast(result.data.message || 'Hasło zostało zmienione.', true);
              }
              document.getElementById('newPasswordFormWrap').classList.add('d-none');
              document.getElementById('newPasswordSuccess').classList.remove('d-none');
            } else {
              if (typeof showToast === 'function') {
                showToast(result.data.message || 'Nie udało się zmienić hasła.', false);
              }
            }
          })
          .catch(function () {
            if (typeof showToast === 'function') {
              showToast('Wystąpił błąd połączenia. Spróbuj ponownie.', false);
            }
          });
      });
    });
  </script>
</body>
</html>
