<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <section class="gv-auth-page">
    <div class="container d-flex justify-content-center">
      <div class="gv-auth-card">
        <h1 class="gv-auth-title">Reset Password</h1>
        <p class="gv-auth-desc">
          Enter your email below, and we'll send you a message with your
          username and a link to reset your password.
        </p>

        <form action="/auth/reset-password" method="POST" novalidate>
          <div class="mb-4">
            <label for="email" class="gv-label">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-control gv-input"
              required
            />
          </div>

          <button type="submit" class="btn gv-btn-success w-100 w-sm-auto">send request</button>
        </form>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
