<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/app-extra.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <%
    const isAdmin = currentUser && currentUser.role === 'admin';
    const fmtDate = function(iso) { return new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' }); };
  %>

  <section class="gv-section">
    <div class="wrap gv-post-wrap">
      <a href="/blog" class="gv-post-back"><i class="bi bi-arrow-left"></i> Wszystkie wpisy</a>

      <article class="gv-post">
        <header class="gv-post-head">
          <div class="gv-blog-meta">
            <a href="/blog?category=<%= encodeURIComponent(post.category) %>" class="gv-blog-badge"><%= post.category %></a>
            <span><%= fmtDate(post.createdAt) %></span>
            <% if (post.updatedAt) { %><span>· edytowano <%= fmtDate(post.updatedAt) %></span><% } %>
          </div>
          <h1 class="gv-post-title"><%= post.title %></h1>
          <div class="gv-blog-foot">
            <span><i class="bi bi-person-fill"></i> <%= post.author %></span>
            <span><i class="bi bi-clock"></i> <%= post.readMinutes %> min czytania</span>
          </div>

          <% if (isAdmin) { %>
            <div class="gv-post-admin">
              <a href="/blog/<%= post.id %>/edit" class="gv-mini-btn"><i class="bi bi-pencil-fill"></i> Edytuj wpis</a>
              <form method="POST" action="/blog/<%= post.id %>/delete" onsubmit="return confirm('Usunąć ten wpis?');">
                <button type="submit" class="gv-mini-btn gv-mini-danger"><i class="bi bi-trash3-fill"></i> Usuń</button>
              </form>
            </div>
          <% } %>
        </header>

        <div class="gv-post-cover"><img src="<%= post.coverImage %>" alt="<%= post.title %>"></div>

        <div class="gv-post-body"><%- contentHtml %></div>
      </article>

      <% if (newer || older) { %>
        <nav class="gv-post-nav" aria-label="Sąsiednie wpisy">
          <% if (older) { %>
            <a href="/blog/<%= older.id %>" class="gv-post-nav-item">
              <small><i class="bi bi-arrow-left"></i> Starszy wpis</small>
              <b><%= older.title %></b>
            </a>
          <% } else { %><span></span><% } %>
          <% if (newer) { %>
            <a href="/blog/<%= newer.id %>" class="gv-post-nav-item gv-post-nav-next">
              <small>Nowszy wpis <i class="bi bi-arrow-right"></i></small>
              <b><%= newer.title %></b>
            </a>
          <% } %>
        </nav>
      <% } %>

      <% if (related.length > 0) { %>
        <section class="gv-post-related">
          <h2>Czytaj też</h2>
          <div class="gv-blog-grid gv-blog-grid-small">
            <% related.forEach(function(item) { %>
              <article class="gv-blog-tile">
                <a href="/blog/<%= item.id %>" class="gv-blog-tile-img" tabindex="-1" aria-hidden="true">
                  <img src="<%= item.coverImage %>" alt="" loading="lazy">
                </a>
                <div class="gv-blog-tile-body">
                  <div class="gv-blog-meta">
                    <span class="gv-blog-badge"><%= item.category %></span>
                    <span><%= fmtDate(item.createdAt) %></span>
                  </div>
                  <h3 class="gv-blog-tile-title"><a href="/blog/<%= item.id %>"><%= item.title %></a></h3>
                </div>
              </article>
            <% }) %>
          </div>
        </section>
      <% } %>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
