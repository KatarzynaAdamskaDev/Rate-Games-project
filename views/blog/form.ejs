  <div class="modal fade" id="writerModal" tabindex="-1" aria-labelledby="writerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content gv-modal-content">
        <div class="modal-header gv-modal-header">
          <h2 class="gv-auth-title mb-0" id="writerModalLabel"><i class="bi bi-stars"></i> Pomocnik pisania</h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>
        <div class="modal-body">

          <div id="writerPaneForm">
            <p class="gv-writer-mode <%= writerOptions.enabled ? 'ai' : '' %>">
              <% if (writerOptions.enabled) { %>
                <i class="bi bi-stars"></i> Tryb AI: artykuł napisze Claude na podstawie Twojego zadania i danych z katalogu gier.
              <% } else { %>
                <i class="bi bi-list-check"></i> Tryb bez AI: dostaniesz szkielet artykułu pod SEO z danymi z katalogu i miejscami do uzupełnienia. Pełny tekst wygeneruje AI po ustawieniu <code>ANTHROPIC_API_KEY</code> na serwerze.
              <% } %>
            </p>

            <label class="gv-label" for="writerTopic">O czym ma być artykuł?</label>
            <input type="text" id="writerTopic" class="form-control gv-input" maxlength="200" placeholder="np. Poradnik dla początkujących do Elden Ring" autocomplete="off">

            <span class="gv-label mt-3 d-block">Rodzaj artykułu</span>
            <div class="gv-chip-check-row" role="radiogroup" aria-label="Rodzaj artykułu">
              <% writerOptions.types.forEach(function(item, i) { %>
                <label class="gv-chip-check">
                  <input type="radio" name="writerType" value="<%= item.key %>" <%= i === 0 ? 'checked' : '' %>>
                  <span><%= item.label %></span>
                </label>
              <% }) %>
            </div>

            <label class="gv-label mt-3" for="writerPoints">Co ma zawierać? <span class="gv-muted">(jeden punkt w linii - z nich powstaną śródtytuły)</span></label>
            <textarea id="writerPoints" class="form-control gv-input" rows="4" maxlength="1800" placeholder="wymagania sprzętowe&#10;najlepsze klasy na start&#10;najczęstsze błędy początkujących"></textarea>

            <label class="gv-label mt-3" for="writerGameSearch">Gry z katalogu, o których piszesz <span class="gv-muted">(opcjonalnie, do 5)</span></label>
            <input type="search" id="writerGameSearch" class="form-control gv-input" placeholder="Wpisz tytuł gry..." autocomplete="off">
            <ul class="gv-gamepick" id="writerGameList"></ul>
            <div class="gv-writer-games" id="writerGames"></div>
            <div class="gv-edit-hint">Dane wybranych gier (platformy, rok, gatunek, oceny graczy) trafią do artykułu jako sprawdzone fakty, a w tekście pojawią się linki i karty tych gier.</div>

            <div class="gv-writer-row mt-3">
              <div>
                <label class="gv-label" for="writerKeyword">Główna fraza kluczowa <span class="gv-muted">(opcjonalnie)</span></label>
                <input type="text" id="writerKeyword" class="form-control gv-input" maxlength="60" placeholder="dobierzemy z tematu" autocomplete="off">
              </div>
              <div>
                <label class="gv-label" for="writerTone">Ton</label>
                <select id="writerTone" class="form-select gv-input">
                  <% writerOptions.tones.forEach(function(item) { %><option value="<%= item.key %>"><%= item.label %></option><% }) %>
                </select>
              </div>
              <div>
                <label class="gv-label" for="writerLength">Długość</label>
                <select id="writerLength" class="form-select gv-input">
                  <% writerOptions.lengths.forEach(function(item) { %><option value="<%= item.key %>" <%= item.key === 'medium' ? 'selected' : '' %>><%= item.label %></option><% }) %>
                </select>
              </div>
            </div>

            <label class="gv-chip-check mt-3">
              <input type="checkbox" id="writerFaq" checked>
              <span>Dodaj sekcję „Najczęściej zadawane pytania” (dobra dla wyszukiwarek i asystentów AI)</span>
            </label>

            <span class="gv-label mt-3 d-block">Zdjęcia, film i fakty</span>
            <div class="gv-chip-check-row" role="group" aria-label="Dodatki do artykułu">
              <label class="gv-chip-check"><input type="checkbox" id="writerImages" checked><span><i class="bi bi-image"></i> Zdjęcia na wolnych licencjach</span></label>
              <label class="gv-chip-check"><input type="checkbox" id="writerVideo" checked><span><i class="bi bi-youtube"></i> Film z YouTube</span></label>
              <label class="gv-chip-check"><input type="checkbox" id="writerResearch" <%= writerOptions.enabled && writerOptions.webSearch ? 'checked' : 'disabled' %>><span><i class="bi bi-search"></i> Sprawdź fakty w internecie</span></label>
              <label class="gv-chip-check"><input type="checkbox" id="writerScreens"><span><i class="bi bi-controller"></i> Zrzuty ekranu z IGDB</span></label>
            </div>
            <div class="gv-edit-hint">Zdjęcia pochodzą z Wikimedia Commons i Openverse (CC0, domena publiczna, CC BY, CC BY-SA) - autor i licencja trafiają do podpisu i sekcji „Źródła zdjęć”. Film to osadzony odtwarzacz YouTube (zwiastun gry z IGDB). Zrzuty ekranu z IGDB to materiały wydawców, a nie wolna licencja - włączaj je tylko przy omawianiu gier, z podaniem źródła. Sprawdzanie faktów w internecie działa w trybie AI.</div>

            <div class="gv-media-error d-none" id="writerError" role="alert"></div>
            <div class="gv-writer-progress d-none" id="writerProgress" role="status" aria-live="polite">
              <p><i class="bi bi-stars"></i> Przygotowuję artykuł - to może potrwać kilka minut. Nie zamykaj tego okna.</p>
              <ul class="gv-writer-steps" id="writerSteps"></ul>
            </div>
          </div>

          <div id="writerPaneResult" class="d-none">
            <div class="gv-writer-meta">
              <span class="gv-writer-badge" id="writerBadge"></span>
              <span id="writerWords"></span>
              <span class="gv-writer-score" id="writerScore"></span>
            </div>
            <ul class="gv-writer-notes" id="writerNotes"></ul>
            <div class="gv-writer-mediainfo d-none" id="writerMediaInfo"></div>

            <label class="gv-label" for="writerResTitle">Tytuł</label>
            <input type="text" id="writerResTitle" class="form-control gv-input" maxlength="<%= maxTitle %>" autocomplete="off">
            <label class="gv-label mt-3" for="writerResExcerpt">Krótki opis (do wyszukiwarek i podglądów linków)</label>
            <textarea id="writerResExcerpt" class="form-control gv-input" rows="2" maxlength="<%= maxExcerpt %>"></textarea>
            <div class="gv-writer-tags" id="writerResTags" aria-label="Proponowane tagi"></div>

            <div class="gv-blogedit-tabs my-3" role="tablist">
              <button type="button" class="active" data-writer-tab="preview"><i class="bi bi-eye"></i> Podgląd</button>
              <button type="button" data-writer-tab="text"><i class="bi bi-pencil"></i> Edytuj tekst</button>
            </div>
            <div class="gv-post-body gv-writer-preview" id="writerResPreview"></div>
            <textarea id="writerResContent" class="form-control gv-input gv-blogedit-textarea d-none" rows="16" maxlength="<%= maxContent %>"></textarea>

            <label class="gv-chip-check mt-3">
              <input type="checkbox" id="writerApplyMeta" checked>
              <span>Ustaw też tytuł, krótki opis, tagi i kategorię wpisu</span>
            </label>
          </div>
        </div>
        <div class="modal-footer gv-modal-footer">
          <button type="button" class="btn gv-btn-ghost" data-bs-dismiss="modal">Anuluj</button>
          <button type="button" class="btn gv-btn-ghost d-none" id="writerBack"><i class="bi bi-arrow-left"></i> Zmień zadanie</button>
          <button type="button" class="btn gv-btn-success" id="writerGenerate"><i class="bi bi-stars"></i> Wygeneruj artykuł</button>
          <button type="button" class="btn gv-btn-ghost d-none" id="writerRegenerate"><i class="bi bi-arrow-repeat"></i> Wygeneruj ponownie</button>
          <button type="button" class="btn gv-btn-ghost d-none" id="writerAppend"><i class="bi bi-box-arrow-in-down"></i> Dopisz na końcu</button>
          <button type="button" class="btn gv-btn-success d-none" id="writerInsert"><i class="bi bi-check-lg"></i> Wstaw do edytora</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var form = document.getElementById('blogForm');
      var $ = function (id) { return document.getElementById(id); };
      var title = $('blogTitle');
      var content = $('blogContent');
      var excerpt = $('blogExcerpt');
      var maxTags = parseInt(form.dataset.maxTags, 10) || 8;
      var maxTagLength = parseInt(form.dataset.maxTagLength, 10) || 24;
      var dirty = false;
      var submitting = false;
      var coverPresent = false;

      function pad(n) { return String(n).padStart(2, '0'); }
      function toLocalValue(date) {
        return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()) + 'T' + pad(date.getHours()) + ':' + pad(date.getMinutes());
      }
      // Zwykły tekst z Markdownu: bez zdjęć, filmów, kart gier i znaczników formatowania.
      function plainText(text) {
        return String(text || '')
          .replace(/^\s*(?:!\[[^\]]*\]\([^)]*\)(?:\{[a-z]+\})?|@\[youtube\]\([^)]*\)|\[\[game:[^\]]*\]\]|-{3,})\s*$/gm, ' ')
          .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
          .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
          .replace(/^\s*>\s*\[![A-Z]+\]\s*/gm, '')
          .replace(/^\s*(?:#{1,6}|>|[-*]|\d+\.)\s+/gm, '')
          .replace(/[*_`]+/g, '')
          .replace(/\s+/g, ' ')
          .trim();
      }
      function plain(text, max) {
        var clean = plainText(text);
        if (clean.length <= max) return clean;
        var cut = clean.slice(0, max - 1);
        var space = cut.lastIndexOf(' ');
        return (space > max * 0.6 ? cut.slice(0, space) : cut).replace(/[\s,.;:!-]+$/, '') + '…';
      }
      // Krótki opis z pełnych zdań (do ok. 140 znaków) - krótszy niż sztywne obcięcie tekstu.
      function excerptFrom(text) {
        var clean = plainText(text);
        var max = 140;
        if (clean.length <= max) return clean;
        var sentences = clean.split(/(?<=[.!?…])\s+(?=[\p{Lu}"„(\d])/u);
        var result = '';
        for (var i = 0; i < sentences.length; i += 1) {
          var next = result ? result + ' ' + sentences[i] : sentences[i];
          if (next.length > max) break;
          result = next;
        }
        return result.length >= 60 ? result : plain(clean, max);
      }
      function words(text) { return (String(text).match(/\S+/g) || []).length; }
      function selectedCategory() {
        var checked = form.querySelector('input[name="category"]:checked');
        return checked ? checked.value : '';
      }
      function mode() {
        var checked = form.querySelector('input[name="publishMode"]:checked');
        return checked ? checked.value : 'now';
      }

      /* ---------------------------- tagi (chipy) ---------------------------- */
      var tagsValue = $('tagsValue');
      var tagInput = $('tagInput');
      var tagChips = $('tagChips');
      var tags = [];

      function readTags(text) {
        return String(text || '').split(/[,;\n]+/).map(cleanTag).filter(Boolean);
      }
      function cleanTag(raw) {
        return String(raw).replace(/^#+/, '').replace(/\s+/g, ' ').trim().slice(0, maxTagLength);
      }
      function hasTag(tag) {
        return tags.some(function (t) { return t.toLowerCase() === tag.toLowerCase(); });
      }
      function renderTags() {
        tagChips.innerHTML = '';
        tags.forEach(function (tag) {
          var chip = document.createElement('span');
          chip.className = 'gv-taginput-chip';
          chip.appendChild(document.createTextNode('#' + tag));
          var remove = document.createElement('button');
          remove.type = 'button';
          remove.setAttribute('aria-label', 'Usuń tag ' + tag);
          remove.innerHTML = '<i class="bi bi-x"></i>';
          remove.addEventListener('click', function () {
            tags = tags.filter(function (t) { return t !== tag; });
            renderTags();
            touched();
          });
          chip.appendChild(remove);
          tagChips.appendChild(chip);
        });
        tagsValue.value = tags.join(', ');
        $('tagCount').textContent = tags.length + '/' + maxTags;
        $('tagCount').classList.toggle('full', tags.length >= maxTags);
        tagInput.disabled = tags.length >= maxTags;
        tagInput.placeholder = tags.length >= maxTags ? 'Limit tagów' : 'Dodaj tag i Enter';
        // Podpowiedzi (popularne tagi bloga oraz propozycje z treści) znikają, gdy tag jest już dodany.
        [['#tagSuggest', $('tagSuggest')], ['#tagAutoList', $('tagAuto')]].forEach(function (group) {
          var box = group[1];
          if (!box) return;
          var buttons = box.querySelectorAll('.gv-taginput-suggestion[data-tag]');
          buttons.forEach(function (button) {
            button.classList.toggle('d-none', hasTag(button.dataset.tag) || tags.length >= maxTags);
          });
          box.classList.toggle('d-none', box.querySelectorAll('.gv-taginput-suggestion[data-tag]:not(.d-none)').length === 0);
        });
        refreshPreview();
        scheduleAutoCover();
      }
      function addTag(raw) {
        readTags(raw).forEach(function (tag) {
          if (tags.length < maxTags && !hasTag(tag)) tags.push(tag);
        });
        renderTags();
        touched();
      }
      tags = readTags(tagsValue.value).filter(function (tag, i, list) {
        return list.findIndex(function (t) { return t.toLowerCase() === tag.toLowerCase(); }) === i;
      }).slice(0, maxTags);

      tagInput.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ',' || event.key === ';') {
          event.preventDefault();
          if (tagInput.value.trim()) addTag(tagInput.value);
          tagInput.value = '';
        } else if (event.key === 'Backspace' && !tagInput.value && tags.length) {
          tags.pop();
          renderTags();
          touched();
        }
      });
      tagInput.addEventListener('input', function () {
        if (/[,;]/.test(tagInput.value)) {
          addTag(tagInput.value);
          tagInput.value = '';
        }
      });
      tagInput.addEventListener('blur', function () {
        if (tagInput.value.trim()) addTag(tagInput.value);
        tagInput.value = '';
      });
      $('tagBox').addEventListener('click', function () { tagInput.focus(); });
      document.querySelectorAll('#tagSuggest .gv-taginput-suggestion').forEach(function (button) {
        button.addEventListener('click', function () { addTag(button.dataset.tag); });
      });

      /* ------------------- pasek formatowania i skróty ------------------- */
      function fire() { content.dispatchEvent(new Event('input', { bubbles: true })); }

      function wrapInline(before, after, placeholder) {
        var start = content.selectionStart;
        var end = content.selectionEnd;
        var text = content.value.slice(start, end) || placeholder;
        content.focus();
        content.setRangeText(before + text + after, start, end, 'end');
        content.setSelectionRange(start + before.length, start + before.length + text.length);
        fire();
      }

      var BLOCK_PREFIX = /^(?:#{2}\s+|[-*]\s+|\d+\.\s+|>\s?)/;
      function blockFormat(kind) {
        var value = content.value;
        var start = content.selectionStart;
        var end = content.selectionEnd;
        var lineStart = value.lastIndexOf('\n', start - 1) + 1;
        var endIndex = value.indexOf('\n', end);
        var lineEnd = endIndex === -1 ? value.length : endIndex;
        var lines = value.slice(lineStart, lineEnd).split('\n');
        var placeholder = { h2: 'Śródtytuł', ul: 'Punkt listy', ol: 'Punkt listy', quote: 'Cytat' }[kind];
        if (lines.length === 1 && !lines[0].trim()) lines = [placeholder];

        var marks = {
          h2: /^##\s+/, ul: /^[-*]\s+/, ol: /^\d+\.\s+/, quote: /^>\s?/
        };
        var already = lines.every(function (line) { return marks[kind].test(line); });
        var bare = lines.map(function (line) { return line.replace(BLOCK_PREFIX, ''); });

        var out;
        if (already) out = bare;
        else if (kind === 'h2') out = ['## ' + bare.join(' ').trim()];
        else if (kind === 'ul') out = bare.map(function (line) { return '- ' + line; });
        else if (kind === 'ol') out = bare.map(function (line, i) { return (i + 1) + '. ' + line; });
        else out = bare.map(function (line) { return '> ' + line; });

        // Bloki oddzielamy pustą linią (tak rozpoznaje je renderer wpisu).
        var before = lineStart > 1 && value.charAt(lineStart - 2) !== '\n' && !already ? '\n' : '';
        var after = lineEnd < value.length - 1 && value.charAt(lineEnd + 1) !== '\n' && !already ? '\n' : '';
        var text = before + out.join('\n') + after;
        content.focus();
        content.setRangeText(text, lineStart, lineEnd, 'end');
        var selStart = lineStart + before.length;
        content.setSelectionRange(selStart, selStart + out.join('\n').length);
        fire();
      }

      var commands = {
        h2: function () { blockFormat('h2'); },
        bold: function () { wrapInline('**', '**', 'pogrubienie'); },
        italic: function () { wrapInline('*', '*', 'kursywa'); },
        ul: function () { blockFormat('ul'); },
        ol: function () { blockFormat('ol'); },
        quote: function () { blockFormat('quote'); },
        link: function () { openLinkDialog(); },
        image: function () { openMediaDialog(); },
        game: function () { openEmbedDialog('game'); },
        video: function () { openEmbedDialog('video'); },
        info: function () { insertBlock('> [!INFO] Wpisz treść ramki', 'Wpisz treść ramki'); },
        tip: function () { insertBlock('> [!TIP] Wpisz treść wskazówki', 'Wpisz treść wskazówki'); },
        warning: function () { insertBlock('> [!WARNING] Wpisz treść ostrzeżenia', 'Wpisz treść ostrzeżenia'); },
        hr: function () { insertBlock('---'); }
      };
      $('toolbar').addEventListener('click', function (event) {
        var button = event.target.closest('button[data-cmd]');
        if (button && commands[button.dataset.cmd]) commands[button.dataset.cmd]();
      });
      content.addEventListener('keydown', function (event) {
        if (!(event.ctrlKey || event.metaKey) || event.altKey) return;
        var key = event.key.toLowerCase();
        if (key === 'b') { event.preventDefault(); commands.bold(); }
        else if (key === 'i') { event.preventDefault(); commands.italic(); }
        else if (key === 'k') { event.preventDefault(); commands.link(); }
      });

      /* --------------------------- zakładki: pisz / podgląd --------------------------- */
      var preview = $('contentPreview');
      var toolbar = $('toolbar');
      var previewTimer = null;
      function showTab(name) {
        form.querySelectorAll('.gv-blogedit-tabs button').forEach(function (tab) {
          var active = tab.dataset.tab === name;
          tab.classList.toggle('active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        var isPreview = name === 'preview';
        content.classList.toggle('d-none', isPreview);
        toolbar.classList.toggle('disabled', isPreview);
        preview.classList.toggle('d-none', !isPreview);
        if (isPreview) loadPreview();
      }
      function loadPreview() {
        if (!content.value.trim()) {
          preview.innerHTML = '<p class="gv-muted">Nie ma jeszcze czego pokazać - wpisz treść w zakładce „Pisz”.</p>';
          return;
        }
        preview.innerHTML = '<p class="gv-muted"><i class="bi bi-arrow-repeat gv-spin"></i> Renderuję podgląd...</p>';
        fetch('/blog/preview', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ content: content.value }) })
          .then(function (response) { return response.json(); })
          .then(function (data) { preview.innerHTML = data.html || ''; })
          .catch(function () { preview.innerHTML = '<p class="gv-muted">Nie udało się wyrenderować podglądu.</p>'; });
      }
      form.querySelectorAll('.gv-blogedit-tabs button').forEach(function (tab) {
        tab.addEventListener('click', function () { showTab(tab.dataset.tab); });
      });

      /* ------------------------------ okładka ------------------------------ */
      var cover = $('blogCover');
      var coverUrl = $('blogCoverUrl');
      var removeCover = $('blogRemoveCover');
      var dropzone = $('blogDropzone');
      var pvCover = $('pvCover');
      var originalCover = pvCover.getAttribute('src');
      var placeholder = '/images/game-placeholder.svg';

      /* Okładka automatyczna: podgląd tworzy serwer (ta sama funkcja, co przy zapisie wpisu). */
      var autoCover = $('autoCover');
      var autoBody = $('autoCoverBody');
      var autoImg = $('autoCoverImg');
      var autoHint = $('autoCoverHint');
      var variant = $('coverVariant');
      var autoUrl = '';
      var autoKey = '';
      var autoTimer = null;
      var autoRequest = 0;

      function autoSpec() {
        return JSON.stringify([title.value.trim(), selectedCategory(), tags.join(','), variant.value]);
      }
      function loadAutoCover() {
        if (!autoCover.checked) return;
        var name = title.value.trim();
        if (!name) {
          autoUrl = '';
          autoKey = '';
          autoImg.src = placeholder;
          autoHint.classList.remove('d-none');
          refreshCover();
          return;
        }
        var key = autoSpec();
        if (key === autoKey && autoUrl) return;
        autoKey = key;
        var mine = ++autoRequest;
        autoBody.classList.add('loading');
        fetch('/blog/cover-preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: name, category: selectedCategory(), tags: tags.join(','), variant: variant.value })
        })
          .then(function (response) { if (!response.ok) throw new Error('bad'); return response.blob(); })
          .then(function (blob) {
            if (mine !== autoRequest) return;
            if (autoUrl) URL.revokeObjectURL(autoUrl);
            autoUrl = URL.createObjectURL(blob);
            autoImg.src = autoUrl;
            autoHint.classList.add('d-none');
            refreshCover();
          })
          .catch(function () { if (mine === autoRequest) autoHint.textContent = 'Nie udało się utworzyć podglądu okładki.'; })
          .then(function () { if (mine === autoRequest) autoBody.classList.remove('loading'); });
      }
      function scheduleAutoCover() {
        if (!autoCover || !autoCover.checked) return;
        clearTimeout(autoTimer);
        autoTimer = setTimeout(loadAutoCover, 450);
      }
      function setAuto(on) {
        autoCover.checked = on;
        autoBody.classList.toggle('d-none', !on);
        if (on) {
          cover.value = '';
          coverUrl.value = '';
          if (removeCover) removeCover.checked = false;
          loadAutoCover();
        }
        refreshCover();
      }
      autoCover.addEventListener('change', function () { setAuto(autoCover.checked); touched(); });
      $('autoCoverShuffle').addEventListener('click', function () {
        variant.value = String((parseInt(variant.value, 10) || 0) + 1);
        autoKey = '';
        loadAutoCover();
        touched();
      });
      form.addEventListener('input', scheduleAutoCover);
      form.addEventListener('change', scheduleAutoCover);

      function currentCoverSrc() {
        if (removeCover && removeCover.checked) return placeholder;
        if (cover.files && cover.files[0]) return URL.createObjectURL(cover.files[0]);
        if (coverUrl.value.trim()) return coverUrl.value.trim();
        if (autoCover.checked && autoUrl) return autoUrl;
        return originalCover;
      }
      function refreshCover() {
        pvCover.src = currentCoverSrc();
        var file = cover.files && cover.files[0];
        $('blogFileName').textContent = file ? file.name : '';
        refreshPreview();
      }
      function useFile(files) {
        if (!files || !files[0]) return;
        cover.files = files;
        coverUrl.value = '';
        if (removeCover) removeCover.checked = false;
        autoCover.checked = false;
        autoBody.classList.add('d-none');
        refreshCover();
        touched();
      }
      cover.addEventListener('change', function () { useFile(cover.files); });
      ['dragenter', 'dragover'].forEach(function (name) {
        dropzone.addEventListener(name, function (event) { event.preventDefault(); dropzone.classList.add('dragging'); });
      });
      ['dragleave', 'drop'].forEach(function (name) {
        dropzone.addEventListener(name, function (event) { event.preventDefault(); dropzone.classList.remove('dragging'); });
      });
      dropzone.addEventListener('drop', function (event) {
        if (event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files[0]) useFile(event.dataTransfer.files);
      });
      $('coverUrlToggle').addEventListener('click', function () {
        var box = $('coverUrlBox');
        box.classList.toggle('d-none');
        if (!box.classList.contains('d-none')) coverUrl.focus();
      });
      coverUrl.addEventListener('input', function () {
        if (coverUrl.value.trim()) {
          cover.value = '';
          if (removeCover) removeCover.checked = false;
          autoCover.checked = false;
          autoBody.classList.add('d-none');
        }
        refreshCover();
      });
      if (removeCover) {
        removeCover.addEventListener('change', function () {
          if (removeCover.checked) {
            cover.value = '';
            coverUrl.value = '';
            autoCover.checked = false;
            autoBody.classList.add('d-none');
          }
          refreshCover();
        });
      }

      /* ------------------------------ krótki opis ------------------------------ */
      $('excerptAuto').addEventListener('click', function () {
        excerpt.value = excerptFrom(content.value);
        excerpt.dispatchEvent(new Event('input', { bubbles: true }));
      });

      /* ------------------------------ publikacja ------------------------------ */
      var scheduleBox = $('scheduleBox');
      var local = $('publishAtLocal');
      var iso = $('publishAtIso');
      var submit = $('blogSubmit');
      var submitLabel = $('blogSubmitLabel');
      var labels = { now: submit.dataset.editing ? 'Zapisz zmiany' : 'Opublikuj', draft: 'Zapisz szkic', schedule: 'Zaplanuj publikację' };

      local.min = toLocalValue(new Date());
      if (local.dataset.iso) {
        var existing = new Date(local.dataset.iso);
        if (!isNaN(existing.getTime())) local.value = toLocalValue(existing);
      }
      form.querySelectorAll('input[name="publishMode"]').forEach(function (radio) {
        radio.addEventListener('change', function () { refreshMode(); touched(); });
      });
      function refreshMode() {
        var current = mode();
        scheduleBox.classList.toggle('d-none', current !== 'schedule');
        local.required = current === 'schedule';
        submitLabel.textContent = labels[current];
        refreshPreview();
      }
      form.querySelectorAll('[data-quick]').forEach(function (button) {
        button.addEventListener('click', function () {
          var date = new Date();
          if (button.dataset.quick === 'hour') date.setHours(date.getHours() + 1);
          else {
            date.setDate(date.getDate() + (button.dataset.quick === 'week' ? 7 : 1));
            date.setHours(9, 0, 0, 0);
          }
          local.value = toLocalValue(date);
          local.dispatchEvent(new Event('input', { bubbles: true }));
        });
      });

      /* ----------------------- podgląd karty, liczniki, lista ----------------------- */
      function fmtDate(date) {
        return date.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
      }
      function refreshPreview() {
        var text = content.value;
        var wordCount = words(text);
        var minutes = Math.max(1, Math.round(wordCount / 200));
        var max = parseInt(excerpt.getAttribute('maxlength'), 10) || 200;
        var auto = excerptFrom(text);

        $('titleCount').textContent = title.value.length + '/' + title.getAttribute('maxlength');
        $('excerptCount').textContent = excerpt.value.length + '/' + max;
        $('contentStats').textContent = wordCount + ' ' + (wordCount === 1 ? 'słowo' : 'słów') + ' · ok. ' + minutes + ' min czytania';

        $('pvTitle').textContent = title.value.trim() || 'Tytuł wpisu';
        $('pvCategory').textContent = selectedCategory();
        $('pvAuthor').textContent = form.dataset.author;
        $('pvRead').textContent = minutes;
        var pvExcerpt = $('pvExcerpt');
        pvExcerpt.textContent = excerpt.value.trim() || auto || 'Krótki opis pojawi się tutaj.';
        pvExcerpt.classList.toggle('gv-muted', !excerpt.value.trim());

        var current = mode();
        var dateText = fmtDate(new Date());
        if (current === 'draft') dateText = 'Szkic';
        else if (current === 'schedule' && local.value) dateText = fmtDate(new Date(local.value));
        $('pvDate').textContent = dateText;

        var pvTags = $('pvTags');
        pvTags.innerHTML = '';
        tags.slice(0, 3).forEach(function (tag) {
          var span = document.createElement('a');
          span.textContent = '#' + tag;
          pvTags.appendChild(span);
        });

        var hasCover = !!(cover.files && cover.files[0]) || !!coverUrl.value.trim() || (autoCover.checked && !!title.value.trim()) || (originalCover !== placeholder && !(removeCover && removeCover.checked));
        setCheck('title', title.value.trim().length >= 5, title.value.trim().length >= 5 ? 'Tytuł' : 'Tytuł (min. 5 znaków)');
        setCheck('content', wordCount >= 50, wordCount >= 50 ? 'Treść (' + wordCount + ' słów)' : 'Treść (' + wordCount + ' słów - dobrze mieć 50+)');
        setCheck('cover', hasCover, hasCover ? (autoCover.checked && !(cover.files && cover.files[0]) && !coverUrl.value.trim() ? 'Okładka (automatyczna)' : 'Okładka') : 'Okładka (opcjonalnie)');
        setCheck('tags', tags.length > 0, tags.length > 0 ? 'Tagi (' + tags.length + ')' : 'Tagi (opcjonalnie)');
        coverPresent = hasCover;
        scheduleAssist();
      }
      function setCheck(name, done, label) {
        var item = document.querySelector('#checklist [data-check="' + name + '"]');
        item.classList.toggle('done', done);
        item.querySelector('i').className = 'bi ' + (done ? 'bi-check-circle-fill' : 'bi-circle');
        item.querySelector('span').textContent = label;
      }

      /* ------------- automatyczny zapis kopii roboczej w przeglądarce ------------- */
      var draftKey = 'gv-blog-draft:' + form.dataset.draftKey;
      function snapshot() {
        return { title: title.value, excerpt: excerpt.value, content: content.value, category: selectedCategory(), tags: tags.join(', ') };
      }
      function apply(data) {
        title.value = data.title || '';
        excerpt.value = data.excerpt || '';
        content.value = data.content || '';
        var radio = form.querySelector('input[name="category"][value="' + (data.category || '') + '"]');
        if (radio) radio.checked = true;
        tags = readTags(data.tags).slice(0, maxTags);
        renderTags();
        refreshPreview();
      }
      function readDraft() {
        try { return JSON.parse(localStorage.getItem(draftKey) || 'null'); } catch (err) { return null; }
      }
      function clearDraft() {
        try { localStorage.removeItem(draftKey); } catch (err) { /* brak dostępu do pamięci przeglądarki */ }
      }
      var initial = JSON.stringify(snapshot());
      var stored = readDraft();
      if (stored && stored.data && JSON.stringify(stored.data) !== initial && (stored.data.title || stored.data.content)) {
        $('draftBannerTime').textContent = new Date(stored.savedAt).toLocaleString('pl-PL', { dateStyle: 'medium', timeStyle: 'short' });
        $('draftBanner').classList.remove('d-none');
        $('draftRestore').addEventListener('click', function () {
          apply(stored.data);
          $('draftBanner').classList.add('d-none');
          touched();
        });
        $('draftDiscard').addEventListener('click', function () {
          clearDraft();
          $('draftBanner').classList.add('d-none');
        });
      }
      var saveTimer = null;
      function touched() {
        dirty = true;
        clearTimeout(saveTimer);
        saveTimer = setTimeout(function () {
          var data = snapshot();
          if (JSON.stringify(data) === initial) return clearDraft();
          try { localStorage.setItem(draftKey, JSON.stringify({ savedAt: Date.now(), data: data })); } catch (err) { /* pełna pamięć lub tryb prywatny */ }
        }, 800);
      }

      form.addEventListener('input', function (event) {
        if (event.target.matches('#tagInput')) return;
        refreshPreview();
        touched();
      });
      form.addEventListener('change', function () { refreshPreview(); touched(); });

      window.addEventListener('beforeunload', function (event) {
        if (dirty && !submitting) {
          event.preventDefault();
          event.returnValue = '';
        }
      });

      // Wysłanie z zakładki "Podgląd": wracamy do pisania, żeby przeglądarka mogła wskazać puste pole treści.
      submit.addEventListener('click', function () {
        if (content.classList.contains('d-none')) showTab('write');
      });

      form.addEventListener('submit', function (event) {
        if (tagInput.value.trim()) addTag(tagInput.value);
        tagInput.value = '';
        if (!title.value.trim() || !content.value.trim()) {
          event.preventDefault();
          (title.value.trim() ? content : title).focus();
          return;
        }
        if (mode() === 'schedule' && local.value) {
          var picked = new Date(local.value);
          if (!isNaN(picked.getTime())) iso.value = picked.toISOString();
        } else {
          iso.value = '';
        }
        submitting = true;
        clearDraft();
        submit.disabled = true;
      });

      /* ------------------- mini CMS: zdjęcia, linki, karty gier, filmy ------------------- */
      var bootstrapApi = window.bootstrap;
      function modal(id) { return bootstrapApi.Modal.getOrCreateInstance($(id)); }
      var savedRange = null;
      function rememberSelection() { savedRange = { start: content.selectionStart, end: content.selectionEnd }; }
      function show(el, visible) { el.classList.toggle('d-none', !visible); }

      /** Wstawia blok (zdjęcie, film, ramkę...) jako osobny akapit - z pustymi liniami wokół. */
      function insertBlock(markdown, selectText) {
        var range = savedRange || { start: content.selectionStart, end: content.selectionEnd };
        savedRange = null;
        var value = content.value;
        var before = value.slice(0, range.start);
        var after = value.slice(range.end);
        var prefix = before && !/\n\n$/.test(before) ? (/\n$/.test(before) ? '\n' : '\n\n') : '';
        var suffix = !after || /^\n\n/.test(after) ? '\n\n' : (/^\n/.test(after) ? '\n' : '\n\n');
        var text = prefix + markdown + suffix;
        content.focus();
        content.setRangeText(text, range.start, range.end, 'end');
        if (selectText) {
          var at = range.start + prefix.length + markdown.indexOf(selectText);
          content.setSelectionRange(at, at + selectText.length);
        }
        fire();
      }

      /** Wyszukiwarka gier w katalogu (ta sama, której używa okno ulubionej gry na profilu). */
      function bindGameSearch(input, list, onPick) {
        var timer = null;
        var seq = 0;
        input.addEventListener('input', function () {
          clearTimeout(timer);
          var q = input.value.trim();
          if (q.length < 2) { list.innerHTML = ''; return; }
          timer = setTimeout(function () {
            var mine = ++seq;
            list.innerHTML = '<li class="gv-gamepick-note"><i class="bi bi-arrow-repeat gv-spin"></i> Szukam...</li>';
            fetch('/games/search-json?q=' + encodeURIComponent(q), { headers: { Accept: 'application/json' } })
              .then(function (response) { return response.json(); })
              .then(function (data) {
                if (mine !== seq) return;
                list.innerHTML = '';
                if (!data.games || !data.games.length) { list.innerHTML = '<li class="gv-gamepick-note">Nie znaleziono takiej gry w katalogu.</li>'; return; }
                data.games.forEach(function (game) {
                  var item = document.createElement('li');
                  var button = document.createElement('button');
                  button.type = 'button';
                  var image = document.createElement('img');
                  image.src = game.coverImage;
                  image.alt = '';
                  image.loading = 'lazy';
                  var text = document.createElement('span');
                  var name = document.createElement('b');
                  name.textContent = game.title;
                  var meta = document.createElement('small');
                  meta.textContent = [game.releaseYear, game.platform].filter(Boolean).join(' · ');
                  text.appendChild(name);
                  text.appendChild(meta);
                  button.appendChild(image);
                  button.appendChild(text);
                  button.addEventListener('click', function () { onPick(game); });
                  item.appendChild(button);
                  list.appendChild(item);
                });
              })
              .catch(function () { if (mine === seq) list.innerHTML = '<li class="gv-gamepick-note">Nie udało się wyszukać gier.</li>'; });
          }, 350);
        });
      }

      /* --- link --- */
      var linkText = $('linkText');
      var linkUrl = $('linkUrl');
      var linkError = $('linkError');
      function openLinkDialog() {
        rememberSelection();
        linkText.value = content.value.slice(savedRange.start, savedRange.end);
        linkUrl.value = '';
        $('linkGameSearch').value = '';
        $('linkGameList').innerHTML = '';
        show(linkError, false);
        modal('linkModal').show();
      }
      $('linkModal').addEventListener('shown.bs.modal', function () { (linkText.value ? linkUrl : linkText).focus(); });
      bindGameSearch($('linkGameSearch'), $('linkGameList'), function (game) {
        linkUrl.value = '/games/' + game.id;
        if (!linkText.value.trim()) linkText.value = game.title;
        $('linkGameList').innerHTML = '';
        $('linkGameSearch').value = game.title;
      });
      $('linkInsert').addEventListener('click', function () {
        var url = linkUrl.value.trim();
        var label = linkText.value.trim();
        if (url && !/^(?:https?:\/\/|\/(?!\/))/i.test(url) && /^[^\s\/]+\.[a-z]{2,}(?:\/\S*)?$/i.test(url)) url = 'https://' + url;
        if (!/^(?:https?:\/\/[^\s)]+|\/(?!\/)[^\s)]*)$/i.test(url)) {
          linkError.textContent = 'Podaj poprawny adres: https://... albo /games/123.';
          show(linkError, true);
          return;
        }
        if (!label) {
          try { label = url.charAt(0) === '/' ? 'zobacz więcej' : new URL(url).hostname.replace(/^www\./, ''); } catch (err) { label = url; }
        }
        var range = savedRange || { start: content.selectionStart, end: content.selectionEnd };
        savedRange = null;
        var snippet = '[' + label.replace(/[\[\]]/g, '') + '](' + url + ')';
        content.focus();
        content.setRangeText(snippet, range.start, range.end, 'end');
        modal('linkModal').hide();
        fire();
      });

      /* --- zdjęcia i infografiki --- */
      var media = { id: null, url: '', alt: '', caption: '' };
      var mediaLoaded = false;
      var mediaAlt = $('mediaAlt');
      var mediaCaption = $('mediaCaption');
      var mediaStatus = $('mediaStatus');
      var mediaError = $('mediaError');

      function mediaTab(name) {
        document.querySelectorAll('[data-media-tab]').forEach(function (tab) { tab.classList.toggle('active', tab.dataset.mediaTab === name); });
        show($('mediaPaneUpload'), name === 'upload');
        show($('mediaPaneLibrary'), name === 'library');
        show($('mediaPaneUrl'), name === 'url');
        if (name === 'library' && !mediaLoaded) loadLibrary();
      }
      function mediaSays(text, isError) {
        mediaStatus.textContent = text || '';
        mediaStatus.classList.toggle('error', !!isError);
        show(mediaStatus, !!text);
      }
      function mediaStep(details) {
        show($('mediaStepPick'), !details);
        show($('mediaStepDetails'), details);
        show($('mediaBack'), details);
        show($('mediaInsert'), details);
      }
      function openMediaDialog(file) {
        rememberSelection();
        mediaStep(false);
        mediaTab('upload');
        mediaSays('');
        $('mediaFile').value = '';
        modal('mediaModal').show();
        if (file) uploadMedia(file);
      }
      function showMediaDetails(item) {
        media = { id: item.id || null, url: item.url, alt: item.alt || '', caption: item.caption || '' };
        $('mediaPreview').src = item.url;
        mediaAlt.value = media.alt;
        mediaCaption.value = media.caption;
        $('mediaLayout').value = '';
        show(mediaError, false);
        updateAltCount();
        mediaStep(true);
        setTimeout(function () { mediaAlt.focus(); }, 150);
      }
      function updateAltCount() { $('mediaAltCount').textContent = mediaAlt.value.length + '/200'; }
      mediaAlt.addEventListener('input', updateAltCount);

      function uploadMedia(file) {
        if (!/^image\//.test(file.type)) { mediaSays('To nie jest obraz - wybierz plik PNG, JPG, WEBP lub GIF.', true); return; }
        mediaSays('Wgrywam i sprawdzam obraz...');
        var data = new FormData();
        data.append('image', file);
        fetch('/blog/media', { method: 'POST', headers: { Accept: 'application/json' }, body: data })
          .then(function (response) { return response.json().then(function (body) { return { ok: response.ok, body: body }; }); })
          .then(function (result) {
            if (!result.ok) { mediaSays(result.body.error || 'Nie udało się wgrać obrazu.', true); return; }
            mediaLoaded = false;
            mediaSays('');
            showMediaDetails(result.body.media);
          })
          .catch(function () { mediaSays('Nie udało się wgrać obrazu. Spróbuj ponownie.', true); });
      }
      $('mediaFile').addEventListener('change', function () { if (this.files && this.files[0]) uploadMedia(this.files[0]); });
      var mediaDrop = $('mediaDropzone');
      ['dragenter', 'dragover'].forEach(function (name) {
        mediaDrop.addEventListener(name, function (event) { event.preventDefault(); mediaDrop.classList.add('dragging'); });
      });
      ['dragleave', 'drop'].forEach(function (name) {
        mediaDrop.addEventListener(name, function (event) { event.preventDefault(); mediaDrop.classList.remove('dragging'); });
      });
      mediaDrop.addEventListener('drop', function (event) {
        if (event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files[0]) uploadMedia(event.dataTransfer.files[0]);
      });

      function loadLibrary() {
        var grid = $('mediaGrid');
        grid.innerHTML = '<p class="gv-muted"><i class="bi bi-arrow-repeat gv-spin"></i> Wczytuję bibliotekę...</p>';
        fetch('/blog/media', { headers: { Accept: 'application/json' } })
          .then(function (response) { return response.json(); })
          .then(function (data) {
            mediaLoaded = true;
            grid.innerHTML = '';
            show($('mediaEmpty'), !data.media.length);
            data.media.forEach(function (item) {
              var cell = document.createElement('div');
              cell.className = 'gv-media-item';
              var pick = document.createElement('button');
              pick.type = 'button';
              pick.title = item.alt || item.originalName || 'Wybierz zdjęcie';
              var image = document.createElement('img');
              image.src = item.url;
              image.alt = item.alt || '';
              image.loading = 'lazy';
              pick.appendChild(image);
              pick.addEventListener('click', function () { showMediaDetails(item); });
              var remove = document.createElement('button');
              remove.type = 'button';
              remove.className = 'gv-media-remove';
              remove.title = 'Usuń z biblioteki';
              remove.innerHTML = '<i class="bi bi-trash3-fill"></i>';
              remove.addEventListener('click', function () {
                if (!window.confirm('Usunąć to zdjęcie z biblioteki?')) return;
                post('/blog/media/' + item.id + '/delete', {})
                  .then(function () { cell.remove(); show($('mediaEmpty'), !grid.children.length); })
                  .catch(function () { mediaSays('Nie można usunąć - zdjęcie jest użyte we wpisie.', true); mediaTab('library'); });
              });
              cell.appendChild(pick);
              cell.appendChild(remove);
              grid.appendChild(cell);
            });
          })
          .catch(function () { grid.innerHTML = '<p class="gv-muted">Nie udało się wczytać biblioteki.</p>'; });
      }
      document.querySelectorAll('[data-media-tab]').forEach(function (tab) {
        tab.addEventListener('click', function () { mediaSays(''); mediaTab(tab.dataset.mediaTab); });
      });
      $('mediaUrlUse').addEventListener('click', function () {
        var url = $('mediaUrl').value.trim();
        if (!/^(?:https:\/\/[^\s)]+|\/(?!\/)[^\s)]*)$/.test(url)) { mediaSays('Podaj adres zaczynający się od https:// albo /images/...', true); return; }
        mediaSays('');
        showMediaDetails({ url: url, alt: '', caption: '' });
      });
      $('mediaBack').addEventListener('click', function () { mediaStep(false); });
      $('mediaAltSuggest').addEventListener('click', function () {
        var base = title.value.trim() || 'Ilustracja do wpisu';
        mediaAlt.value = (mediaCaption.value.trim() || base).slice(0, 200);
        updateAltCount();
      });
      $('mediaInsert').addEventListener('click', function () {
        var alt = mediaAlt.value.replace(/[\[\]\n]/g, ' ').replace(/\s+/g, ' ').trim();
        var caption = mediaCaption.value.replace(/"/g, "'").replace(/\s+/g, ' ').trim();
        if (alt.length < 3) {
          mediaError.textContent = 'Opisz zdjęcie (tekst alternatywny) - to ważne dla SEO i osób korzystających z czytników ekranu.';
          show(mediaError, true);
          mediaAlt.focus();
          return;
        }
        var layout = $('mediaLayout').value;
        var markdown = '![' + alt + '](' + media.url + (caption ? ' "' + caption + '"' : '') + ')' + (layout ? '{' + layout + '}' : '');
        // Opis i podpis zapamiętujemy w bibliotece - przy kolejnym użyciu obrazu będą podpowiedziane.
        if (media.id && (alt !== media.alt || caption !== media.caption)) {
          post('/blog/media/' + media.id, { alt: alt, caption: caption }).catch(function () {});
          mediaLoaded = false;
        }
        modal('mediaModal').hide();
        insertBlock(markdown);
      });

      // Wklejenie lub upuszczenie obrazu w treść wpisu otwiera okno wstawiania (z wgraniem pliku).
      function imageFrom(files) {
        for (var i = 0; files && i < files.length; i += 1) if (/^image\//.test(files[i].type)) return files[i];
        return null;
      }
      content.addEventListener('paste', function (event) {
        var file = imageFrom(event.clipboardData && event.clipboardData.files);
        if (!file) return;
        event.preventDefault();
        openMediaDialog(file);
      });
      content.addEventListener('dragover', function (event) {
        if (event.dataTransfer && Array.prototype.some.call(event.dataTransfer.types || [], function (t) { return t === 'Files'; })) event.preventDefault();
      });
      content.addEventListener('drop', function (event) {
        var file = imageFrom(event.dataTransfer && event.dataTransfer.files);
        if (!file) return;
        event.preventDefault();
        openMediaDialog(file);
      });

      /* --- karta gry i film YouTube --- */
      var embedVideoId = '';
      function embedTab(name) {
        document.querySelectorAll('[data-embed-tab]').forEach(function (tab) { tab.classList.toggle('active', tab.dataset.embedTab === name); });
        show($('embedPaneGame'), name === 'game');
        show($('embedPaneVideo'), name === 'video');
        show($('embedVideoInsert'), name === 'video' && !!embedVideoId);
        setTimeout(function () { (name === 'game' ? $('embedGameSearch') : $('embedVideoUrl')).focus(); }, 200);
      }
      function openEmbedDialog(tab) {
        rememberSelection();
        $('embedGameSearch').value = '';
        $('embedGameList').innerHTML = '';
        $('embedVideoUrl').value = '';
        embedVideoId = '';
        show($('embedVideoPreview'), false);
        show($('embedVideoError'), false);
        embedTab(tab);
        modal('embedModal').show();
      }
      document.querySelectorAll('[data-embed-tab]').forEach(function (tab) {
        tab.addEventListener('click', function () { embedTab(tab.dataset.embedTab); });
      });
      bindGameSearch($('embedGameSearch'), $('embedGameList'), function (game) {
        modal('embedModal').hide();
        insertBlock('[[game:' + game.id + ']]');
      });
      function youtubeId(text) {
        var value = String(text || '').trim();
        if (/^[A-Za-z0-9_-]{11}$/.test(value)) return value;
        var match = value.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/))([A-Za-z0-9_-]{11})/);
        return match ? match[1] : '';
      }
      $('embedVideoUrl').addEventListener('input', function () {
        embedVideoId = youtubeId(this.value);
        var preview = $('embedVideoPreview');
        show($('embedVideoError'), !!this.value.trim() && !embedVideoId);
        $('embedVideoError').textContent = 'Nie rozpoznaję tego adresu - wklej link do filmu z YouTube.';
        preview.innerHTML = '';
        if (embedVideoId) {
          var image = document.createElement('img');
          image.src = 'https://img.youtube.com/vi/' + embedVideoId + '/hqdefault.jpg';
          image.alt = 'Miniatura filmu';
          preview.appendChild(image);
        }
        show(preview, !!embedVideoId);
        show($('embedVideoInsert'), !!embedVideoId);
      });
      $('embedVideoInsert').addEventListener('click', function () {
        if (!embedVideoId) return;
        modal('embedModal').hide();
        insertBlock('@[youtube](' + embedVideoId + ')');
      });

      /* ----------------- asystent SEO: propozycje tagów, ocena, formatowanie ----------------- */
      var assistTimer = null;
      var assistSeq = 0;
      var assistKey = '';
      var suggestions = [];

      function post(url, payload) {
        return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) })
          .then(function (response) { if (!response.ok) throw new Error('bad'); return response.json(); });
      }
      function scheduleAssist() {
        clearTimeout(assistTimer);
        assistTimer = setTimeout(runAssist, 900);
      }
      function runAssist() {
        var payload = { title: title.value, excerpt: excerpt.value, content: content.value, tags: tags.join(', '), hasCover: coverPresent };
        var key = JSON.stringify(payload);
        if (key === assistKey) return;
        assistKey = key;
        var mine = ++assistSeq;
        post('/blog/assist', payload)
          .then(function (data) {
            if (mine !== assistSeq) return;
            renderSuggestions(data.tags || []);
            renderSeo(data);
          })
          .catch(function () { assistKey = ''; });
      }

      function renderSuggestions(list) {
        var box = $('tagAuto');
        var holder = $('tagAutoList');
        holder.innerHTML = '';
        suggestions = list.filter(function (item) { return !hasTag(item.tag); });
        if (!suggestions.length || tags.length >= maxTags) { box.classList.add('d-none'); return; }
        suggestions.forEach(function (item) {
          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'gv-taginput-suggestion gv-tagauto-chip';
          button.dataset.tag = item.tag;
          button.textContent = '+ #' + item.tag;
          button.title = item.why || '';
          button.addEventListener('click', function () { addTag(item.tag); });
          holder.appendChild(button);
        });
        box.classList.remove('d-none');
      }
      $('tagAutoAll').addEventListener('click', function () {
        suggestions.slice().forEach(function (item) { addTag(item.tag); });
      });

      function renderSeo(data) {
        var analysis = data.analysis;
        if (!analysis) return;
        var score = analysis.score;
        $('seoScore').textContent = score + '/100';
        var bar = $('seoBar');
        bar.style.width = score + '%';
        bar.className = score >= 75 ? 'good' : score >= 50 ? 'mid' : 'low';

        var primary = $('seoPrimary');
        if (data.keywords && data.keywords.length) {
          primary.textContent = 'Główne słowo kluczowe: ' + data.keywords[0].text;
          primary.classList.remove('d-none');
        } else {
          primary.classList.add('d-none');
        }

        // Najpierw to, co do poprawy (z podpowiedziami); spełnione punkty zwinięte pod spodem.
        var list = $('seoChecks');
        list.innerHTML = '';
        var passed = [];
        analysis.checks.forEach(function (check) {
          if (check.ok) { passed.push(check); return; }
          var item = document.createElement('li');
          item.className = 'bad';
          var icon = document.createElement('i');
          icon.className = 'bi bi-exclamation-circle';
          var text = document.createElement('span');
          text.textContent = check.label;
          var hint = document.createElement('small');
          hint.textContent = check.hint;
          text.appendChild(hint);
          item.appendChild(icon);
          item.appendChild(text);
          list.appendChild(item);
        });
        if (passed.length) {
          var wrap = document.createElement('li');
          wrap.className = 'passed';
          var details = document.createElement('details');
          var summary = document.createElement('summary');
          summary.textContent = 'Spełnione (' + passed.length + ')';
          details.appendChild(summary);
          var inner = document.createElement('ul');
          passed.forEach(function (check) {
            var item = document.createElement('li');
            item.className = 'ok';
            var icon = document.createElement('i');
            icon.className = 'bi bi-check-circle-fill';
            var text = document.createElement('span');
            text.textContent = check.label;
            item.appendChild(icon);
            item.appendChild(text);
            inner.appendChild(item);
          });
          details.appendChild(inner);
          wrap.appendChild(details);
          list.appendChild(wrap);
        }
      }

      var formatNote = $('formatNote');
      var undoContent = null;
      function noteList(title, lines) {
        var block = document.createElement('div');
        var head = document.createElement('b');
        head.textContent = title;
        block.appendChild(head);
        var ul = document.createElement('ul');
        lines.forEach(function (line) { var li = document.createElement('li'); li.textContent = line; ul.appendChild(li); });
        block.appendChild(ul);
        return block;
      }
      /** Wynik formatowania: zmiany (z "Cofnij") i uwagi do ręcznej poprawy. */
      function showFormatNote(data) {
        formatNote.innerHTML = '';
        var applied = !!(data.changes && data.changes.length && data.changed);
        var icon = document.createElement('i');
        icon.className = 'bi ' + (applied ? 'bi-magic' : 'bi-info-circle');
        formatNote.appendChild(icon);
        var body = document.createElement('div');
        if (applied) body.appendChild(noteList(data.title || 'Sformatowano pod SEO', data.changes.map(function (change) { return change.label; })));
        else {
          var head = document.createElement('b');
          head.textContent = data.message || 'Nie znalazłem w tekście nic do automatycznego poprawienia.';
          body.appendChild(head);
        }
        if (data.notes && data.notes.length) {
          var extra = noteList('Do poprawy ręcznie', data.notes);
          extra.className = 'gv-formatnote-manual';
          body.appendChild(extra);
        }
        formatNote.appendChild(body);
        if (applied) {
          var undo = document.createElement('button');
          undo.type = 'button';
          undo.className = 'gv-mini-btn';
          undo.innerHTML = '<i class="bi bi-arrow-counterclockwise"></i> Cofnij';
          undo.addEventListener('click', function () {
            content.value = undoContent;
            formatNote.classList.add('d-none');
            fire();
            if (!preview.classList.contains('d-none')) loadPreview();
          });
          formatNote.appendChild(undo);
        }
        if (data.placeholders) {
          var find = document.createElement('button');
          find.type = 'button';
          find.className = 'gv-mini-btn gv-formatnote-find';
          find.innerHTML = '<i class="bi bi-cursor-text"></i> Przejdź do [UZUPEŁNIJ] (' + data.placeholders + ')';
          find.addEventListener('click', findPlaceholder);
          formatNote.appendChild(find);
        }
        formatNote.classList.remove('d-none');
      }
      function runAutoFormat() {
        var button = toolbar.querySelector('[data-cmd="seo"]');
        if (!content.value.trim()) { showFormatNote({ message: 'Najpierw napisz treść wpisu.' }); return; }
        button.disabled = true;
        post('/blog/autoformat', { title: title.value, content: content.value, tags: tags.join(', ') })
          .then(function (data) {
            if (data.changed) {
              undoContent = content.value;
              content.value = data.content;
              fire();
              if (!preview.classList.contains('d-none')) loadPreview();
            } else {
              data.message = 'Tekst jest już dobrze sformatowany - nie ma czego zmieniać automatycznie.';
            }
            showFormatNote(data);
          })
          .catch(function () { showFormatNote({ message: 'Nie udało się sformatować tekstu. Spróbuj ponownie.' }); })
          .then(function () { button.disabled = false; });
      }
      commands.seo = runAutoFormat;

      /* ------------------- pomocnik pisania: artykuł z zadania ------------------- */
      var writerState = { games: [], result: null, busy: false };
      var writerFields = { topic: $('writerTopic'), points: $('writerPoints'), keyword: $('writerKeyword'), tone: $('writerTone'), length: $('writerLength'), faq: $('writerFaq') };
      var writerMaxGames = 5;

      function writerType() {
        var checked = document.querySelector('input[name="writerType"]:checked');
        return checked ? checked.value : 'guide';
      }
      function writerSays(text) {
        var box = $('writerError');
        box.textContent = text || '';
        show(box, !!text);
      }
      function renderWriterGames() {
        var box = $('writerGames');
        box.innerHTML = '';
        writerState.games.forEach(function (game, index) {
          var chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'gv-writer-game';
          chip.title = 'Usuń grę z zadania';
          var label = document.createElement('span');
          label.textContent = game.title;
          var icon = document.createElement('i');
          icon.className = 'bi bi-x-lg';
          chip.appendChild(label);
          chip.appendChild(icon);
          chip.addEventListener('click', function () { writerState.games.splice(index, 1); renderWriterGames(); });
          box.appendChild(chip);
        });
      }
      bindGameSearch($('writerGameSearch'), $('writerGameList'), function (game) {
        var id = String(game.id);
        if (writerState.games.length < writerMaxGames && !writerState.games.some(function (item) { return item.id === id; })) {
          writerState.games.push({ id: id, title: game.title });
          renderWriterGames();
        }
        $('writerGameList').innerHTML = '';
        $('writerGameSearch').value = '';
      });

      function writerStep(showResult) {
        show($('writerPaneForm'), !showResult);
        show($('writerPaneResult'), showResult);
        show($('writerGenerate'), !showResult);
        show($('writerBack'), showResult);
        show($('writerRegenerate'), showResult);
        show($('writerInsert'), showResult);
        show($('writerAppend'), showResult && !!content.value.trim());
        $('writerInsert').innerHTML = '<i class="bi bi-check-lg"></i> ' + (content.value.trim() ? 'Zastąp treść w edytorze' : 'Wstaw do edytora');
      }
      function openWriter() {
        if (!writerFields.topic.value.trim() && title.value.trim()) writerFields.topic.value = title.value.trim();
        writerSays('');
        show($('writerProgress'), false);
        writerStep(false);
        modal('writerModal').show();
      }
      $('writerModal').addEventListener('shown.bs.modal', function () { if (!$('writerPaneForm').classList.contains('d-none')) writerFields.topic.focus(); });
      $('writerOpen').addEventListener('click', openWriter);
      $('writerBack').addEventListener('click', function () { writerStep(false); });

      function writerPayload() {
        return {
          topic: writerFields.topic.value.trim(),
          type: writerType(),
          points: writerFields.points.value,
          games: writerState.games.map(function (game) { return game.id; }),
          keyword: writerFields.keyword.value.trim(),
          tone: writerFields.tone.value,
          length: writerFields.length.value,
          faq: writerFields.faq.checked,
          images: $('writerImages').checked,
          video: $('writerVideo').checked,
          research: $('writerResearch').checked,
          screenshots: $('writerScreens').checked
        };
      }

      function showWriterResult(data) {
        writerState.result = data;
        $('writerResTitle').value = data.title || '';
        $('writerResExcerpt').value = data.excerpt || '';
        $('writerResContent').value = data.content || '';

        var badge = $('writerBadge');
        badge.className = 'gv-writer-badge ' + (data.mode === 'ai' ? 'ai' : 'skeleton');
        badge.innerHTML = data.mode === 'ai' ? '<i class="bi bi-stars"></i> Napisała AI' : '<i class="bi bi-list-check"></i> Szkielet bez AI';
        $('writerWords').textContent = data.words + ' słów';
        var scoreBox = $('writerScore');
        var score = data.analysis ? data.analysis.score : null;
        scoreBox.textContent = score === null ? '' : 'Ocena SEO: ' + score + '/100';
        scoreBox.className = 'gv-writer-score ' + (score >= 75 ? 'good' : score >= 50 ? 'mid' : 'low');

        var notes = $('writerNotes');
        notes.innerHTML = '';
        (data.notes || []).forEach(function (note) {
          var li = document.createElement('li');
          var icon = document.createElement('i');
          icon.className = 'bi bi-info-circle';
          var text = document.createElement('span');
          text.textContent = note;
          li.appendChild(icon);
          li.appendChild(text);
          notes.appendChild(li);
        });

        var tagBox = $('writerResTags');
        tagBox.innerHTML = '';
        (data.tags || []).forEach(function (tag) {
          var chip = document.createElement('span');
          chip.className = 'gv-writer-tag';
          chip.textContent = '#' + tag;
          tagBox.appendChild(chip);
        });

        var mediaInfo = $('writerMediaInfo');
        mediaInfo.innerHTML = '';
        var found = data.media || {};
        function mediaChip(icon, text) {
          var chip = document.createElement('span');
          var glyph = document.createElement('i');
          glyph.className = 'bi ' + icon;
          chip.appendChild(glyph);
          chip.appendChild(document.createTextNode(' ' + text));
          mediaInfo.appendChild(chip);
        }
        if (found.images && found.images.length) mediaChip('bi-image', 'Zdjęcia: ' + found.images.length + ' (autor i licencja w podpisach)');
        if (found.video) mediaChip('bi-youtube', 'Film: ' + (found.video.title || 'YouTube'));
        if (found.sources) mediaChip('bi-search', 'Źródła z internetu: ' + found.sources);
        mediaInfo.classList.toggle('d-none', !mediaInfo.childNodes.length);

        writerTab('preview');
        writerStep(true);
        refreshWriterPreview();
      }

      function writerTab(name) {
        document.querySelectorAll('[data-writer-tab]').forEach(function (tab) { tab.classList.toggle('active', tab.dataset.writerTab === name); });
        show($('writerResPreview'), name === 'preview');
        show($('writerResContent'), name === 'text');
        if (name === 'preview') refreshWriterPreview();
      }
      document.querySelectorAll('[data-writer-tab]').forEach(function (tab) {
        tab.addEventListener('click', function () { writerTab(tab.dataset.writerTab); });
      });
      function refreshWriterPreview() {
        var box = $('writerResPreview');
        box.innerHTML = '<p class="gv-muted"><i class="bi bi-arrow-repeat gv-spin"></i> Wczytuję podgląd...</p>';
        post('/blog/preview', { content: $('writerResContent').value })
          .then(function (data) { box.innerHTML = data.html || ''; })
          .catch(function () { box.textContent = 'Nie udało się wczytać podglądu.'; });
      }

      var writerStepIcons = { start: 'bi-arrow-repeat gv-spin', done: 'bi-check-circle-fill', skip: 'bi-dash-circle', fail: 'bi-exclamation-triangle' };
      function writerStepUpdate(step) {
        var list = $('writerSteps');
        var item = list.querySelector('[data-step="' + step.id + '"]');
        if (!item) {
          item = document.createElement('li');
          item.dataset.step = step.id;
          item.appendChild(document.createElement('i'));
          item.appendChild(document.createElement('span'));
          item.appendChild(document.createElement('small'));
          list.appendChild(item);
        }
        item.className = 'st-' + step.status;
        item.querySelector('i').className = 'bi ' + (writerStepIcons[step.status] || 'bi-dot');
        item.querySelector('span').textContent = step.label;
        item.querySelector('small').textContent = step.detail ? ' - ' + step.detail : '';
      }

      /** Odczytuje odpowiedź w formacie NDJSON: linie z postępem, a na końcu wynik (albo błąd). */
      function readWriterStream(response) {
        var buffer = '';
        var result = null;
        function handle(line) {
          if (!line.trim()) return;
          var message;
          try { message = JSON.parse(line); } catch (err) { return; }
          if (message.type === 'step') writerStepUpdate(message);
          else if (message.type === 'done') result = message.result;
          else if (message.type === 'error') throw new Error(message.error);
        }
        function finish() {
          if (buffer.trim()) handle(buffer);
          if (!result) throw new Error('Nie udało się wygenerować artykułu. Spróbuj ponownie.');
          return result;
        }
        if (!response.body || !response.body.getReader) {
          return response.text().then(function (text) { text.split('\n').forEach(handle); return finish(); });
        }
        var reader = response.body.getReader();
        var decoder = new TextDecoder('utf-8');
        function pump() {
          return reader.read().then(function (chunk) {
            if (chunk.done) return finish();
            buffer += decoder.decode(chunk.value, { stream: true });
            var lines = buffer.split('\n');
            buffer = lines.pop();
            lines.forEach(handle);
            return pump();
          });
        }
        return pump();
      }

      function generateArticle() {
        if (writerState.busy) return;
        var payload = writerPayload();
        if (payload.topic.length < 3) {
          writerStep(false);
          writerSays('Napisz, o czym ma być artykuł (co najmniej 3 znaki).');
          writerFields.topic.focus();
          return;
        }
        writerState.busy = true;
        writerStep(false);
        writerSays('');
        $('writerSteps').innerHTML = '';
        show($('writerProgress'), true);
        var generate = $('writerGenerate');
        generate.disabled = true;
        fetch('/blog/write', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/x-ndjson' }, body: JSON.stringify(payload) })
          .then(function (response) {
            var streaming = /ndjson/i.test(response.headers.get('content-type') || '');
            if (response.ok && streaming) return readWriterStream(response);
            return response.json().catch(function () { return {}; }).then(function (data) {
              if (!response.ok) throw new Error(data.error || data.message || 'Nie udało się wygenerować artykułu.');
              return data;
            });
          })
          .then(showWriterResult)
          .catch(function (err) { writerSays(/failed to fetch|networkerror|load failed/i.test(err.message) ? 'Brak połączenia z serwerem. Spróbuj ponownie.' : err.message); })
          .then(function () {
            writerState.busy = false;
            generate.disabled = false;
            show($('writerProgress'), false);
          });
      }
      $('writerGenerate').addEventListener('click', generateArticle);
      $('writerRegenerate').addEventListener('click', generateArticle);

      /** Wstawia tekst do edytora tak, żeby Ctrl+Z działał (execCommand), a gdy się nie uda - zwykłym przypisaniem. */
      function setEditorText(text) {
        content.focus();
        content.select();
        var done = false;
        try { done = document.execCommand('insertText', false, text); } catch (err) { done = false; }
        if (!done || content.value !== text) content.value = text;
        fire();
      }
      function setField(input, value) {
        input.value = value;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
      function applyWriterResult(append) {
        var result = writerState.result;
        if (!result) return;
        var text = $('writerResContent').value.trim();
        if (!text) return;
        var hadText = !!content.value.trim();
        undoContent = content.value;
        setEditorText(append && hadText ? content.value.replace(/\s+$/, '') + '\n\n' + text : text);

        var changes = ['Treść: ' + words(text) + ' słów'];
        if ($('writerApplyMeta').checked) {
          var newTitle = $('writerResTitle').value.trim();
          var newExcerpt = $('writerResExcerpt').value.trim();
          // Dopisując do istniejącego tekstu, nie nadpisujemy tytułu i opisu, które autor już ma.
          if (newTitle && (!append || !hadText || !title.value.trim())) { setField(title, newTitle); changes.push('Tytuł wpisu'); }
          if (newExcerpt && (!append || !hadText || !excerpt.value.trim())) { setField(excerpt, newExcerpt); changes.push('Krótki opis'); }
          if (result.tags && result.tags.length) { addTag(result.tags.join(',')); changes.push('Tagi'); }
          if (result.category && !append) {
            var radio = form.querySelector('input[name="category"][value="' + result.category + '"]');
            if (radio && !radio.checked) { radio.checked = true; radio.dispatchEvent(new Event('change', { bubbles: true })); changes.push('Kategoria: ' + result.category); }
          }
        }

        modal('writerModal').hide();
        var writeTab = document.querySelector('[data-tab="write"]');
        if (writeTab && !writeTab.classList.contains('active')) writeTab.click();
        var left = (content.value.match(/\[UZUPE[ŁL]NIJ[^\]\n]*\]/gi) || []).length;
        showFormatNote({
          changed: true,
          title: result.mode === 'ai' ? 'Wstawiono artykuł napisany przez AI' : 'Wstawiono szkielet artykułu',
          changes: changes.map(function (label) { return { label: label }; }),
          notes: (result.notes || []).filter(function (note) { return !/^To szkielet bez AI|^Tekst napisała AI/.test(note); }),
          placeholders: left
        });
        formatNote.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      $('writerInsert').addEventListener('click', function () { applyWriterResult(false); });
      $('writerAppend').addEventListener('click', function () { applyWriterResult(true); });

      /** Zaznacza kolejne miejsce oznaczone [UZUPEŁNIJ: ...] (od kursora, potem od początku). */
      function findPlaceholder() {
        var pattern = /\[UZUPE[ŁL]NIJ[^\]\n]*\]/gi;
        var value = content.value;
        var from = content.selectionEnd || 0;
        var match = null;
        var found;
        while ((found = pattern.exec(value))) {
          if (found.index >= from) { match = found; break; }
          if (!match) match = found;
        }
        if (!match) { showFormatNote({ message: 'Nie ma już miejsc oznaczonych [UZUPEŁNIJ: ...].' }); return; }
        var line = value.slice(0, match.index).split('\n').length - 1;
        content.focus();
        content.setSelectionRange(match.index, match.index + match[0].length);
        var height = parseFloat(getComputedStyle(content).lineHeight) || 24;
        content.scrollTop = Math.max(0, line * height - content.clientHeight / 3);
      }
      commands.todo = findPlaceholder;


      renderTags();
      refreshMode();
      refreshCover();
      refreshPreview();
      loadAutoCover();
      runAssist();
    });
  </script>

  <%- include('../partials/footer') %>
</body>
</html>
