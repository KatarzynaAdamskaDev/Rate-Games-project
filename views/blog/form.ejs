<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/app-extra.css" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <%
    const editing = !!post;
    const publishMode = formData.publishMode || 'now';
    const publishAtIso = formData.publishAtIso || formData.publishAt || '';
    const alreadyPublished = editing && post.state === 'published';
    const cover = formData.coverImage || formData.coverUrl || '';
    const hasCover = !!cover && cover !== '/images/game-placeholder.svg';
    const isUploaded = cover.indexOf('/images/blog/uploads/') === 0;
    const currentCategory = categories.indexOf(formData.category) !== -1 ? formData.category : 'Aktualności';
    // Po nieudanym zapisie wracamy do wyboru użytkownika (odznaczone pole nie jest wysyłane, stąd znacznik autoCoverPresent).
    const autoCover = formData.autoCoverPresent === '1' ? formData.autoCover === '1' : autoCoverDefault;
    const coverVariant = parseInt(formData.coverVariant, 10) || 0;
  %>

  <section class="gv-section">
    <div class="wrap gv-blogedit-wrap">
      <a href="<%= editing ? '/blog/' + post.id : '/blog' %>" class="gv-post-back"><i class="bi bi-arrow-left"></i> <%= editing ? 'Wróć do wpisu' : 'Wróć do bloga' %></a>
      <h1 class="gv-page-title mb-4"><%= editing ? 'Edytuj wpis' : 'Nowy wpis na blogu' %></h1>

      <% if (formError) { %>
        <div class="gv-blogform-error"><i class="bi bi-exclamation-triangle-fill"></i> <%= formError %></div>
      <% } %>

      <div class="gv-draft-banner d-none" id="draftBanner" role="status">
        <i class="bi bi-clock-history"></i>
        <span>Znaleziono niezapisany szkic z <b id="draftBannerTime"></b>. Chcesz go przywrócić?</span>
        <button type="button" class="gv-mini-btn" id="draftRestore"><i class="bi bi-arrow-counterclockwise"></i> Przywróć</button>
        <button type="button" class="gv-mini-btn" id="draftDiscard">Odrzuć</button>
      </div>

      <form action="<%= editing ? '/blog/' + post.id + '/edit' : '/blog/new' %>" method="POST" enctype="multipart/form-data" class="gv-gameform gv-blogedit" id="blogForm"
            data-draft-key="<%= editing ? post.id : 'new' %>" data-author="<%= currentUser.username %>" data-max-tags="<%= maxTags %>" data-max-tag-length="<%= maxTagLength %>">
        <div class="gv-gameform-main">

          <section class="gv-admin-card">
            <h2><i class="bi bi-1-circle-fill"></i> Podstawowe informacje</h2>

            <label class="gv-label" for="blogTitle">Tytuł wpisu <span class="gv-counter" id="titleCount">0/<%= maxTitle %></span></label>
            <input type="text" id="blogTitle" name="title" class="form-control gv-input gv-blogedit-title" maxlength="<%= maxTitle %>" value="<%= formData.title || '' %>" placeholder="np. Top 5 gier RPG" required autocomplete="off">

            <span class="gv-label mt-3 d-block">Kategoria</span>
            <div class="gv-chip-check-row" role="radiogroup" aria-label="Kategoria wpisu">
              <% categories.forEach(function(name) { %>
                <label class="gv-chip-check">
                  <input type="radio" name="category" value="<%= name %>" <%= currentCategory === name ? 'checked' : '' %>>
                  <span><%= name %></span>
                </label>
              <% }) %>
            </div>

            <label class="gv-label mt-3" for="tagInput">Tagi <span class="gv-counter" id="tagCount">0/<%= maxTags %></span></label>
            <div class="gv-taginput" id="tagBox">
              <span class="gv-taginput-chips" id="tagChips"></span>
              <input type="text" id="tagInput" maxlength="<%= maxTagLength %>" placeholder="Dodaj tag i Enter" autocomplete="off" aria-label="Nowy tag">
            </div>
            <input type="hidden" name="tags" id="tagsValue" value="<%= formData.tags || '' %>">
            <div class="gv-tagauto d-none" id="tagAuto" aria-live="polite">
              <span class="gv-tagauto-label"><i class="bi bi-stars"></i> Propozycje z treści:</span>
              <span class="gv-tagauto-list" id="tagAutoList"></span>
              <button type="button" class="gv-linkbtn" id="tagAutoAll">Dodaj wszystkie</button>
            </div>
            <% if (suggestedTags.length > 0) { %>
              <div class="gv-taginput-suggest" id="tagSuggest">
                <small>Popularne:</small>
                <% suggestedTags.forEach(function(tag) { %><button type="button" class="gv-taginput-suggestion" data-tag="<%= tag %>">#<%= tag %></button><% }) %>
              </div>
            <% } %>
            <div class="gv-edit-hint">Enter lub przecinek dodaje tag. Czytelnicy znajdą Twój wpis po tagach.</div>
          </section>

          <section class="gv-admin-card">
            <h2><i class="bi bi-2-circle-fill"></i> Treść</h2>

            <div class="gv-blogedit-bar">
              <div class="gv-blogedit-tabs" role="tablist">
                <button type="button" class="active" role="tab" aria-selected="true" data-tab="write"><i class="bi bi-pencil"></i> Pisz</button>
                <button type="button" role="tab" aria-selected="false" data-tab="preview"><i class="bi bi-eye"></i> Podgląd</button>
              </div>
              <button type="button" class="gv-blogedit-writerbtn" id="writerOpen" title="Podaj temat i punkty - pomocnik przygotuje tytuł, opis, tagi i treść pod SEO"><i class="bi bi-stars"></i> Pomocnik pisania</button>
              <span class="gv-blogedit-stats" id="contentStats" aria-live="polite"></span>
            </div>

            <div class="gv-blogedit-toolbar" id="toolbar" role="toolbar" aria-label="Formatowanie">
              <button type="button" data-cmd="h2" title="Śródtytuł"><i class="bi bi-type-h2"></i></button>
              <button type="button" data-cmd="bold" title="Pogrubienie (Ctrl+B)"><i class="bi bi-type-bold"></i></button>
              <button type="button" data-cmd="italic" title="Kursywa (Ctrl+I)"><i class="bi bi-type-italic"></i></button>
              <span class="gv-blogedit-sep"></span>
              <button type="button" data-cmd="ul" title="Lista punktowana"><i class="bi bi-list-ul"></i></button>
              <button type="button" data-cmd="ol" title="Lista numerowana"><i class="bi bi-list-ol"></i></button>
              <button type="button" data-cmd="quote" title="Cytat"><i class="bi bi-quote"></i></button>
              <span class="gv-blogedit-sep"></span>
              <button type="button" data-cmd="link" title="Link (Ctrl+K)"><i class="bi bi-link-45deg"></i></button>
              <button type="button" data-cmd="image" title="Zdjęcie lub infografika (z tekstem alternatywnym)"><i class="bi bi-image"></i></button>
              <button type="button" data-cmd="game" title="Karta gry z katalogu"><i class="bi bi-controller"></i></button>
              <button type="button" data-cmd="video" title="Film z YouTube"><i class="bi bi-youtube"></i></button>
              <span class="gv-blogedit-sep"></span>
              <button type="button" data-cmd="info" title="Ramka: Warto wiedzieć"><i class="bi bi-info-circle"></i></button>
              <button type="button" data-cmd="tip" title="Ramka: Wskazówka"><i class="bi bi-lightbulb"></i></button>
              <button type="button" data-cmd="warning" title="Ramka: Uwaga"><i class="bi bi-exclamation-triangle"></i></button>
              <button type="button" data-cmd="hr" title="Linia pozioma"><i class="bi bi-hr"></i></button>
              <button type="button" data-cmd="todo" title="Przejdź do następnego miejsca oznaczonego [UZUPEŁNIJ: ...]"><i class="bi bi-cursor-text"></i></button>
              <button type="button" data-cmd="seo" class="gv-blogedit-seobtn" title="Pogrubi najważniejsze frazy, doda linki do gier z katalogu oraz uporządkuje listy i nagłówki"><i class="bi bi-magic"></i> Formatuj pod SEO</button>
            </div>

            <textarea id="blogContent" name="content" rows="18" maxlength="<%= maxContent %>" class="form-control gv-input gv-blogedit-textarea" placeholder="Zacznij pisać... Zaznacz tekst i użyj przycisków powyżej, żeby go sformatować." required><%= formData.content || '' %></textarea>
            <div class="gv-post-body gv-blogedit-preview d-none" id="contentPreview" aria-live="polite"></div>
            <div class="gv-blogedit-formatnote d-none" id="formatNote" role="status"></div>

            <details class="gv-blogedit-help">
              <summary><i class="bi bi-question-circle"></i> Ściąga formatowania</summary>
              <p>
                Pusta linia rozdziela akapity. <code>## Śródtytuł</code> · <code>- punkt listy</code> · <code>1. punkt</code> ·
                <code>&gt; cytat</code> · <code>**pogrubienie**</code> · <code>*kursywa*</code> · <code>[tekst](https://adres)</code>
              </p>
            </details>
          </section>

          <section class="gv-admin-card">
            <h2><i class="bi bi-3-circle-fill"></i> Okładka i zajawka</h2>

            <div class="gv-autocover" id="autoCoverPanel">
              <label class="gv-switch">
                <input type="checkbox" name="autoCover" value="1" id="autoCover" <%= autoCover ? 'checked' : '' %>>
                <input type="hidden" name="autoCoverPresent" value="1">
                <span class="gv-switch-track"></span>
                <span class="gv-switch-text"><b><i class="bi bi-stars"></i> Utwórz okładkę automatycznie</b><small>Grafika 1200×630 powstanie z tytułu, kategorii i tagów - nic nie musisz wgrywać. Sprawdza się też jako podgląd linku.</small></span>
              </label>
              <input type="hidden" name="coverVariant" id="coverVariant" value="<%= coverVariant %>">
              <div class="gv-autocover-body <%= autoCover ? '' : 'd-none' %>" id="autoCoverBody">
                <div class="gv-autocover-frame">
                  <img id="autoCoverImg" src="/images/game-placeholder.svg" alt="Podgląd automatycznej okładki">
                  <span class="gv-autocover-hint" id="autoCoverHint">Wpisz tytuł, a okładka powstanie sama.</span>
                </div>
                <div class="gv-autocover-actions">
                  <button type="button" class="gv-btn-outline" id="autoCoverShuffle"><i class="bi bi-shuffle"></i> Inny wariant</button>
                  <small>Zapisze się razem z wpisem. Kolory zależą od kategorii, wzór - od tytułu.</small>
                </div>
              </div>
            </div>

            <p class="gv-blogedit-or"><span>albo własna okładka</span></p>

            <label class="gv-dropzone" for="blogCover" id="blogDropzone">
              <i class="bi bi-cloud-arrow-up-fill"></i>
              <b>Przeciągnij zdjęcie tutaj albo kliknij, aby wybrać</b>
              <small>PNG, JPG, WEBP lub GIF, do 3 MB. Obraz zostanie sprawdzony i zmniejszony automatycznie.</small>
              <span class="gv-dropzone-file" id="blogFileName"></span>
            </label>
            <input type="file" id="blogCover" name="cover" accept="image/png,image/jpeg,image/webp,image/gif" class="gv-visually-hidden">

            <div class="gv-blogedit-coverrow">
              <button type="button" class="gv-linkbtn" id="coverUrlToggle"><i class="bi bi-link-45deg"></i> Użyj adresu obrazka zamiast pliku</button>
              <% if (editing && hasCover) { %>
                <label class="gv-check">
                  <input type="checkbox" name="removeCover" value="1" id="blogRemoveCover">
                  <span>Usuń okładkę (użyj domyślnej)</span>
                </label>
              <% } %>
            </div>
            <% const showUrl = !isUploaded && hasCover; %>
            <div class="<%= showUrl ? '' : 'd-none' %>" id="coverUrlBox">
              <input type="text" id="blogCoverUrl" name="coverUrl" class="form-control gv-input" placeholder="https://..." value="<%= showUrl ? cover : '' %>">
            </div>

            <hr class="gv-blogedit-hr">

            <label class="gv-label" for="blogExcerpt">Krótki opis <span class="gv-counter" id="excerptCount">0/<%= maxExcerpt %></span></label>
            <div class="gv-blogedit-excerptrow">
              <input type="text" id="blogExcerpt" name="excerpt" class="form-control gv-input" maxlength="<%= maxExcerpt %>" value="<%= formData.excerpt || '' %>" placeholder="Jedno-dwa zdania" autocomplete="off">
              <button type="button" class="gv-btn-outline" id="excerptAuto" title="Utwórz opis z początku treści"><i class="bi bi-magic"></i> Z treści</button>
            </div>
            <div class="gv-edit-hint">Widoczny na liście i w podglądzie linku. Zostaw puste, a powstanie z początku treści.</div>
          </section>

          <section class="gv-admin-card">
            <h2><i class="bi bi-4-circle-fill"></i> Publikacja</h2>

            <div class="gv-publish-options gv-publish-grid" role="radiogroup" aria-label="Publikacja wpisu">
              <label class="gv-publish-option">
                <input type="radio" name="publishMode" value="now" <%= publishMode === 'now' ? 'checked' : '' %>>
                <span>
                  <b><i class="bi bi-broadcast"></i> <%= alreadyPublished ? 'Opublikowany' : 'Opublikuj od razu' %></b>
                  <small><%= alreadyPublished ? 'Wpis jest widoczny dla wszystkich.' : 'Wpis pojawi się na blogu natychmiast.' %></small>
                </span>
              </label>
              <label class="gv-publish-option">
                <input type="radio" name="publishMode" value="draft" <%= publishMode === 'draft' ? 'checked' : '' %>>
                <span>
                  <b><i class="bi bi-file-earmark-text"></i> Szkic</b>
                  <small>Zapisz bez publikowania - widzą go tylko administratorzy.</small>
                </span>
              </label>
              <label class="gv-publish-option">
                <input type="radio" name="publishMode" value="schedule" <%= publishMode === 'schedule' ? 'checked' : '' %>>
                <span>
                  <b><i class="bi bi-calendar-event"></i> Zaplanuj publikację</b>
                  <small>Wpis pojawi się sam o wybranej porze.</small>
                </span>
              </label>
            </div>

            <div class="gv-publish-schedule <%= publishMode === 'schedule' ? '' : 'd-none' %>" id="scheduleBox">
              <label class="gv-label" for="publishAtLocal">Data i godzina publikacji</label>
              <div class="gv-blogedit-schedulerow">
                <input type="datetime-local" id="publishAtLocal" name="publishAtLocal" class="form-control gv-input" data-iso="<%= publishAtIso %>">
                <button type="button" class="gv-btn-outline" data-quick="hour">Za godzinę</button>
                <button type="button" class="gv-btn-outline" data-quick="tomorrow">Jutro 9:00</button>
                <button type="button" class="gv-btn-outline" data-quick="week">Za tydzień 9:00</button>
              </div>
              <input type="hidden" name="publishAt" id="publishAtIso" value="<%= publishAtIso %>">
              <div class="gv-edit-hint">Godzina w Twojej strefie czasowej. Wpis staje się publiczny automatycznie, bez dodatkowych kroków.</div>
            </div>
          </section>

          <div class="gv-admin-form-actions">
            <button type="submit" class="btn gv-btn-success" id="blogSubmit" data-editing="<%= alreadyPublished ? '1' : '' %>"><i class="bi bi-check-lg"></i> <span id="blogSubmitLabel"><%= editing ? 'Zapisz zmiany' : 'Opublikuj' %></span></button>
            <a href="<%= editing ? '/blog/' + post.id : '/blog' %>" class="gv-btn-outline" id="blogCancel">Anuluj</a>
          </div>
        </div>

        <aside class="gv-gameform-side">
          <div class="gv-gameform-preview">
            <span class="gv-label">Podgląd na liście bloga</span>
            <article class="gv-blog-tile gv-blogedit-tile">
              <div class="gv-blog-tile-img"><img id="pvCover" src="<%= hasCover ? cover : '/images/game-placeholder.svg' %>" alt=""></div>
              <div class="gv-blog-tile-body">
                <div class="gv-blog-meta">
                  <span class="gv-blog-badge" id="pvCategory"><%= currentCategory %></span>
                  <span id="pvDate"></span>
                </div>
                <h3 class="gv-blog-tile-title" id="pvTitle">Tytuł wpisu</h3>
                <p class="gv-blog-tile-excerpt" id="pvExcerpt"></p>
                <div class="gv-blog-tile-tags" id="pvTags"></div>
                <div class="gv-blog-foot">
                  <span id="pvAuthor"></span>
                  <span><i class="bi bi-clock"></i> <span id="pvRead">1</span> min</span>
                </div>
              </div>
            </article>

            <ul class="gv-blogedit-checks" id="checklist" aria-label="Lista kontrolna">
              <li data-check="title"><i class="bi bi-circle"></i> <span>Tytuł</span></li>
              <li data-check="content"><i class="bi bi-circle"></i> <span>Treść</span></li>
              <li data-check="cover"><i class="bi bi-circle"></i> <span>Okładka</span></li>
              <li data-check="tags"><i class="bi bi-circle"></i> <span>Tagi</span></li>
            </ul>

            <div class="gv-seo-panel" id="seoPanel">
              <div class="gv-seo-head">
                <b><i class="bi bi-graph-up-arrow"></i> Ocena SEO</b>
                <span class="gv-seo-score" id="seoScore">-</span>
              </div>
              <div class="gv-seo-bar"><span id="seoBar"></span></div>
              <p class="gv-seo-primary d-none" id="seoPrimary"></p>
              <ul class="gv-seo-checks" id="seoChecks"></ul>
            </div>
          </div>
        </aside>
      </form>
    </div>
  </section>

  <!-- Okna edytora: zdjęcia i infografiki, linki, karty gier i filmy -->
  <div class="modal fade" id="mediaModal" tabindex="-1" aria-labelledby="mediaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content gv-modal-content">
        <div class="modal-header gv-modal-header">
          <h2 class="gv-auth-title mb-0" id="mediaModalLabel"><i class="bi bi-image"></i> Wstaw zdjęcie lub infografikę</h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>
        <div class="modal-body">
          <div id="mediaStepPick">
            <div class="gv-blogedit-tabs mb-3" role="tablist">
              <button type="button" class="active" data-media-tab="upload"><i class="bi bi-cloud-arrow-up"></i> Wgraj</button>
              <button type="button" data-media-tab="library"><i class="bi bi-images"></i> Biblioteka</button>
              <button type="button" data-media-tab="url"><i class="bi bi-link-45deg"></i> Adres URL</button>
            </div>

            <div id="mediaPaneUpload">
              <label class="gv-dropzone" for="mediaFile" id="mediaDropzone">
                <i class="bi bi-cloud-arrow-up-fill"></i>
                <b>Przeciągnij zdjęcie lub infografikę albo kliknij, aby wybrać</b>
                <small>PNG, JPG, WEBP lub GIF, do 8 MB. Obraz zostanie sprawdzony i zoptymalizowany (WebP). Możesz też wkleić obraz ze schowka bezpośrednio w treść wpisu.</small>
              </label>
              <input type="file" id="mediaFile" accept="image/png,image/jpeg,image/webp,image/gif" class="gv-visually-hidden">
            </div>

            <div id="mediaPaneLibrary" class="d-none">
              <div class="gv-media-grid" id="mediaGrid"></div>
              <p class="gv-muted gv-media-empty d-none" id="mediaEmpty">Biblioteka jest jeszcze pusta - wgraj pierwsze zdjęcie.</p>
            </div>

            <div id="mediaPaneUrl" class="d-none">
              <label class="gv-label" for="mediaUrl">Adres obrazka (https://... albo /images/...)</label>
              <div class="gv-blogedit-excerptrow">
                <input type="text" id="mediaUrl" class="form-control gv-input" placeholder="https://..." autocomplete="off">
                <button type="button" class="gv-btn-outline" id="mediaUrlUse">Użyj</button>
              </div>
              <div class="gv-edit-hint">Zdjęcie z cudzej strony może zniknąć albo być chronione prawem autorskim - najlepiej wgraj własny plik.</div>
            </div>

            <div class="gv-media-status d-none" id="mediaStatus" role="status"></div>
          </div>

          <div id="mediaStepDetails" class="d-none">
            <div class="gv-media-details">
              <div class="gv-media-preview"><img id="mediaPreview" alt="Podgląd wstawianego zdjęcia"></div>
              <div class="gv-media-fields">
                <label class="gv-label" for="mediaAlt">Tekst alternatywny (opis zdjęcia) <span class="gv-counter" id="mediaAltCount">0/200</span></label>
                <input type="text" id="mediaAlt" class="form-control gv-input" maxlength="200" placeholder="np. Mapa Limgrave z zaznaczonymi lokacjami bossów" autocomplete="off">
                <div class="gv-edit-hint">Opisz, co widać na zdjęciu. Czytają to wyszukiwarki i czytniki ekranu, a zdjęcie bez opisu słabiej działa w SEO.
                  <button type="button" class="gv-linkbtn" id="mediaAltSuggest">Podpowiedz z tytułu wpisu</button></div>

                <label class="gv-label mt-3" for="mediaCaption">Podpis pod zdjęciem (opcjonalnie)</label>
                <input type="text" id="mediaCaption" class="form-control gv-input" maxlength="200" placeholder="np. Źródło: własny zrzut ekranu" autocomplete="off">

                <label class="gv-label mt-3" for="mediaLayout">Układ</label>
                <select id="mediaLayout" class="form-select gv-select">
                  <option value="">Standardowy (na środku)</option>
                  <option value="wide">Szeroki - pełna szerokość (dobry dla infografik)</option>
                  <option value="small">Mały (połowa szerokości)</option>
                  <option value="left">Do lewej, tekst opływa</option>
                  <option value="right">Do prawej, tekst opływa</option>
                </select>
                <div class="gv-media-error d-none" id="mediaError" role="alert"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer gv-modal-footer">
          <button type="button" class="btn gv-btn-ghost d-none" id="mediaBack"><i class="bi bi-arrow-left"></i> Wróć</button>
          <button type="button" class="btn gv-btn-ghost" data-bs-dismiss="modal">Anuluj</button>
          <button type="button" class="btn gv-btn-success d-none" id="mediaInsert"><i class="bi bi-check-lg"></i> Wstaw do treści</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="linkModal" tabindex="-1" aria-labelledby="linkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content gv-modal-content">
        <div class="modal-header gv-modal-header">
          <h2 class="gv-auth-title mb-0" id="linkModalLabel"><i class="bi bi-link-45deg"></i> Wstaw link</h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>
        <div class="modal-body">
          <label class="gv-label" for="linkText">Tekst linku</label>
          <input type="text" id="linkText" class="form-control gv-input" placeholder="np. oficjalna strona gry" autocomplete="off">
          <label class="gv-label mt-3" for="linkUrl">Adres</label>
          <input type="text" id="linkUrl" class="form-control gv-input" placeholder="https://... albo /games/123" autocomplete="off">
          <div class="gv-edit-hint">Link zewnętrzny otworzy się w nowej karcie, link do gry z katalogu - w tej samej.</div>

          <label class="gv-label mt-3" for="linkGameSearch">albo znajdź grę w katalogu GameVerse</label>
          <input type="search" id="linkGameSearch" class="form-control gv-input" placeholder="Wpisz tytuł gry..." autocomplete="off">
          <ul class="gv-gamepick" id="linkGameList"></ul>
          <div class="gv-media-error d-none" id="linkError" role="alert"></div>
        </div>
        <div class="modal-footer gv-modal-footer">
          <button type="button" class="btn gv-btn-ghost" data-bs-dismiss="modal">Anuluj</button>
          <button type="button" class="btn gv-btn-success" id="linkInsert"><i class="bi bi-check-lg"></i> Wstaw link</button>
        </div>
      </div>
    </div>
  </div>

