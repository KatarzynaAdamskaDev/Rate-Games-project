<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/app-extra.css" />
</head>
<body>

  <%- include('partials/navbar') %>
  <%- include('partials/flash') %>

<section class="hero gv-hero">
  <div class="hero-bg"></div>
  <div class="wrap hero-inner gv-hero-card">
    <span class="eyebrow-pixel">GAMERS COMMUNITY</span>
    <h1 class="gv-hero-title">Pisz recenzje gier, <span>obserwuj graczy</span> i rozmawiaj o tym, w co właśnie grasz</h1>
    <p class="gv-hero-text">GameVerse to portal z recenzjami gier PC, PS5, Xbox i Nintendo Switch — dodawaj tytuły do ulubionych, komentuj opinie innych graczy i czatuj ze znajomymi w czasie rzeczywistym.</p>
    <div class="hero-ctas">
      <button
            type="button"
            class="btn-primary hero-cta"
            data-bs-toggle="modal"
            data-bs-target="#signInModal"
          >Napisz swoją pierwszą recenzję</button>
    </div>
    <div class="hero-stats">
      <div><b>48 200+</b><span>recenzji gier</span></div>
      <div><b>12 900</b><span>aktywnych graczy</span></div>
      <div><b>3 400</b><span>gier w bazie</span></div>
    </div>
  </div>
</section>

<div class="seo-intro">
  <div class="wrap">
    <p><strong>GameVerse</strong> to miejsce, w którym gracze PC i konsolowi dzielą się opiniami o najnowszych premierach — od recenzji gier akcji i RPG, przez opinie o grach indie, po rankingi najlepszych gier na PS5, Xbox Series X i Nintendo Switch. Dodawaj recenzje gier do ulubionych, obserwuj innych recenzentów i dołączaj do rozmów na czacie o grach wideo, zamiast szukać opinii na rozproszonych forach dla graczy.</p>
  </div>
</div>

<section id="kategorie">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Recenzje gier według platformy</h2>
        <p>Wybierz platformę i przejdź do opinii graczy o najnowszych tytułach na PC i konsole.</p>
      </div>
    </div>
    <div class="platform-grid">
  <a class="platform-card" href="/category/?platform=pc">
    <div class="pf-icon"><i class="bi bi-pc-display"></i></div>
    <b>Gry PC</b><span>recenzje i wymagania</span>
  </a>
  <a class="platform-card" href="/category/?platform=ps5">
    <div class="pf-icon"><i class="bi bi-playstation"></i></div>
    <b>Gry na PS5</b><span>opinie graczy</span>
  </a>
  <a class="platform-card" href="/category/?platform=xbox">
    <div class="pf-icon"><i class="bi bi-xbox"></i></div>
    <b>Gry na Xbox</b><span>Series X/S</span>
  </a>
  <a class="platform-card" href="/category/?platform=switch">
    <div class="pf-icon"><i class="bi bi-controller"></i></div>
    <b>Nintendo Switch</b><span>gry przygodowe</span>
  </a>
  <a class="platform-card" href="/category/?platform=mobile">
    <div class="pf-icon"><i class="bi bi-phone"></i></div>
    <b>Gry mobilne</b><span>Android i iOS</span>
  </a>
  <a class="platform-card" href="/category/?platform=vr">
    <div class="pf-icon"><i class="bi bi-badge-vr"></i></div>
    <b>Gry VR</b><span>nowa kategoria</span>
  </a>
</div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Najczęściej recenzowane gry tego tygodnia</h2>
        <p>Ranking gier na podstawie liczby recenzji i ocen dodanych przez społeczność w ostatnich 7 dniach.</p>
      </div>
      <a class="see-all" href="/games">Zobacz pełny ranking →</a>
    </div>
    <div class="trend-scroll">
      <% if (locals.games && games.length > 0) { %>
        <% games.forEach((game, idx) => { %>
          <article class="trend-card">
            <div class="trend-cover" style="background-image: url('<%= game.coverImage || '' %>');">
              <span class="rank-badge">#<%= idx + 1 %></span>
            </div>
            <div class="trend-body">
              <b><a href="/games/<%= game.id %>"><%= game.title %></a></b>
              <div class="meta"><%= game.category %> · <%= game.platform || 'PC, PS5' %></div>
              <div class="rating">
                <% if (game.averageRating) { %>
                  <%- include('partials/star-rating', { rating: game.averageRating }) %>
                  <%= game.averageRating.toFixed(1) %>
                <% } else { %>
                  <span class="gv-game-card-count">Brak ocen</span>
                <% } %>
              </div>
            </div>
          </article>
        <% }); %>
      <% } else { %>
        <article class="trend-card"><div class="trend-cover"><span class="rank-badge">#1</span></div><div class="trend-body"><b>Cinderfall Requiem</b><div class="meta">RPG akcji · PC, PS5</div><div class="rating">★★★★★ 4.8 (2 130 ocen)</div></div></article>
        <article class="trend-card"><div class="trend-cover"><span class="rank-badge">#2</span></div><div class="trend-body"><b>Northreach Colony</b><div class="meta">Strategia · PC</div><div class="rating">★★★★☆ 4.4 (980 ocen)</div></div></article>
        <article class="trend-card"><div class="trend-cover"><span class="rank-badge">#3</span></div><div class="trend-body"><b>Static Horizon</b><div class="meta">FPS · Xbox, PC</div><div class="rating">★★★★☆ 4.2 (1 450 ocen)</div></div></article>
        <article class="trend-card"><div class="trend-cover"><span class="rank-badge">#4</span></div><div class="trend-body"><b>Wanderhome</b><div class="meta">Gra przygodowa · Switch</div><div class="rating">★★★★★ 4.9 (760 ocen)</div></div></article>
      <% } %>
    </div>
  </div>
</section>

<section id="recenzje">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Najnowsze recenzje graczy</h2>
        <p>Opinie o grach dodane przez społeczność GameVerse — polub, skomentuj lub dodaj recenzenta do obserwowanych.</p>
      </div>
    </div>

    <div class="content-grid">
      <div class="review-list">

        <% if (locals.latestReviews && latestReviews.length > 0) { %>
          <% latestReviews.forEach(review => { %>
            <article class="review-card gv-review-item">
              <div class="review-top">
                <div class="review-cover" style="background-image: url('<%= review.gameImage || '' %>');"></div>
                <div class="review-headline">
                  <span class="game-title"><%= review.gameTitle %><span class="platform-tag"><%= review.platform || 'PC / PS5' %></span></span>
                  <span class="gv-review-rating-badge mt-1">
                    <% const rStars = Math.round(review.rating || 5); %>
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="bi <%= i <= rStars ? 'bi-star-fill' : 'bi-star' %>"></i>
                    <% } %>
                  </span>
                </div>
                <button class="follow-pill">Obserwuj</button>
              </div>
              <div class="gv-review-meta-row">
                <a href="/<%= review.username || '' %>" class="gv-chat-name-link gv-review-byline">Review by: <strong><%= review.username || 'Anonim' %></strong></a>
                <span class="gv-review-date"><%= review.createdAt ? new Date(review.createdAt).toLocaleDateString('pl-PL') : 'niedawno' %></span>
              </div>
              <p class="review-text gv-review-text"><%= review.comment %></p>
              <div class="tag-row">
                <span class="tag"><%= review.category || 'Gry Akcji' %></span>
                <span class="tag">Polecane</span>
              </div>
              <div class="review-actions gv-review-actions">
                <button class="action-btn gv-icon-btn"><i class="bi bi-heart"></i><span class="gv-count"><%= review.likesCount || 0 %></span></button>
                <button class="action-btn gv-icon-btn"><i class="bi bi-chat-dots"></i><span class="gv-count"><%= review.commentsCount || 0 %></span> komentarzy</button>
                <button class="action-btn gv-icon-btn"><i class="bi bi-share"></i> Udostępnij</button>
                <button class="action-btn gv-icon-btn"><i class="bi bi-star"></i> Do ulubionych</button>
              </div>
            </article>
          <% }); %>
        <% } else { %>
          <article class="review-card gv-review-item">
            <div class="review-top">
              <div class="review-cover"></div>
              <div class="review-headline">
                <span class="game-title">Cinderfall Requiem<span class="platform-tag">PC / PS5</span></span>
                <span class="gv-review-rating-badge mt-1"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></span>
              </div>
              <button class="follow-pill following">Obserwujesz</button>
            </div>
            <div class="gv-review-meta-row">
              <a href="/Marta_K" class="gv-chat-name-link gv-review-byline">Review by: <strong>Marta_K</strong></a>
              <span class="gv-review-date">3 godziny temu</span>
            </div>
            <p class="review-text gv-review-text">Świat gry wciąga od pierwszej minuty, a system walki nagradza eksperymentowanie z buildami postaci. Największym zaskoczeniem jest fabuła poboczna — momentami lepsza niż wątek główny.</p>
            <div class="tag-row">
              <span class="tag">RPG akcji</span><span class="tag">Open world</span><span class="tag">Bez mikropłatności</span>
            </div>
            <div class="review-actions gv-review-actions">
              <button class="action-btn gv-icon-btn liked"><i class="bi bi-heart-fill"></i><span class="gv-count">214</span></button>
              <button class="action-btn gv-icon-btn"><i class="bi bi-chat-dots"></i><span class="gv-count">38</span> komentarzy</button>
              <button class="action-btn gv-icon-btn"><i class="bi bi-share"></i> Udostępnij</button>
              <button class="action-btn gv-icon-btn"><i class="bi bi-star"></i> Do ulubionych</button>
            </div>
            <div class="comment-preview"><b>Tomek89:</b> Zgadzam się co do wątku pobocznego, sekcja w bagnach urwała mi łeb.</div>
          </article>
        <% } %>
         <a href="/reviews" class="btn-ghost" style="display:block; width:100%; padding:14px; text-align:center; box-sizing:border-box; text-decoration:none;">Wczytaj więcej recenzji</a>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Co możesz zrobić na GameVerse</h2>
        <p>Odkryj gry, podziel się opinią i nawiąż kontakt z innymi pasjonatami</p>
      </div>
    </div>

    <div class="features-grid">
      
      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-joystick"></i>
          </div>
          <h3>Odkrywaj i oceniaj gry</h3>
        </div>
        <p>Przeszukuj katalog tysięcy gier, czytaj recenzje społeczności i dodawaj własne oceny. Od indie'ów po AAA-ty.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-pencil-square"></i>
          </div>
          <h3>Pisz recenzje i wpisy</h3>
        </div>
        <p>Dziel się swoimi wrażeniami ze spotkań z grami. Pisz szczegółowe recenzje, dodawaj zdjęcia i artykuły na bloga.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-bookmark"></i>
          </div>
          <h3>Prowadź swój backlog</h3>
        </div>
        <p>Zarządzaj listą gier do przegrania. Śledź swoje postępy i organizuj kolekcję po statusach.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-person-hearts"></i>
          </div>
          <h3>Obserwuj społeczność</h3>
        </div>
        <p>Śledź profili zainteresowanych Cię recenzentów, zobacz ich oceny i bądź na bieżąco z ich opinami.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-chat-dots"></i>
          </div>
          <h3>Rozmawiaj na czacie</h3>
        </div>
        <p>Dyskutuj z innymi graczami w czasie rzeczywistym. Dziel się wrażeniami i radami.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-trophy"></i>
          </div>
          <h3>Zdobywaj punkty i odznaki</h3>
        </div>
        <p>Aktywnie uczestnicząc w społeczności, zdobywaj punkty i otwieraj specjalne odznaki na profilu.</p>
      </div>

    </div>
  </div>
</section>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="cta-band">
      <div>
        <h3>Dołącz do społeczności graczy GameVerse</h3>
        <p>Zakładaj profil, obserwuj recenzentów, których cenisz, i rozmawiaj o grach na czacie — za darmo i bez reklam między recenzjami.</p>
      </div>
      <button
            type="button"
            class="btn-primary hero-cta"
            data-bs-toggle="modal"
            data-bs-target="#signInModal"
            >Załóż darmowe konto</button>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('signInModal');
    if (!modal) return;

    const views = modal.querySelectorAll('.gv-auth-view');

    function showView(name) {
      views.forEach(v => {
        v.classList.toggle('d-none', v.dataset.view !== name);
      });
    }

    modal.querySelectorAll('[data-switch]').forEach(btn => {
      btn.addEventListener('click', () => showView(btn.dataset.switch));
    });

    // reset do widoku logowania za każdym razem, gdy modal się otwiera
    modal.addEventListener('show.bs.modal', () => showView('signin'));
  });
  document.querySelectorAll('.action-btn').forEach(btn=>{
    const icon = btn.querySelector('.bi-heart, .bi-heart-fill');
    const countEl = btn.querySelector('.gv-count');
    if(icon && countEl){
      btn.addEventListener('click',()=>{
        const liked = btn.classList.toggle('liked');
        icon.classList.toggle('bi-heart', !liked);
        icon.classList.toggle('bi-heart-fill', liked);
        const count = parseInt(countEl.textContent, 10) || 0;
        countEl.textContent = liked ? count + 1 : count - 1;
      });
    }
  });
  document.querySelectorAll('.follow-pill, .mini-follow').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const following = btn.classList.toggle('following');
      if(btn.classList.contains('follow-pill')){
        btn.textContent = following ? 'Obserwujesz' : 'Obserwuj';
      }
    });
  });
</script>
</body>
</html>