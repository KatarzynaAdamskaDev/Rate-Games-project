<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/app-extra.css" />
</head>
<body>

  <%- include('partials/navbar') %>
  <%- include('partials/flash') %>

<section class="hero gv-hero">
  <div class="hero-bg"></div>
  <div class="wrap hero-inner gv-hero-card">
    <span class="eyebrow-pixel">GAMERS COMMUNITY</span>
    <h1 class="gv-hero-title">Pisz recenzje gier, <span>obserwuj graczy</span> i rozmawiaj o tym, w co właśnie grasz</h1>
    <p class="gv-hero-text">GameVerse to portal z recenzjami gier PC, PS5, Xbox i Nintendo Switch — dodawaj tytuły do ulubionych, komentuj opinie innych graczy i czatuj ze znajomymi w czasie rzeczywistym.</p>
    <div class="hero-ctas">
      <% if (currentUser) { %>
        <button
              type="button"
              class="btn-primary hero-cta"
              data-bs-toggle="modal"
              data-bs-target="#writeReviewModal"
            >Napisz recenzję</button>
      <% } else { %>
        <button
              type="button"
              class="btn-primary hero-cta"
              data-bs-toggle="modal"
              data-bs-target="#signInModal"
            >Napisz swoją pierwszą recenzję</button>
      <% } %>
    </div>
    <div class="hero-stats">
      <div><b><%= stats.totalReviews %></b><span>recenzji gier</span></div>
      <div><b><%= stats.totalUsers %></b><span>graczy</span></div>
      <div><b><%= stats.gamesWithReviews %></b><span>gier z recenzją</span></div>
    </div>
  </div>
</section>

<div class="seo-intro">
  <div class="wrap">
    <p><strong>GameVerse</strong> to miejsce, w którym gracze PC i konsolowi dzielą się opiniami o najnowszych premierach — od recenzji gier akcji i RPG, przez opinie o grach indie, po rankingi najlepszych gier na PS5, Xbox Series X i Nintendo Switch. Dodawaj recenzje gier do ulubionych, obserwuj innych recenzentów i dołączaj do rozmów na czacie o grach wideo, zamiast szukać opinii na rozproszonych forach dla graczy.</p>
  </div>
</div>

<section id="kategorie">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Recenzje gier według platformy</h2>
        <p>Wybierz platformę i przejdź do opinii graczy o najnowszych tytułach na PC i konsole.</p>
      </div>
    </div>
    <div class="platform-grid">
  <a class="platform-card" href="/games?platform=pc">
    <div class="pf-icon"><i class="bi bi-pc-display"></i></div>
    <b>Gry PC</b><span>recenzje i wymagania</span>
  </a>
  <a class="platform-card" href="/games?platform=ps5">
    <div class="pf-icon"><i class="bi bi-playstation"></i></div>
    <b>Gry na PS5</b><span>opinie graczy</span>
  </a>
  <a class="platform-card" href="/games?platform=xbox">
    <div class="pf-icon"><i class="bi bi-xbox"></i></div>
    <b>Gry na Xbox</b><span>Series X/S</span>
  </a>
  <a class="platform-card" href="/games?platform=switch">
    <div class="pf-icon"><i class="bi bi-controller"></i></div>
    <b>Nintendo Switch</b><span>gry przygodowe</span>
  </a>
  <a class="platform-card" href="/games?platform=mobile">
    <div class="pf-icon"><i class="bi bi-phone"></i></div>
    <b>Gry mobilne</b><span>Android i iOS</span>
  </a>
  <a class="platform-card" href="/games?platform=vr">
    <div class="pf-icon"><i class="bi bi-badge-vr"></i></div>
    <b>Gry VR</b><span>nowa kategoria</span>
  </a>
</div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2><%= trending.title %></h2>
        <p><%= trending.subtitle %></p>
      </div>
      <a class="see-all" href="<%= trending.linkHref %>"><%= trending.linkLabel %> →</a>
    </div>
    <div class="trend-scroll">
      <% if (trending.games.length > 0) { %>
        <% trending.games.forEach((game, idx) => { %>
          <article class="trend-card">
            <div class="trend-cover" style="background-image: url('<%= game.coverImage || '' %>');">
              <span class="rank-badge">#<%= idx + 1 %></span>
            </div>
            <div class="trend-body">
              <b><a href="/games/<%= game.id %>"><%= game.title %></a></b>
              <div class="meta"><%= game.category %> · <%= game.platform || 'PC, PS5' %></div>
              <div class="rating">
                <% if (game.averageRating) { %>
                  <%- include('partials/star-rating', { rating: game.averageRating }) %>
                  <%= game.averageRating.toFixed(1) %>
                  <% if (game.reviewCount) { %><span class="gv-game-card-count">(<%= game.reviewCount %>)</span><% } %>
                <% } else { %>
                  <span class="gv-game-card-count">Brak ocen</span>
                <% } %>
              </div>
            </div>
          </article>
        <% }); %>
      <% } else { %>
        <p class="gv-empty-state">Nie udało się pobrać listy gier. Spróbuj ponownie za chwilę.</p>
      <% } %>
    </div>
  </div>
</section>

<section id="recenzje">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Najlepsza recenzja tygodnia</h2>
        <p>Wybieramy ją spośród opinii z ostatnich 7 dni - wygrywa ta, którą gracze najczęściej lubią i komentują.</p>
      </div>
      <a class="see-all" href="/reviews">Wszystkie recenzje →</a>
    </div>

    <% if (weeklyReview) { %>
      <%- include('partials/review-featured', { review: weeklyReview }) %>
    <% } else { %>
      <p class="gv-empty-state">Nikt jeszcze nie napisał recenzji. <a href="/games" class="gv-inline-link">Wybierz grę</a> i bądź pierwszy!</p>
    <% } %>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Co możesz zrobić na GameVerse</h2>
        <p>Odkryj gry, podziel się opinią i nawiąż kontakt z innymi pasjonatami</p>
      </div>
    </div>

    <div class="features-grid">
      
      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-joystick"></i>
          </div>
          <h3>Odkrywaj i oceniaj gry</h3>
        </div>
        <p>Przeszukuj katalog tysięcy gier, czytaj recenzje społeczności i dodawaj własne oceny. Od indie'ów po AAA-ty.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-pencil-square"></i>
          </div>
          <h3>Pisz recenzje i wpisy</h3>
        </div>
        <p>Dziel się swoimi wrażeniami ze spotkań z grami. Pisz szczegółowe recenzje, dodawaj zdjęcia i artykuły na bloga.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-star"></i>
          </div>
          <h3>Pokaż ulubione gry</h3>
        </div>
        <p>Wybierz do sześciu gier, które lubisz najbardziej, i pokaż je na swoim profilu.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-person-hearts"></i>
          </div>
          <h3>Obserwuj społeczność</h3>
        </div>
        <p>Śledź profili zainteresowanych Cię recenzentów, zobacz ich oceny i bądź na bieżąco z ich opinami.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-chat-dots"></i>
          </div>
          <h3>Rozmawiaj na czacie</h3>
        </div>
        <p>Dyskutuj z innymi graczami w czasie rzeczywistym. Dziel się wrażeniami i radami.</p>
      </div>

      <div class="feature-card">
        <div class="feature-card-header">
          <div class="feature-icon">
            <i class="bi bi-trophy"></i>
          </div>
          <h3>Zdobywaj punkty i odznaki</h3>
        </div>
        <p>Aktywnie uczestnicząc w społeczności, zdobywaj punkty i otwieraj specjalne odznaki na profilu.</p>
      </div>

    </div>
  </div>
</section>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="cta-band">
      <div>
        <h3>Dołącz do społeczności graczy GameVerse</h3>
        <p>Zakładaj profil, obserwuj recenzentów, których cenisz, i rozmawiaj o grach na czacie — za darmo i bez reklam między recenzjami.</p>
      </div>
      <button
            type="button"
            class="btn-primary hero-cta"
            data-bs-toggle="modal"
            data-bs-target="#signInModal"
            >Załóż darmowe konto</button>
    </div>
  </div>
</section>

<% if (currentUser) { %>
  <!-- MODAL: NAPISZ RECENZJĘ (wybór gry, potem ocena i treść) -->
  <div class="modal fade" id="writeReviewModal" tabindex="-1" aria-labelledby="writeReviewLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content gv-modal-content">
        <div class="modal-header gv-modal-header">
          <h2 class="gv-auth-title mb-0" id="writeReviewLabel">Napisz recenzję</h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>
        <form id="writeReviewForm" method="POST" class="gv-review-form">
          <div class="modal-body">
            <div id="writeReviewStep1">
              <label class="gv-label d-block" for="writeReviewSearch">Wyszukaj grę, którą chcesz zrecenzować</label>
              <div class="gv-game-picker" data-game-picker data-mode="select">
                <input type="search" id="writeReviewSearch" class="form-control gv-input" placeholder="Wpisz tytuł gry..." autocomplete="off" maxlength="100">
                <input type="hidden" name="gameId">
                <div class="gv-picker-results"></div>
              </div>
            </div>
            <div id="writeReviewStep2" class="d-none">
              <div id="writeReviewSelectedGame" class="d-flex align-items-center gap-2 mb-3"></div>
              <button type="button" class="gv-inline-link mb-3" id="writeReviewChangeGame">← Wybierz inną grę</button>

              <label class="gv-label d-block">Twoja ocena</label>
              <div class="gv-star-picker" role="radiogroup" aria-label="Twoja ocena (kliknij lewą połowę gwiazdki, aby dać połówkę)">
                <i class="bi bi-star" data-value="1"></i>
                <i class="bi bi-star" data-value="2"></i>
                <i class="bi bi-star" data-value="3"></i>
                <i class="bi bi-star" data-value="4"></i>
                <i class="bi bi-star" data-value="5"></i>
              </div>
              <input type="hidden" name="rating" class="gv-star-picker-input">

              <label class="gv-label d-block mt-3" for="writeReviewText">Twoja opinia</label>
              <textarea name="text" id="writeReviewText" rows="4" class="form-control gv-input" required></textarea>

              <button type="submit" class="btn gv-btn-success mt-3">Opublikuj recenzję</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var modal = document.getElementById('writeReviewModal');
      if (!modal) return;
      var form = document.getElementById('writeReviewForm');
      var picker = modal.querySelector('[data-game-picker]');
      var step1 = document.getElementById('writeReviewStep1');
      var step2 = document.getElementById('writeReviewStep2');
      var selectedGameBox = document.getElementById('writeReviewSelectedGame');
      var changeGameBtn = document.getElementById('writeReviewChangeGame');

      function reset() {
        step1.classList.remove('d-none');
        step2.classList.add('d-none');
        selectedGameBox.innerHTML = '';
        form.reset();
        form.removeAttribute('action');
      }

      picker.addEventListener('gamepicker:select', function (e) {
        var game = e.detail;
        form.action = '/games/' + encodeURIComponent(game.id) + '/reviews';

        selectedGameBox.innerHTML = '';
        var img = document.createElement('img');
        img.src = game.coverImage || '/images/game-placeholder.svg';
        img.alt = '';
        img.style.cssText = 'width:48px;height:48px;border-radius:8px;object-fit:cover;flex-shrink:0;';
        var title = document.createElement('b');
        title.textContent = game.title;
        selectedGameBox.appendChild(img);
        selectedGameBox.appendChild(title);

        step1.classList.add('d-none');
        step2.classList.remove('d-none');
      });

      changeGameBtn.addEventListener('click', function () {
        step2.classList.add('d-none');
        step1.classList.remove('d-none');
        picker.querySelector('input[name="gameId"]').value = '';
        form.removeAttribute('action');
      });

      modal.addEventListener('hidden.bs.modal', reset);
    })();
  </script>
<% } %>

<%- include('partials/footer') %>
<script src="/js/game-picker.js"></script>
<script src="/js/review-actions.js"></script>

</body>
</html>