<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
  <meta name="description" content="Recenzje gier od społeczności GameVerse - najczęściej recenzowane gry, najwyżej oceniane tytuły, najnowsze opinie graczy i ranking najaktywniejszych recenzentów.">
</head>
<body>
  <%- include('partials/navbar') %>
  <%- include('partials/flash') %>

  <section class="gv-section">
    <div class="wrap">

      <div class="gv-blog-head">
        <div>
          <h1 class="gv-page-title">Recenzje graczy</h1>
          <p class="gv-page-lead">Co społeczność GameVerse sądzi o grach: najlepsza recenzja tygodnia, rankingi tytułów i wszystkie opinie w jednym miejscu.</p>
        </div>
        <% if (currentUser) { %>
          <button type="button" class="btn gv-btn-success" data-bs-toggle="modal" data-bs-target="#writeReviewModal">
            <i class="bi bi-plus-lg"></i> Napisz recenzję
          </button>
        <% } %>
      </div>

      <div class="gv-stats-bar">
        <div class="gv-stat-card"><b><%= stats.totalReviews %></b><span>recenzji</span></div>
        <div class="gv-stat-card"><b><%= stats.gamesWithReviews %></b><span>gier z recenzją</span></div>
        <div class="gv-stat-card"><b><%= stats.averageRating || '—' %></b><span>średnia ocena</span></div>
        <div class="gv-stat-card"><b><%= stats.totalReviewers %></b><span>recenzentów</span></div>
        <div class="gv-stat-card"><b><%= stats.reviewsThisWeek %></b><span>w tym tygodniu</span></div>
      </div>

      <% if (weeklyReview) { %>
        <%- include('partials/review-featured', { review: weeklyReview }) %>
      <% } %>

      <!-- NAJCZĘŚCIEJ RECENZOWANE -->
      <h2 class="gv-section-title"><i class="bi bi-fire"></i> Najczęściej recenzowane gry</h2>
      <p class="gv-section-subtitle">Tytuły, o których gracze piszą najwięcej opinii.</p>
      <% if (mostReviewedGames.length === 0) { %>
        <p class="gv-empty-state" style="margin-bottom:44px;">Żadna gra nie ma jeszcze recenzji - bądź pierwszy!</p>
      <% } else { %>
        <div class="gv-rank-scroll">
          <% mostReviewedGames.forEach(function(game, i) { %>
            <a href="/games/<%= game.id %>" class="gv-rank-card text-decoration-none">
              <div class="gv-rank-cover">
                <span class="gv-rank-number">#<%= i + 1 %></span>
                <img src="<%= game.coverImage %>" alt="<%= game.title %>">
              </div>
              <div class="gv-rank-body">
                <b><%= game.title %></b>
                <span><%= game.category %> · <%= game.releaseYear %></span>
                <span class="gv-rank-metric"><%= game.reviewCount %> <%= game.reviewCount === 1 ? 'recenzja' : 'recenzji' %></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>

      <!-- NAJWYŻEJ OCENIANE -->
      <h2 class="gv-section-title"><i class="bi bi-star-fill"></i> Najwyżej oceniane gry</h2>
      <p class="gv-section-subtitle">Najwyższa średnia ocena wystawiona przez społeczność.</p>
      <% if (topRatedGames.length === 0) { %>
        <p class="gv-empty-state" style="margin-bottom:44px;">Brak ocenionych gier.</p>
      <% } else { %>
        <div class="gv-rank-scroll">
          <% topRatedGames.forEach(function(game, i) { %>
            <a href="/games/<%= game.id %>" class="gv-rank-card text-decoration-none">
              <div class="gv-rank-cover">
                <span class="gv-rank-number">#<%= i + 1 %></span>
                <img src="<%= game.coverImage %>" alt="<%= game.title %>">
              </div>
              <div class="gv-rank-body">
                <b><%= game.title %></b>
                <span><%= game.category %> · <%= game.releaseYear %></span>
                <span class="gv-rank-metric gv-rank-rating"><span class="gv-review-rating-badge"><%- include('partials/star-rating-solid', { rating: game.averageRating }) %></span><span><%= game.averageRating %> / 5</span></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>

      <div class="row g-4">
        <div class="col-12 col-lg-8">
          <!-- WSZYSTKIE RECENZJE -->
          <div class="gv-sort-row">
            <div>
              <h2 class="gv-section-title" style="margin-bottom:0;">Wszystkie recenzje</h2>
              <p class="gv-section-subtitle" style="margin-bottom:0;"><%= feed.total %> <%= feed.total === 1 ? 'recenzja' : 'recenzji' %><%= activeRating ? ' z oceną ' + activeRating + '/5' : '' %>.</p>
            </div>
            <form method="GET" class="gv-review-filters">
              <select name="rating" class="gv-select" onchange="this.form.submit()" aria-label="Filtr oceny">
                <option value="">Każda ocena</option>
                <% [5, 4, 3, 2, 1].forEach(function(n) { %>
                  <option value="<%= n %>" <%= activeRating === n ? 'selected' : '' %>><%= n %> <%= n === 1 ? 'gwiazdka' : (n < 5 ? 'gwiazdki' : 'gwiazdek') %></option>
                <% }) %>
              </select>
              <select name="sort" class="gv-select" onchange="this.form.submit()" aria-label="Sortowanie">
                <option value="newest" <%= activeSort === 'newest' ? 'selected' : '' %>>Najnowsze</option>
                <option value="oldest" <%= activeSort === 'oldest' ? 'selected' : '' %>>Najstarsze</option>
                <option value="rating" <%= activeSort === 'rating' ? 'selected' : '' %>>Najwyżej oceniane</option>
                <option value="lowest" <%= activeSort === 'lowest' ? 'selected' : '' %>>Najniżej oceniane</option>
                <option value="likes" <%= activeSort === 'likes' ? 'selected' : '' %>>Najwięcej polubień</option>
                <option value="comments" <%= activeSort === 'comments' ? 'selected' : '' %>>Najwięcej komentarzy</option>
              </select>
            </form>
          </div>

          <% if (feed.items.length === 0) { %>
            <p class="gv-empty-state">
              <%= activeRating ? 'Brak recenzji z taką oceną.' : 'Nie ma jeszcze żadnych recenzji.' %>
              <a href="/games" class="gv-inline-link">Przeglądaj gry</a> i napisz pierwszą!
            </p>
          <% } else { %>
            <div class="gv-rcard-list">
              <% feed.items.forEach(function(review) { %>
                <%- include('partials/review-card', { review }) %>
              <% }) %>
            </div>
            <%- include('partials/pager', { pager }) %>
          <% } %>
        </div>

        <div class="col-12 col-lg-4">
          <!-- NAJAKTYWNIEJSI RECENZENCI -->
          <h2 class="gv-section-title"><i class="bi bi-trophy-fill"></i> Najaktywniejsi recenzenci</h2>
          <p class="gv-section-subtitle">Gracze, którzy piszą najwięcej opinii.</p>
          <% if (topReviewers.length === 0) { %>
            <p class="gv-empty-state">Brak recenzentów.</p>
          <% } else { %>
            <div class="gv-leaderboard">
              <% topReviewers.forEach(function(rev, i) { %>
                <a href="/<%= encodeURIComponent(rev.username) %>" class="gv-leader-row text-decoration-none">
                  <span class="gv-leader-rank">#<%= i + 1 %></span>
                  <% if (rev.avatarUrl) { %><img src="<%= rev.avatarUrl %>" alt="" class="gv-leader-avatar"><% } else { %><span class="gv-leader-avatar"></span><% } %>
                  <span class="gv-leader-name"><%= rev.username %></span>
                  <span class="gv-leader-count"><%= rev.reviewCount %> <%= rev.reviewCount === 1 ? 'recenzja' : 'recenzji' %></span>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </section>

  <% if (currentUser) { %>
    <%- include('partials/write-review-modal') %>
  <% } %>

  <% if (currentUser) { %><%- include('partials/report-modal') %><% } %>
  <%- include('partials/footer') %>
  <script src="/js/game-picker.js"></script>
  <script src="/js/review-actions.js"></script>
</body>
</html>
