<!DOCTYPE html>
<%
  const selectedPlatform = typeof locals.selectedPlatform !== 'undefined' ? locals.selectedPlatform : null;
  const selectedYear = typeof locals.selectedYear !== 'undefined' ? locals.selectedYear : null;
%>
<html lang="pl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>
  <%- include('partials/flash') %>

  <section class="gv-section">
    <div class="container">
      <h1 class="gv-page-title mb-4">Kategorie</h1>

      <div class="gv-category-pills mb-5">
        <a href="/category" class="gv-pill <%= !selectedCategory ? 'gv-pill-active' : '' %>">Wszystkie</a>
        <% categories.forEach(function(cat) { %>
          <a href="/category/<%= cat.name %>" class="gv-pill <%= selectedCategory === cat.name ? 'gv-pill-active' : '' %>">
            <%= cat.name %> <span class="gv-pill-count">(<%= cat.count %>)</span>
          </a>
        <% }) %>
      </div>

<h2 class="gv-section-title mb-3">
  <%= selectedCategory ? `Gry w kategorii: ${selectedCategory}` : 'Wszystkie gry' %>
</h2>

<form method="GET" action="<%= selectedCategory ? `/category/${selectedCategory}` : '/category' %>" class="gv-filters mb-4">
  <select name="platform" class="gv-filter-select" onchange="this.form.submit()">
    <option value="">Wszystkie platformy</option>
    <option value="PC" <%= selectedPlatform === 'PC' ? 'selected' : '' %>>PC</option>
    <option value="PS5" <%= selectedPlatform === 'PS5' ? 'selected' : '' %>>PS5</option>
    <option value="Xbox" <%= selectedPlatform === 'Xbox' ? 'selected' : '' %>>Xbox</option>
    <option value="Switch" <%= selectedPlatform === 'Switch' ? 'selected' : '' %>>Switch</option>
    <option value="Konsole" <%= selectedPlatform === 'Konsole' ? 'selected' : '' %>>Konsole</option>
    <option value="Android" <%= selectedPlatform === 'Android' ? 'selected' : '' %>>Android</option>
  </select>

  <select name="year" class="gv-filter-select" onchange="this.form.submit()">
  <option value="">Wszystkie lata</option>
  <% availableYears.forEach(function(y) { %>
    <option value="<%= y %>" <%= String(selectedYear) === String(y) ? 'selected' : '' %>><%= y %></option>
  <% }) %>
</select>

  <noscript><button type="submit" class="btn gv-btn-success">Filtruj</button></noscript>
</form>

<% if (games.length === 0) { %>
  <p class="gv-empty-state">Brak gier dla wybranych filtrów.</p>
<% } else { %>
  <div class="row g-4">
    <% games.forEach(function(game) { %>
      <div class="col-12 col-sm-6 col-lg-4">
        <%- include('partials/game-card', { game }) %>
      </div>
    <% }) %>
  </div>
<% } %>

    </div>

  <%- include('partials/footer') %>
</body>
</html>
